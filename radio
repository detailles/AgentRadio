#!/usr/bin/env python3
"""Radio — local message bus for agents running in Herdr panes.

A single-file, stdlib-only CLI. State lives in a SQLite ledger under the
plugin state dir (when running as a Herdr plugin command), $RADIO_HOME, or
~/.local/share/herdr-radio. Delivery to panes goes through the Herdr CLI.
"""

from __future__ import annotations

import argparse
import curses
import fcntl
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
from contextlib import closing
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_ROOM = "general"
HERDR_SEND_TIMEOUT = 15
MAX_DELIVERY_ATTEMPTS = 5


def state_dir() -> Path:
    # One well-known ledger per machine. HERDR_PLUGIN_STATE_DIR is deliberately
    # NOT used: the CLI runs from arbitrary panes and shells that never carry
    # plugin env, so the ledger must resolve to the same path everywhere.
    override = os.environ.get("RADIO_HOME")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".local" / "share" / "herdr-radio"


STATE_DIR = state_dir()
DB_PATH = STATE_DIR / "radio.db"
LOCK_PATH = STATE_DIR / "relay.lock"

SCHEMA = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS handles(
  name TEXT PRIMARY KEY,
  session_ref TEXT NOT NULL DEFAULT 'manual',
  kind TEXT NOT NULL DEFAULT 'terminal',
  agent_session TEXT,
  created_at TEXT NOT NULL,
  last_seen TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS memberships(
  handle TEXT NOT NULL,
  room TEXT NOT NULL,
  PRIMARY KEY(handle, room)
);
CREATE TABLE IF NOT EXISTS messages(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts TEXT NOT NULL,
  kind TEXT NOT NULL,            -- pm | room
  from_handle TEXT NOT NULL,
  to_handle TEXT,                -- pm target
  room TEXT,                     -- room target
  text TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS deliveries(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  message_id INTEGER NOT NULL REFERENCES messages(id),
  target TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'pending',  -- pending|delivered|pull|failed
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  created_at TEXT NOT NULL,
  delivered_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_deliveries_status ON deliveries(status);
CREATE INDEX IF NOT EXISTS idx_deliveries_target ON deliveries(target, status);
"""


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def connect() -> sqlite3.Connection:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    cols = {r["name"] for r in conn.execute("PRAGMA table_info(handles)").fetchall()}
    if "agent_session" not in cols:
        conn.execute("ALTER TABLE handles ADD COLUMN agent_session TEXT")
        conn.commit()
    return conn


def herdr_bin() -> str:
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"


def herdr(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [herdr_bin(), *args], text=True, capture_output=True, timeout=HERDR_SEND_TIMEOUT
    )


def herdr_json(*args: str) -> dict | None:
    try:
        result = herdr(*args)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def fetch_pane(pane_id: str) -> dict | None:
    data = herdr_json("pane", "get", pane_id)
    if not data:
        return None
    return data.get("result", {}).get("pane")


def current_session_ref() -> str:
    if os.environ.get("HERDR_ENV") == "1" and os.environ.get("HERDR_PANE_ID"):
        return f"herdr:{os.environ['HERDR_PANE_ID']}"
    return "manual"


def pane_id_of(session_ref: str) -> str | None:
    if session_ref.startswith("herdr:"):
        return session_ref.removeprefix("herdr:")
    return None


def pane_exists(pane_id: str) -> bool:
    try:
        return herdr("pane", "get", pane_id).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def push_to_pane(pane_id: str, text: str) -> tuple[bool, str | None]:
    """Deliver one line into a pane. Agent prompt first (atomic submission for
    agent panes), falling back to literal text + Enter for plain shells."""
    try:
        prompted = herdr("agent", "prompt", pane_id, text)
        if prompted.returncode == 0:
            return True, None
        typed = herdr("pane", "send-text", pane_id, text)
        if typed.returncode != 0:
            err = (prompted.stderr or typed.stderr or typed.stdout).strip()
            return False, err or "pane rejected delivery"
        entered = herdr("pane", "send-keys", pane_id, "enter")
        if entered.returncode != 0:
            return False, (entered.stderr or "enter key rejected").strip()
        return True, None
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)


def resolve_sender(conn: sqlite3.Connection, explicit: str | None) -> str:
    if explicit:
        return explicit
    env = os.environ.get("RADIO_HANDLE")
    if env:
        return env
    ref = current_session_ref()
    if ref != "manual":
        row = conn.execute(
            "SELECT name FROM handles WHERE session_ref = ?", (ref,)
        ).fetchone()
        if row:
            return row["name"]
    raise SystemExit("sender unknown: pass --from, set RADIO_HANDLE, or join from this pane")


def enqueue_delivery(conn: sqlite3.Connection, message_id: int, target: str) -> None:
    row = conn.execute(
        "SELECT session_ref FROM handles WHERE name = ?", (target,)
    ).fetchone()
    has_pane = bool(row and pane_id_of(row["session_ref"]))
    conn.execute(
        "INSERT INTO deliveries(message_id, target, status, created_at) VALUES (?,?,?,?)",
        (message_id, target, "pending" if has_pane else "pull", now()),
    )


def cmd_join(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    pane_id = args.pane
    if not pane_id and os.environ.get("HERDR_ENV") == "1":
        pane_id = os.environ.get("HERDR_PANE_ID")
    pane = fetch_pane(pane_id) if pane_id else None
    if pane_id and pane is None:
        raise SystemExit(f"pane not found: {pane_id}")

    handle = args.handle
    label = (pane or {}).get("label") or ""
    if not handle:
        if not label:
            raise SystemExit("pass a handle, or give the pane a label first")
        handle = label
    if pane and label != handle:
        # The pane label IS the handle: it is what survives session restore and
        # what the UI shows. Keep them identical instead of tracking two names.
        renamed = herdr("pane", "rename", pane_id, handle)
        if renamed.returncode != 0:
            raise SystemExit(f"pane rename failed: {(renamed.stderr or '').strip()}")

    agent_session = ((pane or {}).get("agent_session") or {}).get("value")
    ref = f"herdr:{pane_id}" if pane else "manual"
    ts = now()
    conn.execute(
        """INSERT INTO handles(name, session_ref, agent_session, created_at, last_seen)
           VALUES (?,?,?,?,?)
           ON CONFLICT(name) DO UPDATE SET session_ref=excluded.session_ref,
                                           agent_session=excluded.agent_session,
                                           last_seen=excluded.last_seen""",
        (handle, ref, agent_session, ts, ts),
    )
    rooms = args.room or [DEFAULT_ROOM]
    for room in rooms:
        conn.execute(
            "INSERT OR IGNORE INTO memberships(handle, room) VALUES (?,?)",
            (handle, room),
        )
    conn.commit()
    session_note = f", agent session {agent_session}" if agent_session else ""
    print(f"{handle} joined ({ref}{session_note}) in rooms: {', '.join(rooms)}")
    return 0


def cmd_part(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    conn.execute("DELETE FROM memberships WHERE handle = ?", (args.handle,))
    conn.execute("DELETE FROM handles WHERE name = ?", (args.handle,))
    conn.execute(
        "UPDATE deliveries SET status='failed', last_error='handle parted' "
        "WHERE target = ? AND status IN ('pending', 'pull')",
        (args.handle,),
    )
    conn.commit()
    print(f"{args.handle} parted")
    return 0


def record_message(
    conn: sqlite3.Connection,
    kind: str,
    sender: str,
    text: str,
    to_handle: str | None = None,
    room: str | None = None,
) -> int:
    cur = conn.execute(
        "INSERT INTO messages(ts, kind, from_handle, to_handle, room, text) VALUES (?,?,?,?,?,?)",
        (now(), kind, sender, to_handle, room, text),
    )
    return int(cur.lastrowid)


def cmd_pm(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    sender = resolve_sender(conn, args.sender)
    text = " ".join(args.text)
    target = conn.execute(
        "SELECT name FROM handles WHERE name = ?", (args.to,)
    ).fetchone()
    if not target:
        raise SystemExit(f"unknown handle: {args.to} (join first)")
    mid = record_message(conn, "pm", sender, text, to_handle=args.to)
    enqueue_delivery(conn, mid, args.to)
    conn.commit()
    print(f"pm #{mid} -> {args.to}")
    return 0


def cmd_say(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    sender = resolve_sender(conn, args.sender)
    text = " ".join(args.text)
    conn.execute(
        "INSERT OR IGNORE INTO memberships(handle, room) VALUES (?,?)", (sender, args.room)
    )
    mid = record_message(conn, "room", sender, text, room=args.room)
    members = conn.execute(
        "SELECT handle FROM memberships WHERE room = ? AND handle != ?", (args.room, sender)
    ).fetchall()
    for member in members:
        enqueue_delivery(conn, mid, member["handle"])
    conn.commit()
    print(f"say #{mid} -> #{args.room} ({len(members)} recipients)")
    return 0


def cmd_handles(conn: sqlite3.Connection, _args: argparse.Namespace) -> int:
    rows = conn.execute("SELECT * FROM handles ORDER BY name").fetchall()
    if not rows:
        print("no handles joined")
        return 0
    for row in rows:
        rooms = conn.execute(
            "SELECT room FROM memberships WHERE handle = ? ORDER BY room", (row["name"],)
        ).fetchall()
        room_list = ",".join(r["room"] for r in rooms) or "-"
        session = (row["agent_session"] or "-")[:8]
        print(f"{row['name']:<20} {row['session_ref']:<16} sess: {session:<8} rooms: {room_list}")
    return 0


def cmd_log(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = conn.execute(
        "SELECT * FROM messages ORDER BY id DESC LIMIT ?", (args.limit,)
    ).fetchall()
    for row in reversed(rows):
        target = f"-> {row['to_handle']}" if row["kind"] == "pm" else f"-> #{row['room']}"
        print(f"#{row['id']} {row['ts']} {row['from_handle']} {target}: {row['text']}")
    return 0


def cmd_inbox(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = conn.execute(
        """SELECT d.id AS delivery_id, d.status, m.*
           FROM deliveries d JOIN messages m ON m.id = d.message_id
           WHERE d.target = ? AND d.status IN ('pending', 'pull', 'failed')
           ORDER BY d.id""",
        (args.handle,),
    ).fetchall()
    if not rows:
        print("inbox empty")
        return 0
    for row in rows:
        via = f"#{row['room']}" if row["kind"] == "room" else "pm"
        print(f"[{row['delivery_id']}] {row['ts']} {via} from {row['from_handle']}: {row['text']}")
    conn.execute(
        """UPDATE deliveries SET status='delivered', delivered_at=?
           WHERE target = ? AND status IN ('pending', 'pull', 'failed')""",
        (now(), args.handle),
    )
    conn.commit()
    return 0


def format_for_pane(message: sqlite3.Row) -> str:
    if message["kind"] == "pm":
        return f"[radio] pm from {message['from_handle']}: {message['text']}"
    return f"[radio] #{message['room']} from {message['from_handle']}: {message['text']}"


def relay_tick(conn: sqlite3.Connection) -> list[str]:
    events: list[str] = []
    rows = conn.execute(
        """SELECT d.id AS delivery_id, d.target, d.attempts, m.*
           FROM deliveries d JOIN messages m ON m.id = d.message_id
           WHERE d.status = 'pending' ORDER BY d.id LIMIT 50"""
    ).fetchall()
    for row in rows:
        delivery_id = row["delivery_id"]
        handle = conn.execute(
            "SELECT session_ref FROM handles WHERE name = ?", (row["target"],)
        ).fetchone()
        pane_id = pane_id_of(handle["session_ref"]) if handle else None
        if not pane_id or not pane_exists(pane_id):
            conn.execute(
                "UPDATE deliveries SET status='pull', last_error='no live pane' WHERE id = ?",
                (delivery_id,),
            )
            events.append(f"#{delivery_id} -> {row['target']}: no live pane, left for pull")
            continue
        ok, error = push_to_pane(pane_id, format_for_pane(row))
        if ok:
            conn.execute(
                "UPDATE deliveries SET status='delivered', delivered_at=? WHERE id = ?",
                (now(), delivery_id),
            )
            events.append(f"#{delivery_id} -> {row['target']} ({pane_id}) delivered")
        else:
            attempts = int(row["attempts"]) + 1
            status = "failed" if attempts >= MAX_DELIVERY_ATTEMPTS else "pending"
            conn.execute(
                "UPDATE deliveries SET status=?, attempts=?, last_error=? WHERE id = ?",
                (status, attempts, error, delivery_id),
            )
            events.append(f"#{delivery_id} -> {row['target']} attempt {attempts}: {error}")
    conn.commit()
    return events


def relay_alive() -> bool:
    """True when a relay process holds the singleton lock."""
    if not LOCK_PATH.exists():
        return False
    fd = open(LOCK_PATH, "w")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        fd.close()
    return False


# ---------------------------------------------------------------- view (TUI)

C_DOT_OK = 1      # agent alive, idle
C_DOT_BUSY = 2    # agent working
C_DOT_DIM = 3     # manual / unknown
C_DOT_GONE = 4    # pane missing
C_PM = 5          # pm lines
C_ROOM = 6        # room lines
C_DIM = 7
C_HEADER = 8


def pane_states() -> dict[str, str]:
    """pane_id -> agent_status for every live pane (empty when Herdr is away)."""
    data = herdr_json("pane", "list")
    if not data:
        return {}
    return {
        p["pane_id"]: p.get("agent_status") or "unknown"
        for p in data.get("result", {}).get("panes", [])
        if p.get("pane_id")
    }


def handle_dot(session_ref: str, states: dict[str, str]) -> tuple[str, int]:
    pane_id = pane_id_of(session_ref)
    if not pane_id:
        return "·", C_DOT_DIM
    status = states.get(pane_id)
    if status is None:
        return "✗", C_DOT_GONE
    if status in ("working", "running"):
        return "●", C_DOT_BUSY
    if status == "idle":
        return "●", C_DOT_OK
    return "●", C_DOT_DIM


def short_ts(ts: str) -> str:
    try:
        return datetime.fromisoformat(ts).astimezone().strftime("%H:%M")
    except ValueError:
        return ts[11:16] if len(ts) >= 16 else ts


def view_draw(win: "curses.window", args: argparse.Namespace) -> None:
    curses.curs_set(0)
    win.nodelay(True)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(C_DOT_OK, curses.COLOR_GREEN, -1)
        curses.init_pair(C_DOT_BUSY, curses.COLOR_YELLOW, -1)
        curses.init_pair(C_DOT_DIM, curses.COLOR_WHITE, -1)
        curses.init_pair(C_DOT_GONE, curses.COLOR_RED, -1)
        curses.init_pair(C_PM, curses.COLOR_CYAN, -1)
        curses.init_pair(C_ROOM, curses.COLOR_BLUE, -1)
        curses.init_pair(C_DIM, curses.COLOR_BLACK, -1)
        curses.init_pair(C_HEADER, curses.COLOR_MAGENTA, -1)

    last_db_poll = 0.0
    last_pane_poll = 0.0
    handles: list[sqlite3.Row] = []
    rooms_by_handle: dict[str, list[str]] = {}
    messages: list[sqlite3.Row] = []
    counts = {"pending": 0, "failed": 0, "delivered": 0}
    states: dict[str, str] = {}

    while True:
        now_ts = time.monotonic()
        if now_ts - last_db_poll >= 1.0:
            last_db_poll = now_ts
            with closing(connect()) as conn:
                handles = conn.execute("SELECT * FROM handles ORDER BY name").fetchall()
                rooms_by_handle = {
                    h["name"]: [
                        r["room"]
                        for r in conn.execute(
                            "SELECT room FROM memberships WHERE handle = ? ORDER BY room",
                            (h["name"],),
                        ).fetchall()
                    ]
                    for h in handles
                }
                messages = conn.execute(
                    "SELECT * FROM messages ORDER BY id DESC LIMIT 200"
                ).fetchall()
                for key in counts:
                    counts[key] = conn.execute(
                        "SELECT count(*) AS c FROM deliveries WHERE status = ?", (key,)
                    ).fetchone()["c"]
        if now_ts - last_pane_poll >= 3.0:
            last_pane_poll = now_ts
            states = pane_states()

        height, width = win.getmaxyx()
        win.erase()

        relay_up = relay_alive()
        header = " Radio "
        stats = (
            f"relay {'up' if relay_up else 'DOWN'} · "
            f"{counts['pending']} pending · {counts['failed']} failed · "
            f"{counts['delivered']} delivered"
        )
        win.addnstr(0, 0, header, width - 1, curses.color_pair(C_HEADER) | curses.A_BOLD)
        win.addnstr(0, len(header) + 1, stats, width - len(header) - 2,
                    curses.color_pair(C_DOT_GONE) | curses.A_BOLD if not relay_up else curses.A_NORMAL)
        win.addnstr(1, 0, "─" * (width - 1), width - 1, curses.color_pair(C_DIM))

        roster_w = min(34, max(24, width // 3))
        body_h = height - 4

        win.addnstr(2, 0, "Handles", roster_w - 1, curses.A_BOLD)
        for i, h in enumerate(handles[: body_h - 1]):
            y = 3 + i
            dot, color = handle_dot(h["session_ref"], states)
            win.addnstr(y, 0, dot + " ", roster_w - 1, curses.color_pair(color))
            name = h["name"]
            win.addnstr(y, 2, name, roster_w - 3, curses.A_BOLD)
            pane_id = pane_id_of(h["session_ref"]) or "pull"
            status = states.get(pane_id, "")
            meta = f"{pane_id} {status}".strip()
            win.addnstr(y, 2 + len(name) + 1, meta, roster_w - len(name) - 4,
                        curses.color_pair(C_DIM))
            rooms = ",".join(rooms_by_handle.get(h["name"], []))
            if rooms and len(name) + len(meta) + len(rooms) + 6 < roster_w:
                pass  # keep the roster quiet; rooms live in `radio rooms`

        sx = roster_w + 1
        stream_w = width - sx - 1
        win.addnstr(2, sx, "Stream", stream_w, curses.A_BOLD)
        for y in range(3, 3 + body_h):
            try:
                win.addch(y, roster_w, "│", curses.color_pair(C_DIM))
            except curses.error:
                pass
        visible = messages[: body_h - 1]
        for i, m in enumerate(reversed(visible)):
            y = 3 + i
            target = f"→ {m['to_handle']}" if m["kind"] == "pm" else f"→ #{m['room']}"
            color = curses.color_pair(C_PM if m["kind"] == "pm" else C_ROOM)
            prefix = f"{short_ts(m['ts'])} {m['from_handle']} {target}: "
            win.addnstr(y, sx, prefix, stream_w, color)
            win.addnstr(y, sx + len(prefix), m["text"], stream_w - len(prefix))

        footer = "q quit · r refresh"
        win.addnstr(height - 1, 0, footer, width - 1, curses.color_pair(C_DIM))
        win.refresh()

        try:
            key = win.getch()
        except curses.error:
            key = -1
        if key in (ord("q"), 27):
            return
        if key == ord("r"):
            last_db_poll = 0.0
            last_pane_poll = 0.0
        if key == curses.KEY_RESIZE:
            continue
        time.sleep(0.2)


def cmd_view(args: argparse.Namespace) -> int:
    # Adopt the pane we were launched in: the label tells the user (and Herdr
    # restore) what this pane is. No "open a panel" command needed.
    pane_id = os.environ.get("HERDR_PANE_ID")
    if pane_id and os.environ.get("HERDR_ENV") == "1":
        pane = fetch_pane(pane_id)
        if pane is not None and (pane.get("label") or "") != "Radio":
            herdr("pane", "rename", pane_id, "Radio")
    curses.wrapper(view_draw, args)
    return 0


def cmd_relay(args: argparse.Namespace) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock_fd = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("radio relay already running (lock held)", file=sys.stderr)
        return 1
    print(f"radio relay · db: {DB_PATH} · interval {args.interval}s")
    while True:
        with closing(connect()) as conn:
            for event in relay_tick(conn):
                print(f"[{now()}] {event}", flush=True)
        time.sleep(args.interval)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="radio", description=__doc__)
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("join", help="register this pane/session as a handle")
    p.add_argument("handle", nargs="?", help="defaults to the current pane label")
    p.add_argument("--pane", help="join a pane from outside (e.g. w1:p5)")
    p.add_argument("--room", action="append", help="room to join (repeatable)")

    p = sub.add_parser("part", help="remove a handle")
    p.add_argument("handle")

    p = sub.add_parser("pm", help="direct message a handle")
    p.add_argument("to")
    p.add_argument("text", nargs="+")
    p.add_argument("--from", dest="sender")

    p = sub.add_parser("say", help="message a room")
    p.add_argument("room")
    p.add_argument("text", nargs="+")
    p.add_argument("--from", dest="sender")

    sub.add_parser("handles", help="list joined handles")
    sub.add_parser("rooms", help="list rooms and members")

    p = sub.add_parser("log", help="recent messages")
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("inbox", help="read and consume pending messages for a handle")
    p.add_argument("handle")

    p = sub.add_parser("relay", help="run the delivery relay daemon")
    p.add_argument("--interval", type=float, default=0.5)

    sub.add_parser("view", help="live roster + message stream TUI")
    return parser


def cmd_rooms(conn: sqlite3.Connection, _args: argparse.Namespace) -> int:
    rows = conn.execute(
        "SELECT room, group_concat(handle, ', ') AS members FROM memberships "
        "GROUP BY room ORDER BY room"
    ).fetchall()
    if not rows:
        print("no rooms")
        return 0
    for row in rows:
        print(f"#{row['room']}: {row['members']}")
    return 0


def main() -> int:
    args = build_parser().parse_args()
    if args.command is None:
        # Bare `radio` in a terminal opens the view; in scripts, print help.
        if sys.stdout.isatty():
            return cmd_view(args)
        build_parser().print_help()
        return 0
    if args.command == "relay":
        return cmd_relay(args)
    if args.command == "view":
        return cmd_view(args)
    with closing(connect()) as conn:
        handler = {
            "join": cmd_join,
            "part": cmd_part,
            "pm": cmd_pm,
            "say": cmd_say,
            "handles": cmd_handles,
            "rooms": cmd_rooms,
            "log": cmd_log,
            "inbox": cmd_inbox,
        }[args.command]
        return handler(conn, args)


if __name__ == "__main__":
    raise SystemExit(main())
