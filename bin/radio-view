#!/usr/bin/env python3
"""Radio view — live roster + message stream TUI (Textual).

Run `sh bin/setup.sh` once to install the view dependencies into .venv.
State dir resolution mirrors bin/radio: $RADIO_HOME, else
~/.local/share/herdr-radio.
"""

import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime
from pathlib import Path

STATE_DIR = (
    Path(os.environ["RADIO_HOME"]).expanduser()
    if os.environ.get("RADIO_HOME")
    else Path.home() / ".local" / "share" / "herdr-radio"
)
DB_PATH = STATE_DIR / "radio.db"
LOCK_PATH = STATE_DIR / "relay.lock"
MAX_BODY_CHARS = 600
NARROW_COLS = 80
STREAM_HISTORY = 50  # messages backfilled when the stream loads or rescopes
PATH_RE = re.compile(r"(?:[\w.@~-]+/)+[\w.@-]+")

try:
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.containers import Horizontal
    from textual.widgets import Footer, RichLog, Static
except ImportError:
    sys.exit(
        "radio view needs its dependencies — run: "
        + ("bin\\setup.cmd" if os.name == "nt" else "sh bin/setup.sh")
    )


def herdr(*args: str) -> subprocess.CompletedProcess[str] | None:
    """Run one herdr CLI invocation; None when herdr is missing or times out
    (the view must keep rendering without it)."""
    binary = os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")
    if not binary:
        return None
    try:
        return subprocess.run([binary, *args], text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def workspace_labels() -> dict[str, str]:
    """Workspace id → label map from herdr; {} when `workspace list` fails or
    parses bad — callers then fall back to bare ids (or the default scan)."""
    result = herdr("workspace", "list")
    if not result or result.returncode != 0:
        return {}
    try:
        workspaces = json.loads(result.stdout).get("result", {}).get("workspaces", [])
    except json.JSONDecodeError:
        return {}
    return {
        str(w["workspace_id"]): str(w.get("label") or "")
        for w in workspaces
        if w.get("workspace_id")
    }


def workspace_ids() -> list[str] | None:
    """All workspace ids, or None when `workspace list` fails or parses bad —
    callers then fall back to default-workspace-only behavior."""
    return list(workspace_labels()) or None


def workspace_scope() -> str:
    """An explicitly selected frequency, else the pane's default workspace.
    Outside Herdr an unscoped view is the operator's all-workspaces overview."""
    frequency = os.environ.get("RADIO_VIEW_FREQUENCY")
    if frequency:
        return f"freq.{frequency}"
    if os.environ.get("HERDR_ENV") == "1":
        return os.environ.get("HERDR_WORKSPACE_ID", "")
    return ""


def is_named_frequency(scope: str) -> bool:
    """Distinguish named frequencies from physical workspace ids."""
    return scope.startswith("freq.")


def all_scopes(scope: str, show_all: bool) -> bool:
    """A named-frequency view stays pinned, even if show_all is set."""
    return not is_named_frequency(scope) and (show_all or not scope)


def scope_label(scope: str, labels: dict[str, str]) -> str:
    """Render the logical scope explicitly, including numeric frequency names."""
    if is_named_frequency(scope):
        return f"named frequency {scope.removeprefix('freq.')}"
    return labels.get(scope) or scope or "no workspace"


def frequency_number(scope: str) -> str:
    """Display a Herdr workspace number without changing its routing id."""
    match = re.fullmatch(r"w([0-9]+)", scope)
    return (match[1].lstrip("0") or "0").zfill(3) if match else scope


def header_scope_label(scope: str, show_all: bool, labels: dict[str, str]) -> str:
    """Describe the dashboard's current workspace, frequency, or overview."""
    if all_scopes(scope, show_all):
        return "all frequencies"
    if is_named_frequency(scope):
        return scope_label(scope, labels)
    caption = f"Frequency {frequency_number(scope)} · workspace {scope}"
    label = labels.get(scope)
    return f"{caption} · {label}" if label and label != scope else caption


def handle_label(handle: sqlite3.Row) -> str:
    """Match the label installed by join; a logical frequency is not a pane id."""
    scope = handle["workspace"] if "workspace" in handle.keys() else ""
    if is_named_frequency(scope):
        return f"{handle['name']}@{scope.removeprefix('freq.')}"
    return handle["name"]


def handles_query(scope: str, show_all: bool) -> tuple[str, tuple]:
    """(sql, params) for the roster: one workspace unless show_all or the view
    runs outside Herdr (no scope to honor)."""
    if all_scopes(scope, show_all):
        return "SELECT * FROM handles ORDER BY workspace, name", ()
    return "SELECT * FROM handles WHERE workspace = ? ORDER BY name", (scope,)


def messages_query(scope: str, show_all: bool, after_id: int) -> tuple[str, tuple]:
    """(sql, params) for messages newer than after_id: only this workspace's
    traffic unless show_all/outside. The watermark is the global id, so
    another workspace's mail never advances what this scope has seen."""
    if all_scopes(scope, show_all):
        return "SELECT * FROM messages WHERE id > ? ORDER BY id", (after_id,)
    return (
        "SELECT * FROM messages WHERE id > ? AND (from_ws = ? OR to_ws = ?) ORDER BY id",
        (after_id, scope, scope),
    )


def history_query(scope: str, show_all: bool, limit: int) -> tuple[str, tuple]:
    """The recent stream uses exactly the same scope as live messages."""
    if all_scopes(scope, show_all):
        return "SELECT * FROM messages ORDER BY id DESC LIMIT ?", (limit,)
    return (
        "SELECT * FROM messages WHERE from_ws = ? OR to_ws = ? "
        "ORDER BY id DESC LIMIT ?",
        (scope, scope, limit),
    )


def counts_query(scope: str, show_all: bool) -> tuple[str, tuple]:
    """Delivery totals belong to the displayed bus, not the whole ledger."""
    if all_scopes(scope, show_all):
        return "SELECT status, count(*) AS c FROM deliveries GROUP BY status", ()
    return (
        "SELECT status, count(*) AS c FROM deliveries "
        "WHERE target_ws = ? GROUP BY status",
        (scope,),
    )


def _pane_list(*extra: str) -> dict[str, dict]:
    """One `pane list` call, parsed to the pane-id-keyed map; empty on any failure."""
    result = herdr("pane", "list", *extra)
    if not result or result.returncode != 0:
        return {}
    try:
        panes = json.loads(result.stdout).get("result", {}).get("panes", [])
    except json.JSONDecodeError:
        return {}
    return {p["pane_id"]: p for p in panes if p.get("pane_id")}


def pane_states(labels: dict[str, str] | None = None) -> dict[str, dict]:
    """Live panes keyed by pane id, merged across every workspace — pane ids
    carry their workspace prefix (w2:p1), so the merge cannot collide and a
    handle living outside the default workspace still gets a real liveness
    dot. Falls back to the plain default-workspace listing when
    `workspace list` is unavailable, and skips a workspace that vanishes
    mid-scan. bin/radio needs no such scan: herdr resolves workspace-prefixed
    pane ids in `pane get`/`send-text`/`send-keys` directly (verified).
    `labels` lets a caller reuse a workspace list it already fetched."""
    ids = list(labels) if labels else workspace_ids()
    if ids is None:
        return _pane_list()
    states: dict[str, dict] = {}
    for wid in ids:
        if is_named_frequency(wid):
            continue
        states.update(_pane_list("--workspace", wid))
    return states


def relay_alive() -> bool:
    """True when the relay daemon holds the single-instance lock: POSIX flock,
    or the Windows msvcrt region — keep in sync with bin/radio relay_lock."""
    if not LOCK_PATH.exists():
        return False
    fd = open(LOCK_PATH, "a+")
    try:
        if os.name == "nt":
            import msvcrt

            fd.seek(0)
            if fd.read(1) == "":
                fd.write("1")
                fd.flush()
            fd.seek(0)
            msvcrt.locking(fd.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl

            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        fd.close()
    return False


def adopt_pane() -> None:
    """Label the pane we were launched in; survives Herdr session restore."""
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not (pane_id and os.environ.get("HERDR_ENV") == "1"):
        return
    result = herdr("pane", "get", pane_id)
    if not result or result.returncode != 0:
        return
    try:
        label = json.loads(result.stdout)["result"]["pane"].get("label") or ""
    except (json.JSONDecodeError, KeyError):
        return
    scope = workspace_scope()
    wanted = (
        f"Radio@{scope.removeprefix('freq.')}" if is_named_frequency(scope)
        else f"Radio {frequency_number(scope)}" if scope else "Radio"
    )
    if label != wanted:
        herdr("pane", "rename", pane_id, wanted)


def connect() -> sqlite3.Connection:
    """Open the ledger read-side (schema is owned by bin/radio); Row-factory connection."""
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    return conn


def dot_for(handle: sqlite3.Row, states: dict[str, dict]) -> tuple[Text, str]:
    """Liveness dot + note for a ledger row. A pane id alone proves nothing —
    panes outlive handles and get reused — so the pane must still carry the
    handle's label (and the same agent, if the handle has one)."""
    ref = handle["session_ref"]
    pane_id = ref.removeprefix("herdr:") if ref.startswith("herdr:") else None
    if not pane_id:
        return Text("·", style="grey62"), "pull"
    pane = states.get(pane_id)
    if pane is None:
        return Text("✗", style="red"), "no pane"
    if (pane.get("label") or "") != handle_label(handle):
        return Text("✗", style="grey50"), "reused"
    live_agent = pane.get("agent")
    if handle["agent"] and live_agent and live_agent != handle["agent"]:
        return Text("✗", style="grey50"), f"now {live_agent}"
    status = pane.get("agent_status") or "unknown"
    if status in ("working", "running"):
        return Text("●", style="yellow"), status
    if status == "idle":
        return Text("●", style="green"), status
    return Text("●", style="grey62"), status


def sidebar_visible(term_width: int, forced: bool | None) -> bool:
    """Sidebar policy: a manual toggle (the `h` key) wins; otherwise the
    roster sidebar is shown only when the terminal is at least NARROW_COLS
    wide — below that the fixed-width sidebar starves the message stream."""
    if forced is not None:
        return forced
    return term_width >= NARROW_COLS


def compact_roster(handles: list, states: dict[str, dict]) -> Text:
    """One-line '●kimi ●codex +2' roster rendered in the header bar while the
    sidebar is hidden: live handles inline, the rest as a trailing count."""
    line = Text()
    dead = 0
    for h in handles:
        dot, _ = dot_for(h, states)
        if dot.plain == "●":
            if line.plain:
                line.append(" ")
            line.append_text(dot)
            line.append(handle_label(h), style="bold")
        else:
            dead += 1
    if dead:
        line.append(f" +{dead}", style="grey50")
    return line


def fmt_message(m: sqlite3.Row, *, show_scope: bool = False,
                labels: dict[str, str] | None = None) -> Text:
    """One styled stream line for a message row; bodies are truncated to
    MAX_BODY_CHARS and path-like spans highlighted so refs stand out."""
    try:
        stamp = datetime.fromisoformat(m["ts"]).astimezone().strftime("%H:%M")
    except ValueError:
        stamp = m["ts"][11:16]
    target, target_style = m["to_handle"], "cyan"
    line = Text()
    line.append(f"{stamp} ", style="grey50")
    if show_scope:
        labels = labels or {}
        source, dest = m["from_ws"], m["to_ws"]
        caption = scope_label(source, labels)
        if source != dest:
            caption += f" → {scope_label(dest, labels)}"
        line.append(f"[{caption}] ", style="grey50")
    line.append(str(m["from_handle"]), style="bold magenta")
    line.append(" → ", style="grey50")
    line.append(str(target), style=f"bold {target_style}")
    if "reply_required" in m.keys() and m["reply_required"]:
        line.append(" ⚠reply", style="bold red")
    line.append("  ", style="grey50")
    body = str(m["text"])
    if len(body) > MAX_BODY_CHARS:
        cut = body[:MAX_BODY_CHARS]
        extra = len(body) - MAX_BODY_CHARS
    else:
        cut, extra = body, 0
    pos = 0
    for match in PATH_RE.finditer(cut):
        if match.start() > pos:
            line.append(cut[pos : match.start()])
        line.append(match.group(0), style="yellow")
        pos = match.end()
    line.append(cut[pos:])
    if extra:
        line.append(f" …(+{extra})", style="grey50")
    return line


class RadioView(App):
    """Live roster + message stream. Read-only on the ledger; polls it on
    timers instead of holding a connection, and never writes back."""

    TITLE = "Radio"
    CSS = """
    Screen { background: #0b0f14; }
    #bar {
        height: 1;
        padding: 0 1;
        background: #111820;
    }
    #bar-left { color: #7dd3fc; text-style: bold; width: auto; }
    #bar-right { color: #c9d1d9; width: 1fr; text-align: right; }
    #main { height: 1fr; }
    #stream {
        width: 1fr;
        border: round #263241;
        background: #0b0f14;
        padding: 0 1;
    }
    #handles {
        width: 30;
        border: round #263241;
        background: #0b0f14;
        padding: 0 1;
    }
    """
    BINDINGS = [
        ("q", "quit", "quit"),
        ("r", "refresh", "refresh"),
        ("h", "toggle_handles", "handles"),
        ("a", "toggle_all", "all frequencies"),
    ]

    def __init__(self) -> None:
        """Set up tail state: last_message_id tracks the stream watermark.
        The default view can widen to every workspace. An explicitly selected
        named frequency stays pinned (including when opened outside Herdr)."""
        super().__init__()
        self.last_message_id = 0
        self.scope = workspace_scope()
        self.show_all = not self.scope
        self.labels: dict[str, str] = {}
        self.states: dict[str, str] = {}
        self.sidebar_forced: bool | None = None
        self._sidebar_visible = True
        self.compact = Text()

    def compose(self) -> ComposeResult:
        """Build the layout: header bar, message stream, handles sidebar, footer."""
        with Horizontal(id="bar"):
            yield Static("◈ Radio", id="bar-left")
            yield Static("", id="bar-right")
        with Horizontal(id="main"):
            yield RichLog(id="stream", wrap=True, auto_scroll=True, markup=False)
            yield Static(id="handles")
        yield Footer()

    def on_mount(self) -> None:
        """Label our pane, backfill recent history for this scope, then start
        the poll timers."""
        adopt_pane()
        self.reload_stream()
        self.refresh_handles()
        self.apply_sidebar_policy()
        self.set_interval(1.0, self.poll_messages)
        self.set_interval(2.0, self.refresh_header)
        self.set_interval(4.0, self.refresh_handles)

    def reload_stream(self) -> None:
        """Clear the stream and load this scope's recent history; used on
        mount and whenever the all-workspaces toggle changes the scope."""
        sql, params = history_query(self.scope, self.show_all, STREAM_HISTORY)
        with connect() as conn:
            rows = conn.execute(sql, params).fetchall()
        stream = self.query_one("#stream", RichLog)
        stream.clear()
        for row in reversed(rows):
            stream.write(self.render_message(row))
        self.last_message_id = max((r["id"] for r in rows), default=0)

    def render_message(self, row: sqlite3.Row) -> Text:
        return fmt_message(
            row, show_scope=all_scopes(self.scope, self.show_all), labels=self.labels,
        )

    def on_resize(self, event) -> None:
        """Re-apply the sidebar policy when the terminal is resized."""
        self.apply_sidebar_policy()

    def apply_sidebar_policy(self) -> None:
        """Show/hide the roster sidebar per width + manual toggle. The header
        bar carries the compact roster while the sidebar is hidden."""
        self._sidebar_visible = sidebar_visible(self.size.width, self.sidebar_forced)
        self.query_one("#handles", Static).display = self._sidebar_visible
        self.refresh_header()

    def action_toggle_handles(self) -> None:
        """The `h` key: force the sidebar on/off, overriding the width policy."""
        self.sidebar_forced = not self._sidebar_visible
        self.apply_sidebar_policy()

    def poll_messages(self) -> None:
        """Append messages newer than the watermark to the stream, honoring
        the current scope."""
        with connect() as conn:
            sql, params = messages_query(self.scope, self.show_all, self.last_message_id)
            rows = conn.execute(sql, params).fetchall()
        if not rows:
            return
        stream = self.query_one("#stream", RichLog)
        for row in rows:
            stream.write(self.render_message(row))
        self.last_message_id = rows[-1]["id"]

    def action_toggle_all(self) -> None:
        """The `a` key: switch between this workspace and every workspace."""
        if is_named_frequency(self.scope):
            return
        self.show_all = not self.show_all
        self.reload_stream()
        self.refresh_handles()

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool | None:
        """Hide the overview shortcut when this dashboard is pinned."""
        if action == "toggle_all" and is_named_frequency(self.scope):
            return False
        return super().check_action(action, parameters)

    def refresh_header(self) -> None:
        """Redraw the header bar: current scope, relay liveness, and
        per-status delivery counts."""
        scope_name = header_scope_label(self.scope, self.show_all, self.labels)
        self.query_one("#bar-left", Static).update(f"◈ Radio · {scope_name}")
        with connect() as conn:
            sql, params = counts_query(self.scope, self.show_all)
            counts = {
                row["status"]: row["c"]
                for row in conn.execute(sql, params).fetchall()
            }
        up = relay_alive()
        relay = Text("relay up", style="green") if up else Text("relay DOWN", style="bold red")
        stats = Text.assemble(
            relay,
            f"  ·  {counts.get('pending', 0)} pending · {counts.get('failed', 0)} failed"
            f" · {counts.get('delivered', 0)} delivered",
        )
        if not self._sidebar_visible and self.compact.plain:
            stats.append("  ·  ", style="grey50")
            stats.append_text(self.compact)
        self.query_one("#bar-right", Static).update(stats)

    def refresh_handles(self) -> None:
        """Redraw the roster (sidebar when visible, compact line for the header
        bar when hidden) with liveness dots from live pane state. In the
        all-workspaces view the roster groups rows under their workspace."""
        self.labels = workspace_labels()
        self.states = pane_states(self.labels)
        with connect() as conn:
            sql, params = handles_query(self.scope, self.show_all)
            handles = conn.execute(sql, params).fetchall()
        self.compact = compact_roster(handles, self.states)
        if self._sidebar_visible:
            lines = Text("Handles\n", style="bold #7dd3fc")
            last_ws = None
            for h in handles:
                if all_scopes(self.scope, self.show_all) and h["workspace"] != last_ws:
                    last_ws = h["workspace"]
                    lines.append(
                        f"{scope_label(last_ws, self.labels)}\n",
                        style="bold #7dd3fc",
                    )
                pane_id = (
                    h["session_ref"].removeprefix("herdr:")
                    if h["session_ref"].startswith("herdr:")
                    else "pull"
                )
                dot, note = dot_for(h, self.states)
                lines.append_text(dot)
                lines.append(f" {h['name']}\n", style="bold")
                lines.append(f"  {pane_id} {note}\n", style="grey50")
            self.query_one("#handles", Static).update(lines)
        self.refresh_header()

    def action_refresh(self) -> None:
        """Manual refresh (the `r` key): re-run every poll immediately."""
        self.poll_messages()
        self.refresh_header()
        self.refresh_handles()


def main() -> int:
    """Run the RadioView app until the user quits."""
    RadioView().run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
