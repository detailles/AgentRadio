#!/usr/bin/env python3
"""Radio — local message bus for agents running in Herdr panes.

A single-file, stdlib-only CLI. State lives in a SQLite ledger under the
plugin state dir (when running as a Herdr plugin command), $RADIO_HOME, or
~/.local/share/herdr-radio. Delivery to panes goes through the Herdr CLI.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import uuid
from contextlib import closing
from datetime import datetime, timedelta, timezone
from pathlib import Path

try:  # POSIX only: the relay's flock and the raw-key menu.
    import fcntl
    import termios
    import tty
except ImportError:  # Windows: see relay_lock and choose_plain for the fallbacks.
    fcntl = termios = tty = None
try:  # Windows only: byte-range file lock, the relay's single-instance primitive.
    import msvcrt
except ImportError:
    msvcrt = None

# Split timeouts: one wedged herdr must not stall the relay daemon — a
# read-only pane lookup gets 2s, a real delivery (agent prompt / send-text /
# send-keys) gets 7s. (Was a single 15s constant covering both.)
HERDR_READ_TIMEOUT = 2
HERDR_SEND_TIMEOUT = 7
MAX_DELIVERY_ATTEMPTS = 5
RETRY_AFTER_S = 30.0
VERSION = "0.3.1"  # keep in sync with herdr-plugin.toml
SCHEMA_VERSION = 1  # PRAGMA user_version this build writes; a newer ledger needs a newer radio


def state_dir() -> Path:
    """The one well-known ledger dir per machine: $RADIO_HOME, else
    ~/.local/share/herdr-radio. HERDR_PLUGIN_STATE_DIR is deliberately NOT
    used: the CLI runs from arbitrary panes and shells that never carry
    plugin env, so the ledger must resolve to the same path everywhere."""
    override = os.environ.get("RADIO_HOME")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".local" / "share" / "herdr-radio"


STATE_DIR = state_dir()
DB_PATH = STATE_DIR / "radio.db"
LOCK_PATH = STATE_DIR / "relay.lock"

SCHEMA = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS handles(
  workspace TEXT NOT NULL DEFAULT '',     -- herdr workspace (project) id; '' = outside herdr
  name TEXT NOT NULL,
  session_ref TEXT NOT NULL DEFAULT 'manual',
  kind TEXT NOT NULL DEFAULT 'terminal',
  agent TEXT,
  agent_session TEXT,
  briefed_at TEXT,
  role TEXT,                              -- free-form role paragraph, carried in the briefing
  created_at TEXT NOT NULL,
  last_seen TEXT NOT NULL,
  PRIMARY KEY (workspace, name)
);
CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name);
CREATE TABLE IF NOT EXISTS messages(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts TEXT NOT NULL,
  kind TEXT NOT NULL,            -- pm
  from_ws TEXT NOT NULL DEFAULT '',
  from_handle TEXT NOT NULL,
  to_ws TEXT NOT NULL DEFAULT '',
  to_handle TEXT,                -- pm target
  text TEXT NOT NULL,
  ref TEXT,                      -- file reference (payload stays out of the message)
  reply_required INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS deliveries(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  message_id INTEGER NOT NULL REFERENCES messages(id),
  target_ws TEXT NOT NULL DEFAULT '',
  target TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'pending',  -- pending|delivered|pull|failed
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  created_at TEXT NOT NULL,
  delivered_at TEXT
);
"""


def now() -> str:
    """Current UTC time in ISO-8601 millis — the ledger's only time format."""
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def connect() -> sqlite3.Connection:
    """Open the SQLite ledger (creating it and the schema as needed), apply
    any pending migrations, and return a Row-factory connection. A ledger
    written by a newer radio is refused with a clear message instead of a
    traceback; `radio repair --reset` is the way out."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    version = int(conn.execute("PRAGMA user_version").fetchone()[0])
    if version > SCHEMA_VERSION:
        conn.close()
        raise SystemExit(
            f"this ledger was written by a newer radio (schema {version}, this build "
            f"knows {SCHEMA_VERSION}); update the plugin, or run "
            "`radio repair --reset` to start from an empty ledger"
        )
    conn.executescript(SCHEMA)
    cols = {r["name"] for r in conn.execute("PRAGMA table_info(handles)").fetchall()}
    # Pre-scope ledgers first: the rebuild below copies these columns, so they
    # must exist before it runs.
    for column in ("agent", "agent_session", "briefed_at"):
        if column not in cols:
            conn.execute(f"ALTER TABLE handles ADD COLUMN {column} TEXT")
    if "workspace" not in cols:
        # SQLite cannot alter a primary key: rebuild the table for the scoped
        # identity (workspace, name). Existing rows predate scoping and remain
        # reachable as the unscoped ('') namespace.
        conn.executescript(
            """
            CREATE TABLE handles_scoped(
              workspace TEXT NOT NULL DEFAULT '',
              name TEXT NOT NULL,
              session_ref TEXT NOT NULL DEFAULT 'manual',
              kind TEXT NOT NULL DEFAULT 'terminal',
              agent TEXT,
              agent_session TEXT,
              briefed_at TEXT,
              role TEXT,
              created_at TEXT NOT NULL,
              last_seen TEXT NOT NULL,
              PRIMARY KEY (workspace, name)
            );
            INSERT INTO handles_scoped(workspace, name, session_ref, kind, agent, agent_session, briefed_at, created_at, last_seen)
              SELECT '', name, session_ref, kind, agent, agent_session, briefed_at, created_at, last_seen FROM handles;
            DROP TABLE handles;
            ALTER TABLE handles_scoped RENAME TO handles;
            CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name);
            """
        )
    elif "role" not in cols:
        conn.execute("ALTER TABLE handles ADD COLUMN role TEXT")
    msg_cols = {r["name"] for r in conn.execute("PRAGMA table_info(messages)").fetchall()}
    for column, ddl in (
        ("reply_required", "ALTER TABLE messages ADD COLUMN reply_required INTEGER NOT NULL DEFAULT 0"),
        ("from_ws", "ALTER TABLE messages ADD COLUMN from_ws TEXT NOT NULL DEFAULT ''"),
        ("to_ws", "ALTER TABLE messages ADD COLUMN to_ws TEXT NOT NULL DEFAULT ''"),
    ):
        if column not in msg_cols:
            conn.execute(ddl)
    del_cols = {r["name"] for r in conn.execute("PRAGMA table_info(deliveries)").fetchall()}
    for column, ddl in (
        ("last_attempt_at", "ALTER TABLE deliveries ADD COLUMN last_attempt_at TEXT"),
        ("target_ws", "ALTER TABLE deliveries ADD COLUMN target_ws TEXT NOT NULL DEFAULT ''"),
    ):
        if column not in del_cols:
            conn.execute(ddl)
    # Indexes last: on a pre-scope ledger the columns they reference only
    # exist after the migrations above. idx_deliveries_scope is a new name so
    # an old (target, status) index under the same table is left untouched.
    conn.execute("CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_deliveries_status ON deliveries(status)")
    conn.execute(
        "CREATE INDEX IF NOT EXISTS idx_deliveries_scope ON deliveries(target_ws, target, status)"
    )
    conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
    conn.commit()
    return conn


def herdr_bin() -> str:
    """Path to the herdr CLI: $HERDR_BIN_PATH, else PATH lookup, else the bare name."""
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"


def herdr(*args: str, timeout: float = HERDR_READ_TIMEOUT) -> subprocess.CompletedProcess[str]:
    """Run one herdr CLI invocation with captured output. Read-only lookups
    take the short read timeout (default); delivery paths pass the send
    timeout explicitly — one wedged herdr must not stall the relay."""
    return subprocess.run(
        [herdr_bin(), *args], text=True, capture_output=True, timeout=timeout
    )


def herdr_json(*args: str) -> dict | None:
    """Run herdr and parse stdout as JSON; None on any failure (missing
    binary, timeout, nonzero exit, or undecodable output)."""
    try:
        result = herdr(*args)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def fetch_pane(pane_id: str) -> dict | None:
    """Live pane record from herdr, or None when the pane is gone or herdr is unreachable."""
    data = herdr_json("pane", "get", pane_id)
    if not data:
        return None
    return data.get("result", {}).get("pane")


def current_session_ref() -> str:
    """This process's own binding: 'herdr:<pane-id>' inside a Herdr pane, else 'manual'."""
    if os.environ.get("HERDR_ENV") == "1" and os.environ.get("HERDR_PANE_ID"):
        return f"herdr:{os.environ['HERDR_PANE_ID']}"
    return "manual"


def pane_id_of(session_ref: str) -> str | None:
    """Pane id carried by a 'herdr:' session ref; None for manual refs."""
    if session_ref.startswith("herdr:"):
        return session_ref.removeprefix("herdr:")
    return None


def pane_exists(pane_id: str) -> bool:
    """True when herdr still knows this pane; False on any lookup failure."""
    try:
        return herdr("pane", "get", pane_id).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def push_to_pane(pane_id: str, text: str) -> tuple[bool, str | None]:
    """Deliver one line into a pane. Agent panes get a verified submission
    (--wait: herdr confirms the agent actually started working, so a 'success'
    can no longer mean text stranded in the composer); plain shells get literal
    text + Enter. Error contract for callers: 'agent_blocked' means nothing was
    submitted (safe to retry next tick); 'delivery_unconfirmed' means the
    submission state is UNKNOWN — never resubmit, a retry may duplicate."""
    try:
        prompted = herdr(
            "agent", "prompt", pane_id, text,
            "--wait", "--until", "working", "--until", "blocked",
            "--timeout", "6000",
            timeout=HERDR_SEND_TIMEOUT,
        )
        if prompted.returncode == 0:
            return True, None
        prompt_err = (prompted.stderr or prompted.stdout or "").strip()
        if "blocked" in prompt_err:
            # A modal dialog is up — never fall back to raw typing, the text
            # would land in the dialog. Caller defers and retries next tick.
            return False, "agent_blocked"
        if "stalled" in prompt_err or "timeout" in prompt_err:
            # --wait watches agent lifecycle state AFTER submission, so a
            # timeout can mean the prompt was already delivered. The state is
            # unknowable from here — the caller must not resubmit (duplicate
            # risk) and must not blind-type (composer stranding).
            return False, "delivery_unconfirmed"
        # Not an agent pane: type into the shell. Flatten newlines — an
        # embedded newline submits the line early and drops the rest.
        flat = " ".join(text.splitlines())
        typed = herdr("pane", "send-text", pane_id, flat, timeout=HERDR_SEND_TIMEOUT)
        if typed.returncode != 0:
            err = (prompt_err or typed.stderr or typed.stdout).strip()
            return False, err or "pane rejected delivery"
        time.sleep(0.4)  # let the paste land before Enter
        entered = herdr("pane", "send-keys", pane_id, "enter", timeout=HERDR_SEND_TIMEOUT)
        if entered.returncode != 0:
            return False, (entered.stderr or "enter key rejected").strip()
        return True, None
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)


def current_workspace() -> str:
    """This command's project scope: the herdr workspace id inside a pane,
    else '' (outside herdr — the unscoped namespace)."""
    if os.environ.get("HERDR_ENV") == "1":
        return os.environ.get("HERDR_WORKSPACE_ID", "")
    return ""


def identity(workspace: str, name: str) -> str:
    """The internal qualified form used in relay events and cross-scope
    envelopes: 'w1:alice' for scoped handles, the bare name for unscoped."""
    return f"{workspace}:{name}" if workspace else name


def workspace_labels() -> dict[str, str]:
    """Live workspace id → label map from herdr; empty when herdr is
    unreachable (callers fall back to bare ids)."""
    data = herdr_json("workspace", "list")
    if not data:
        return {}
    labels: dict[str, str] = {}
    for ws in data.get("result", {}).get("workspaces", []):
        if ws.get("workspace_id"):
            labels[str(ws["workspace_id"])] = str(ws.get("label") or "")
    return labels


def workspace_display(workspace: str, labels: dict[str, str] | None = None) -> str:
    """'w2 · Servers' for humans; the bare id when the label is unknown, and
    'no workspace' for the unscoped namespace."""
    if not workspace:
        return "no workspace"
    labels = workspace_labels() if labels is None else labels
    label = labels.get(workspace)
    return f"{workspace} · {label}" if label else workspace


def workspace_label(workspace: str) -> str:
    """The live label for a workspace id, or the id itself when herdr cannot
    answer — briefing and error paths must never depend on herdr."""
    return workspace_labels().get(workspace) or workspace


def resolve_workspace_spec(spec: str, conn: sqlite3.Connection | None = None) -> str:
    """Resolve a workspace id or label typed by a human into a workspace id:
    exact id first, then a unique case-insensitive label, then ids known in
    the ledger when herdr cannot answer. Unknown is a SystemExit naming the
    known workspaces."""
    if not spec:
        return ""
    labels = workspace_labels()
    if spec in labels:
        return spec
    matches = [ws for ws, label in labels.items() if label.casefold() == spec.casefold()]
    if len(matches) == 1:
        return matches[0]
    known = set(labels)
    if conn is not None:
        known |= {
            r["workspace"]
            for r in conn.execute("SELECT DISTINCT workspace FROM handles").fetchall()
            if r["workspace"]
        }
    if spec in known:
        return spec
    shown = ", ".join(sorted(workspace_display(ws, labels) for ws in known)) or "none"
    raise SystemExit(f"unknown workspace: {spec} (known: {shown})")


def resolve_identity(conn: sqlite3.Connection, explicit: str | None,
                     what: str = "handle") -> tuple[str, str]:
    """(workspace, name) for who is asking: the explicit argument (bare, or the
    internal 'w1:alice' form), else $RADIO_HANDLE, else the handle bound to
    this pane. An unregistered explicit name passes through with the caller's
    scope so reads simply match nothing."""
    scope = current_workspace()
    if explicit:
        row = resolve_handle(conn, explicit, scope)
        if row:
            return row["workspace"], row["name"]
        workspace, name = parse_handle(explicit)
        return workspace or scope, name
    env = os.environ.get("RADIO_HANDLE")
    if env:
        row = resolve_handle(conn, env, scope)
        if row:
            return row["workspace"], row["name"]
        return scope, normalize_handle(env)
    ref = current_session_ref()
    if ref != "manual":
        row = conn.execute("SELECT * FROM handles WHERE session_ref = ?", (ref,)).fetchone()
        if row:
            return row["workspace"], row["name"]
    raise SystemExit(
        f"{what} unknown: pass it explicitly, set RADIO_HANDLE, or join from this pane"
    )


HANDLE_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def normalize_handle(name: str) -> str:
    """Strip one leading '@' (agents naturally write `radio pm @foo`) and
    validate the charset. Anything outside [A-Za-z0-9_.-] is rejected:
    spaces or ']' would corrupt the [RADIO_MESSAGE from=...] header and the
    pane rename."""
    name = name.removeprefix("@")
    if not HANDLE_RE.match(name):
        raise SystemExit(f"invalid handle: {name!r} (allowed: letters, digits, _ . -)")
    return name


def parse_handle(spec: str) -> tuple[str, str]:
    """Split a handle reference into (workspace, name). 'w1:alice' names a
    workspace explicitly — the internal form scripts use from outside herdr;
    a bare name returns workspace '', i.e. 'resolve in my own scope'."""
    workspace, sep, name = spec.partition(":")
    if not sep:
        return "", normalize_handle(spec)
    return normalize_handle(workspace), normalize_handle(name)


def _match_in_workspace(conn: sqlite3.Connection, workspace: str,
                        name: str) -> sqlite3.Row | None:
    """One row by (workspace, name): exact spelling first, then a unique
    case-insensitive variant. Several spellings differing only by case are a
    SystemExit naming them (the pre-scope behavior); none returns None."""
    row = conn.execute(
        "SELECT * FROM handles WHERE workspace = ? AND name = ?", (workspace, name)
    ).fetchone()
    if row:
        return row
    rows = conn.execute(
        "SELECT * FROM handles WHERE workspace = ? AND LOWER(name) = LOWER(?)",
        (workspace, name),
    ).fetchall()
    if not rows:
        return None
    if len(rows) > 1:
        names = ", ".join(sorted(r["name"] for r in rows))
        raise SystemExit(f"ambiguous handle: {name!r} matches {names} — part one first")
    return rows[0]


def resolve_handle(conn: sqlite3.Connection, spec: str,
                   scope: str = "") -> sqlite3.Row | None:
    """Resolve a handle reference to its ledger row, honoring project scope.

    - `w1:alice` (internal form): exactly that workspace's handle.
    - bare name with a scope: this workspace first, then the unscoped
      namespace (handles outside herdr, or rows that predate scoping). A
      handle registered in another workspace is deliberately NOT reachable.
    - bare name without a scope (outside herdr): the unscoped handle, else a
      single scoped match anywhere, else a SystemExit listing the candidates.
    """
    workspace, name = parse_handle(spec)
    if workspace:
        return _match_in_workspace(conn, workspace, name)
    if scope:
        return _match_in_workspace(conn, scope, name) or _match_in_workspace(conn, "", name)
    row = _match_in_workspace(conn, "", name)
    if row:
        return row
    rows = conn.execute(
        "SELECT * FROM handles WHERE LOWER(name) = LOWER(?)", (name,)
    ).fetchall()
    if len(rows) > 1:
        names = ", ".join(sorted(identity(r["workspace"], r["name"]) for r in rows))
        raise SystemExit(f"ambiguous handle: {name!r} matches {names} — pass a workspace")
    return rows[0] if rows else None


def no_handle_message(conn: sqlite3.Connection, spec: str, scope: str) -> str:
    """The error text for an unresolved target. Inside a workspace the miss is
    explicit about the scope and, when the name exists elsewhere, says so
    without teaching cross-workspace addressing."""
    workspace, name = parse_handle(spec)
    if workspace:
        return f'no handle "{name}" in workspace {workspace_display(workspace)}'
    if scope:
        message = f'no handle "{name}" in this workspace ({workspace_display(scope)})'
        rows = conn.execute(
            "SELECT DISTINCT workspace FROM handles "
            "WHERE LOWER(name) = LOWER(?) AND workspace != ? AND workspace != ''",
            (name, scope),
        ).fetchall()
        if rows:
            labels = workspace_labels()
            others = ", ".join(sorted(workspace_display(r["workspace"], labels) for r in rows))
            message += f" — it exists in {others}, outside this workspace"
        return message
    return f"unknown handle: {name} (join first)"


def enqueue_delivery(conn: sqlite3.Connection, message_id: int, target: str,
                     target_ws: str = "") -> None:
    """Queue delivery of a message to a handle: 'pending' (relay pushes) when
    the target is bound to a pane, else 'pull' (recipient reads via inbox/show)."""
    row = conn.execute(
        "SELECT session_ref FROM handles WHERE workspace = ? AND name = ?",
        (target_ws, target),
    ).fetchone()
    has_pane = bool(row and pane_id_of(row["session_ref"]))
    conn.execute(
        "INSERT INTO deliveries(message_id, target_ws, target, status, created_at) "
        "VALUES (?,?,?,?,?)",
        (message_id, target_ws, target, "pending" if has_pane else "pull", now()),
    )


# ------------------------------------------------------------ providers
# Provider-specific knowledge lives here only: how to probe auth, how to find
# a session named after a handle, and how to launch/resume. Radio itself only
# records the user's choice on the handle row.

PROVIDERS = ("claude", "codex", "kimi", "pi", "gemini", "qwen", "opencode")


def auth_status(provider: str) -> str:
    """Human-readable auth state for a provider, probed from its on-disk
    credentials/config; 'auth unknown' for providers without a known probe."""
    if provider == "claude":
        home = Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser()
        if (home / ".credentials.json").exists():
            return "logged in"
        return "not logged in — ~/.claude/.credentials.json missing"
    if provider == "codex":
        home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
        if (home / "auth.json").exists():
            return "logged in"
        return "not logged in — ~/.codex/auth.json missing"
    if provider == "kimi":
        home = Path(os.environ.get("KIMI_HOME", "~/.kimi-code")).expanduser()
        if (home / "config.toml").exists():
            return "configured"
        return "not configured — ~/.kimi-code/config.toml missing"
    if provider == "gemini":
        home = Path(os.environ.get("GEMINI_CLI_HOME", "~/.gemini")).expanduser()
        if (home / "oauth_creds.json").exists():
            return "logged in"
        return "not logged in — ~/.gemini/oauth_creds.json missing"
    if provider == "qwen":
        home = Path(os.environ.get("QWEN_HOME", "~/.qwen")).expanduser()
        if (home / "oauth_creds.json").exists():
            return "logged in"
        return "not logged in — ~/.qwen/oauth_creds.json missing"
    if provider == "opencode":
        auth = Path(
            os.environ.get("XDG_DATA_HOME", "~/.local/share")
        ).expanduser() / "opencode" / "auth.json"
        if auth.exists():
            return "logged in"
        return "not logged in — run `opencode auth login`"
    return "auth unknown"


def choose(question: str, options: list[str], default: int = 0) -> int | None:
    """Pick one option interactively. POSIX terminals get the arrow-key menu;
    platforms without termios (Windows) get the numbered line picker, so every
    interactive flow (provider pick, resume prompts) works there too. Returns
    the chosen index, or None if cancelled."""
    if termios is None:
        return choose_plain(question, options, default)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    idx = default
    drawn = 0

    def render() -> None:
        nonlocal drawn
        if drawn:
            sys.stdout.write(f"\x1b[{drawn}A\x1b[J")  # up over the old block, clear it
        lines = [f"\x1b[1m{question}\x1b[0m"]
        for i, opt in enumerate(options):
            if i == idx:
                lines.append(f"  \x1b[36;1m❯ {opt}\x1b[0m")
            else:
                lines.append(f"    \x1b[2m{opt}\x1b[0m")
        lines.append("  \x1b[2m↑/↓ move · Enter select · q cancel\x1b[0m")
        sys.stdout.write("\n".join(lines) + "\n")
        sys.stdout.flush()
        drawn = len(lines)

    # TCSANOW, not the 3.13+ TCSAFLUSH default: typed-ahead input must survive.
    tty.setcbreak(fd, termios.TCSANOW)
    try:
        sys.stdout.write("\x1b[?25l")  # hide cursor while picking
        render()
        while True:
            ch = sys.stdin.read(1)
            if ch == "":  # stdin closed mid-pick
                return None
            if ch in ("\r", "\n"):
                return idx
            if ch in ("q", "Q", "\x03"):
                return None
            if ch == "\x1b":
                seq = sys.stdin.read(2)
                if seq == "[A" and idx > 0:
                    idx -= 1
                    render()
                elif seq == "[B" and idx < len(options) - 1:
                    idx += 1
                    render()
    except KeyboardInterrupt:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()


def choose_plain(question: str, options: list[str], default: int = 0) -> int | None:
    """Numbered, line-based menu for terminals without raw-key support
    (Windows). Enter takes the default, 'q' cancels, anything else re-prompts."""
    while True:
        sys.stdout.write(f"{question}\n")
        for i, opt in enumerate(options, start=1):
            mark = "*" if i - 1 == default else " "
            sys.stdout.write(f"  {mark} {i}) {opt}\n")
        sys.stdout.write(f"select 1-{len(options)} (Enter = {default + 1}, q = cancel): ")
        sys.stdout.flush()
        line = sys.stdin.readline()
        if line == "":  # stdin closed mid-pick
            return None
        answer = line.strip()
        if not answer:
            return default
        if answer in ("q", "Q"):
            return None
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer) - 1
        sys.stdout.write("invalid choice\n")


def _named(rows: list[dict]) -> dict | None:
    """The most recently updated row among named-session candidates (or None)."""
    best = None
    for row in rows:
        if best is None or (row.get("updated") or 0) >= (best.get("updated") or 0):
            best = row
    return best


def find_named_session(provider: str, handle: str) -> dict | None:
    """Latest saved provider session whose name matches the handle."""
    wanted = handle.casefold()
    if provider == "claude":
        # The sessions/ registry only lists live processes; the durable name is
        # the agent-name record inside the project transcript.
        home = Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser() / "projects"
        rows = []
        for path in home.glob("*/*.jsonl"):
            name, sid, cwd = "", "", ""
            try:
                with path.open(encoding="utf-8") as fh:
                    for line in fh:
                        if "agent-name" not in line and '"cwd"' not in line:
                            continue
                        try:
                            row = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if not cwd and row.get("cwd"):
                            cwd = str(row["cwd"])
                        if row.get("type") == "agent-name" and row.get("agentName"):
                            name = str(row["agentName"])
                            sid = str(row.get("sessionId") or path.stem)
            except OSError:
                continue
            if sid and name.casefold() == wanted:
                rows.append({"id": sid, "cwd": cwd, "updated": path.stat().st_mtime})
        return _named(rows)
    if provider == "codex":
        index = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser() / "session_index.jsonl"
        if not index.exists():
            return None
        rows = []
        try:
            lines = index.read_text(encoding="utf-8").splitlines()
        except OSError:
            return None
        for line in lines:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if str(row.get("thread_name") or "").casefold() != wanted:
                continue
            sid = str(row.get("id") or "")
            if sid:
                rows.append({"id": sid, "cwd": "", "updated": row.get("updated_at") or 0})
        return _named(rows)
    if provider == "kimi":
        base = Path(os.environ.get("KIMI_HOME", "~/.kimi-code")).expanduser() / "sessions"
        rows = []
        for path in base.glob("wd_*/session_*/state.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if row.get("archived") is True:
                continue
            if str(row.get("title") or "").casefold() != wanted:
                continue
            if row.get("isCustomTitle") is not True and row.get("titleKind") != "custom":
                continue
            sid = str(row.get("id") or path.parent.name)
            if sid:
                rows.append({"id": sid, "cwd": row.get("cwd") or "", "updated": row.get("updatedAt") or 0})
        return _named(rows)
    if provider == "pi":
        base = Path(
            os.environ.get("PI_CODING_AGENT_SESSION_DIR")
            or Path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi/agent")) / "sessions"
        ).expanduser()
        rows = []
        for path in base.glob("**/*.jsonl"):
            sid, name, updated = "", "", ""
            try:
                with path.open(encoding="utf-8") as fh:
                    for line in fh:
                        try:
                            row = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if row.get("type") == "session" and row.get("id"):
                            sid = str(row["id"])
                        if row.get("type") == "session_info" and row.get("name"):
                            name = str(row["name"])
                        if row.get("timestamp"):
                            updated = str(row["timestamp"])
            except OSError:
                continue
            if sid and name.casefold() == wanted:
                rows.append({"id": sid, "cwd": "", "updated": updated})
        return _named(rows)
    return None


def launch_argv(
    provider: str,
    handle: str,
    session_id: str | None,
    fresh: bool = False,
    workspace: str = "",
    role: str | None = None,
) -> list[str]:
    """Build the provider launch/resume argv for a handle."""
    # The radio briefing rides the launch as provider-native system context:
    # invisible, spends no turn, and the relay never messages the agent itself.
    # Resume gets it too — system context is per-process, a restored transcript
    # does not carry it.
    briefing = briefing_text(handle, workspace, role)
    if provider == "claude":
        argv = ["claude", "--append-system-prompt", briefing]
        return argv + (["--resume", session_id] if session_id else []) + ["--name", handle]
    if provider == "codex":
        # Codex rewrites the terminal title (OSC) with the current task text,
        # hiding the pane label that IS the radio handle. Turn its title writer
        # off for radio-launched sessions; the user's config.toml is untouched.
        # developer_instructions appends to the built-in instructions (unlike
        # model_instructions_file, which replaces them); json.dumps emits a
        # valid TOML basic string for -c parsing.
        argv = [
            "codex",
            "-c", "tui.terminal_title=[]",
            "-c", f"developer_instructions={json.dumps(briefing)}",
        ]
        return argv + (["resume", session_id] if session_id else [])
    if provider == "kimi":
        # No append-system-prompt flag and SessionStart hook stdout does not
        # reach context (verified). The briefing arrives with the first prompt
        # via bin/radio-kimi-hook.sh (UserPromptSubmit), keyed on RADIO_HANDLE.
        return ["kimi"] + (["--session", session_id] if session_id else [])
    if provider == "pi":
        return ["pi"] + (["--session", session_id] if session_id else []) + ["--name", handle]
    if provider == "qwen":
        # Radio-launched agents must answer messages unattended: auto-approve
        # tool calls (qwen has no safe-classifier mode that covers shell).
        argv = ["qwen", "--approval-mode", "yolo", "--append-system-prompt", briefing]
        if session_id:
            # join assigns the id itself (--session-id), so resume is exact.
            return argv + ["--session-id" if fresh else "--resume", session_id]
        return argv
    if provider == "gemini":
        # No append-system-prompt flag; the briefing is injected by the
        # SessionStart hook (bin/radio-gemini-hook.sh, additionalContext JSON).
        # --approval-mode yolo: radio agents must run `radio` without dialogs.
        argv = ["gemini", "--approval-mode", "yolo"]
        if session_id:
            # join assigns the id itself (--session-id), so resume is exact.
            return argv + ["--session-id" if fresh else "--resume", session_id]
        return argv
    if provider == "opencode":
        # Briefing rides a per-handle OPENCODE_CONFIG file (instructions) —
        # see cmd_join. Session ids are server-generated; resume only.
        return ["opencode"] + (["--session", session_id] if session_id else [])
    raise SystemExit(f"unknown provider: {provider}")


def agent_launch_argv(argv: list[str]) -> list[str]:
    """Resolve the provider binary and adapt the argv for the OS: Windows
    npm-style shims (.cmd/.bat) cannot be CreateProcess'd directly, so they run
    through cmd /c; POSIX execs the resolved path."""
    target = shutil.which(argv[0]) or argv[0]
    if os.name == "nt" and Path(target).suffix.lower() in (".cmd", ".bat"):
        return ["cmd.exe", "/c", target, *argv[1:]]
    return [target, *argv[1:]]


def windows_command_line(argv: list[str]) -> str:
    """The command-line string for a Windows launch. A .cmd/.bat target runs
    via cmd /c (CreateProcess cannot start batch files); cmd /c strips a lone
    outer quote pair, so a space-bearing target path gets the documented extra
    pair — otherwise cmd would split the path at its first space."""
    if len(argv) >= 3 and Path(argv[0]).name.lower() == "cmd.exe" and argv[1].lower() == "/c":
        target, rest = argv[2], subprocess.list2cmdline(argv[3:])
        body = f'"{target}"' + (f" {rest}" if rest else "")
        if " " in target:
            body = f'"{body}"'
        return f"cmd.exe /c {body}"
    return subprocess.list2cmdline(argv)


def exec_or_wait(argv: list[str], env: dict[str, str]) -> int:
    """Hand the terminal to another program. POSIX execs in place — the pane's
    foreground process becomes the target. Windows has no true exec (the CRT
    spawns a process and exits, which would return the shell prompt while the
    target still runs), so the target runs as a waited-for child instead."""
    if os.name == "nt":
        try:
            return subprocess.run(windows_command_line(argv), env=env).returncode
        except OSError as exc:
            raise SystemExit(f"launch failed: {exc}")
    try:
        os.execvpe(argv[0], argv, env)
    except OSError as exc:
        raise SystemExit(f"launch failed: {exc}")
    return 0  # unreachable


def launch_agent(argv: list[str], env: dict[str, str]) -> int:
    """Resolve the provider CLI for this OS (see agent_launch_argv) and hand
    the terminal to it; returns only on the Windows wait path."""
    return exec_or_wait(agent_launch_argv(argv), env)


def ask_provider(handle: str) -> str:
    """Interactive provider picker; returns the provider name, or '' when the
    user picks 'none' (register only). Raises SystemExit on cancel."""
    options = []
    for name in PROVIDERS:
        binary = "" if shutil.which(name) else "  (not on PATH)"
        options.append(f"{name} — {auth_status(name)}{binary}")
    options.append("none — just register the handle, don't launch an agent")
    idx = choose(f'Which agent should "{handle}" join as?', options)
    if idx is None:
        raise SystemExit("cancelled")
    return "" if idx == len(PROVIDERS) else PROVIDERS[idx]


def cmd_join(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Register a handle bound to the current (or given) pane inside its
    workspace, adopt or pick its provider session, and — when interactive —
    exec the agent with the radio briefing attached. Pane label and handle are
    kept identical; the workspace comes from the pane or the caller's env."""
    interactive = not args.no_launch and sys.stdin.isatty() and sys.stdout.isatty()

    pane_id = args.pane
    if not pane_id and os.environ.get("HERDR_ENV") == "1":
        pane_id = os.environ.get("HERDR_PANE_ID")
    pane = fetch_pane(pane_id) if pane_id else None
    if pane_id and pane is None:
        raise SystemExit(f"pane not found: {pane_id}")
    workspace = (pane or {}).get("workspace_id") or current_workspace()

    handle = args.handle
    label = (pane or {}).get("label") or ""
    if not handle and interactive and not label:
        handle = input("Handle for this pane (the name others will use to message it): ").strip()
    if not handle:
        if not label:
            raise SystemExit("pass a handle, or give the pane a label first")
        handle = label
    handle = normalize_handle(handle)
    # Case-insensitive rejoin resolves inside this workspace first, then the
    # unscoped namespace (rows that predate scoping) — never another
    # workspace's spelling: a case-variant row would split the identity, and
    # the label check would then report one spelling as "gone (pane reused)".
    registered = resolve_handle(conn, handle, workspace)
    handle = registered["name"] if registered else handle
    if pane and label != handle:
        # The pane label IS the handle: it is what survives session restore and
        # what the UI shows. Keep them identical instead of tracking two names.
        renamed = herdr("pane", "rename", pane_id, handle)
        if renamed.returncode != 0:
            raise SystemExit(f"pane rename failed: {(renamed.stderr or '').strip()}")

    provider = args.provider or ""
    session_id = None
    existing = registered
    if existing is not None and existing["workspace"] == "" and workspace:
        # A pre-scope row bound to this workspace: adopt it into the scope so
        # a rejoin never forks a duplicate row for the same pane.
        if _match_in_workspace(conn, workspace, handle) is None:
            conn.execute(
                "UPDATE handles SET workspace=? WHERE workspace='' AND name=?",
                (workspace, handle),
            )
            conn.commit()
            existing = conn.execute(
                "SELECT * FROM handles WHERE workspace=? AND name=?", (workspace, handle)
            ).fetchone()
    if (
        existing
        and existing["agent"]
        and not existing["agent_session"]
        and existing["session_ref"].startswith("herdr:")
    ):
        # Join could not see the session id while the agent was still booting.
        # Adopt it now from the bound pane (guarded: same provider, same label,
        # so a reused pane never donates its session to the wrong handle).
        bound = fetch_pane(existing["session_ref"].removeprefix("herdr:"))
        if (
            bound
            and bound.get("agent") == existing["agent"]
            and (bound.get("label") or "") == handle
            and (
                not existing["workspace"]
                or (bound.get("workspace_id") or "") == existing["workspace"]
            )
        ):
            live = (bound.get("agent_session") or {}).get("value")
            if live:
                conn.execute(
                    "UPDATE handles SET agent_session=? WHERE workspace=? AND name=?",
                    (live, workspace, handle),
                )
                conn.commit()
                existing = conn.execute(
                    "SELECT * FROM handles WHERE workspace=? AND name=?", (workspace, handle)
                ).fetchone()
    if (
        interactive
        and not provider
        and not args.new
        and existing
        and existing["agent"]
        and existing["agent_session"]
    ):
        # This handle already ran here: offer its recorded session before
        # asking for provider/session from scratch.
        idx = choose(
            f'"{handle}" already joined as {existing["agent"]} '
            f"(session {existing['agent_session'][:8]}) — bring it back?",
            ["Bring it back — resume the recorded session",
             "Start over — pick provider and session again"],
        )
        if idx is None:
            raise SystemExit("cancelled")
        if idx == 0:
            provider = existing["agent"]
            session_id = existing["agent_session"]

    if interactive and not provider:
        provider = ask_provider(handle)
    if provider and args.resume and not session_id:
        # Explicit --resume: the ledger's recorded session (backfilled from the
        # live pane) is authoritative; the provider disk search is the fallback.
        # Never silently start fresh — a missed resume is an error, not a new chat.
        if existing and existing["agent"] == provider and existing["agent_session"]:
            session_id = existing["agent_session"]
        else:
            found = find_named_session(provider, handle)
            if found:
                session_id = found["id"]
            else:
                raise SystemExit(f"no saved {provider} session named {handle}")
    elif provider and interactive and not session_id:
        found = None if args.new else find_named_session(provider, handle)
        if found:
            cwd = found["cwd"] or "cwd unknown"
            idx = choose(
                f'"{handle}" has a saved {provider} session '
                f"({found['id'][:8]}, {cwd}) — resume it?",
                ["Resume it — continue the previous conversation",
                 "Start a new session instead"],
            )
            if idx is None:
                raise SystemExit("cancelled")
            if idx == 0:
                session_id = found["id"]
        else:
            print(f"no saved {provider} session named {handle}; starting new")

    launching = interactive and bool(provider)
    # Providers that accept a caller-assigned session id get one now: the
    # ledger knows the real id before launch, no boot-window backfill needed.
    assign_id = provider in ("gemini", "qwen")
    fresh = bool(launching and assign_id and not session_id)
    if fresh:
        session_id = str(uuid.uuid4())
    pane_session = ((pane or {}).get("agent_session") or {}).get("value")
    if session_id:
        agent_session = session_id
    elif launching:
        # A new agent is about to boot in this pane; the pane's current
        # session id belongs to the process being replaced. Leave NULL, the
        # relay backfills the real id once the agent is up.
        agent_session = None
    else:
        agent_session = pane_session or (existing["agent_session"] if existing else None)
    ref = f"herdr:{pane_id}" if pane else "manual"
    if ref == "manual" and existing and existing["session_ref"].startswith("herdr:"):
        old_pane = existing["session_ref"].removeprefix("herdr:")
        if pane_exists(old_pane):
            # A pane-less rejoin must not clobber a live pane binding.
            ref = existing["session_ref"]
    if args.role is not None:
        role = args.role.strip() or None  # --role "" clears the paragraph
    else:
        role = existing["role"] if existing else None
    ts = now()
    conn.execute(
        """INSERT INTO handles(workspace, name, session_ref, agent, agent_session, role, created_at, last_seen)
           VALUES (?,?,?,?,?,?,?,?)
           ON CONFLICT(workspace, name) DO UPDATE SET session_ref=excluded.session_ref,
                                                      agent=excluded.agent,
                                                      agent_session=excluded.agent_session,
                                                      role=excluded.role,
                                                      last_seen=excluded.last_seen""",
        (workspace, handle, ref, provider or None, agent_session, role, ts, ts),
    )
    conn.commit()
    session_note = f", {provider} session {agent_session[:8]}" if provider and agent_session else ""
    where_note = f" in workspace {workspace}" if workspace else ""
    print(f"{handle} joined{where_note} ({ref}{session_note})")

    if ref != "manual":
        # Catch-up compaction: a handle rejoining on a live pane must not get
        # its entire backlog pushed into the fresh agent. Only the newest
        # reply-required PM per sender stays push-worthy; every other pending
        # delivery — and old 'failed' rows, which were terminal forever —
        # degrades to pull: fetchable via inbox/show, never auto-pushed.
        keep_ids = [
            r["mid"]
            for r in conn.execute(
                """SELECT MAX(m.id) AS mid
                   FROM deliveries d JOIN messages m ON m.id = d.message_id
                   WHERE d.target_ws = ? AND d.target = ? AND d.status = 'pending'
                     AND m.reply_required = 1
                   GROUP BY m.from_ws, m.from_handle""",
                (workspace, handle),
            ).fetchall()
        ]
        clause = ""
        values: list[object] = [workspace, handle]
        if keep_ids:
            clause = f" AND message_id NOT IN ({','.join('?' * len(keep_ids))})"
            values += keep_ids
        demoted = conn.execute(
            "UPDATE deliveries SET status='pull', last_error='catch-up: read via radio inbox' "
            f"WHERE target_ws = ? AND target = ? AND status = 'pending'{clause}",
            values,
        ).rowcount
        revived = conn.execute(
            "UPDATE deliveries SET status='pull', last_error='catch-up: read via radio inbox' "
            "WHERE target_ws = ? AND target = ? AND status = 'failed'",
            (workspace, handle),
        ).rowcount
        conn.commit()
        if keep_ids or demoted or revived:
            print(f"catch-up: {len(keep_ids)} push (reply-required), "
                  f"{demoted + revived} left for pull")

    if not interactive or not provider:
        return 0
    argv = launch_argv(provider, handle, session_id, fresh=fresh, workspace=workspace, role=role)
    env = os.environ.copy()
    env["RADIO_HANDLE"] = handle
    if provider == "opencode":
        # No append flag/hook channel; briefing ships as an `instructions`
        # file via a per-handle OPENCODE_CONFIG file. (OPENCODE_CONFIG_CONTENT
        # inline config resolves in `debug config` but its instructions never
        # reach the model — verified on 1.18.31.) Merges with user config;
        # its `instructions` shadows the user's global list for this session.
        brief_dir = STATE_DIR / "opencode"
        brief_dir.mkdir(parents=True, exist_ok=True)
        brief_file = brief_dir / f"{handle}.md"
        brief_file.write_text(briefing_text(handle, workspace, role), encoding="utf-8")
        cfg: dict = {"instructions": [str(brief_file)]}
        # Ref-based sharing means agents read files outside their cwd (the
        # sender's /tmp, another project). opencode asks on external_directory
        # by default; radio-launched handles must not stall on that dialog.
        cfg["permission"] = {"external_directory": "allow"}
        if args.model:
            cfg["model"] = args.model
        cfg_file = brief_dir / f"{handle}.json"
        cfg_file.write_text(json.dumps(cfg), encoding="utf-8")
        env["OPENCODE_CONFIG"] = str(cfg_file)
    elif args.model:
        print(f"note: --model is only wired for opencode; ignoring for {provider}")
    print(f"launching: {' '.join(argv)}")
    return launch_agent(argv, env)


def briefing_text(handle: str, workspace: str = "", role: str | None = None) -> str:
    """The opening briefing every radio-launched agent gets: its handle, its
    project scope, its role paragraph when one is set, the commands, ref-based
    sharing for long content, and the push-based delivery contract (never poll
    inbox, never set timers waiting for a reply)."""
    where = f' in workspace "{workspace_label(workspace)}"' if workspace else ""
    role_line = f"Your role: {role} " if role else ""
    return (
        f'You are on Radio as "{handle}"{where}. '
        + role_line
        + "Radio is scoped to this workspace: `radio handles` lists this "
        "project's agents and `radio pm <handle>` reaches this project. "
        "Commands: "
        "radio handles (who is on) · "
        'radio pm <handle> "<message>" (direct message) · '
        'radio pm <handle> "<message>" --reply-required (when you need an answer — '
        "asking for a reply inside the message text does NOT set the flag) · "
        f"radio inbox {handle} · radio show <id> (FALLBACK ONLY — see below). "
        "Keep messages short: for long content (reports, logs, diffs) write "
        "it to a file and attach it as --ref <path> — the recipient reads "
        "the file itself, on demand. "
        "Delivery is push-based: incoming messages arrive in this pane by "
        "themselves, wrapped in [RADIO_MESSAGE ...] envelopes; the header's "
        "reply=required means you must answer over radio. After sending a "
        "message, NEVER poll `radio inbox` and NEVER set timers to check for "
        "a reply — the reply arrives pushed to this pane on its own; continue "
        "other work or simply stop. `radio inbox` exists only for messages "
        "that could not be pushed (e.g. while your pane had no agent), not "
        "for waiting on replies."
    )


def cmd_part(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Remove a handle from the caller's workspace and fail its still-
    undelivered deliveries."""
    scope = current_workspace()
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    conn.execute(
        "DELETE FROM handles WHERE workspace = ? AND name = ?",
        (row["workspace"], row["name"]),
    )
    conn.execute(
        "UPDATE deliveries SET status='failed', last_error='handle parted' "
        "WHERE target_ws = ? AND target = ? AND status IN ('pending', 'pull')",
        (row["workspace"], row["name"]),
    )
    conn.commit()
    print(f"{row['name']} parted")
    return 0


def cmd_role(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Show, set, or clear one handle's role paragraph in the caller's
    workspace. The role is ledger state, not a message — a change reaches the
    agent on its next join/resume briefing and is never pushed."""
    scope = current_workspace()
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    if args.clear:
        conn.execute(
            "UPDATE handles SET role = NULL WHERE workspace = ? AND name = ?",
            (row["workspace"], row["name"]),
        )
        conn.commit()
        print(f"role cleared for {row['name']}")
        return 0
    text = " ".join(args.text).strip()
    if not text:
        print(row["role"] or f"no role set for {row['name']}")
        return 0
    conn.execute(
        "UPDATE handles SET role = ? WHERE workspace = ? AND name = ?",
        (text, row["workspace"], row["name"]),
    )
    conn.commit()
    print(f"role set for {row['name']} — it reaches the agent on its next join/resume")
    return 0


def record_message(
    conn: sqlite3.Connection,
    kind: str,
    sender: str,
    text: str,
    to_handle: str | None = None,
    ref: str | None = None,
    reply_required: bool = False,
    from_ws: str = "",
    to_ws: str = "",
) -> int:
    """Insert one message row and return its id. Queuing the delivery is a
    separate step (enqueue_delivery) so callers compose the two. Backticks
    are normalized to quotes at this single insertion point: model-generated
    text habitually contains them, and typed into a shell pane (the send-text
    fallback) a backtick is shell command substitution."""
    text = text.replace("`", "'")
    cur = conn.execute(
        "INSERT INTO messages(ts, kind, from_ws, from_handle, to_ws, to_handle, text, ref, reply_required) "
        "VALUES (?,?,?,?,?,?,?,?,?)",
        (now(), kind, from_ws, sender, to_ws, to_handle, text, ref, int(reply_required)),
    )
    return int(cur.lastrowid)


LONG_MESSAGE_CHARS = 1200


def cmd_pm(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Record a direct message to a joined handle in the sender's workspace
    and queue its delivery; nudges toward --ref for long texts and restates
    the no-poll rule for reply-required sends."""
    from_ws, sender = resolve_identity(conn, args.sender, what="sender")
    if _match_in_workspace(conn, from_ws, sender) is None:
        # Sending as an unregistered name works, but the recipient cannot
        # resolve it to reply — say so at the moment it matters.
        print(
            f'note: sender "{sender}" is not a joined handle — replies to it will not '
            f'resolve until it joins (radio join {sender})'
        )
    row = resolve_handle(conn, args.to, from_ws)
    if not row:
        raise SystemExit(no_handle_message(conn, args.to, from_ws))
    to_ws, args.to = row["workspace"], row["name"]
    text = " ".join(args.text)
    mid = record_message(conn, "pm", sender, text, to_handle=args.to,
                         ref=args.ref, reply_required=args.reply_required,
                         from_ws=from_ws, to_ws=to_ws)
    enqueue_delivery(conn, mid, args.to, to_ws)
    conn.commit()
    print(f"pm #{mid} -> {args.to}")
    if len(text) > LONG_MESSAGE_CHARS:
        # Token-sensitive bus: a long paste costs the recipient a big prompt.
        # Nudge at the exact moment it happens.
        print(
            f"note: {len(text)} chars is a heavy message — next time write the "
            "content to a file and send --ref <path>; the recipient reads it "
            "itself, on demand."
        )
    if args.reply_required:
        # Senders expecting an answer tend to poll `radio inbox` in a loop.
        # State the push contract at the exact moment the impulse starts.
        print(
            "The reply is pushed to your pane as a [RADIO_MESSAGE] envelope — "
            "do NOT poll `radio inbox` or set timers to check for it; "
            "continue other work or stop."
        )
    return 0


def handle_status(row: sqlite3.Row) -> str:
    """Fresh liveness from the bound pane — the ledger row alone says nothing
    about whether the agent is still there (panes close, get reused, agents
    exit; nothing parts automatically). A moved pane gets a new
    workspace-qualified id, so a workspace mismatch here means the row was
    recorded against the wrong project."""
    ref = row["session_ref"]
    if not ref.startswith("herdr:"):
        return "manual"
    pane = fetch_pane(ref.removeprefix("herdr:"))
    if not pane:
        return "gone (no live pane)"
    if (pane.get("label") or "") != row["name"]:
        return "gone (pane reused)"
    if row["workspace"] and (pane.get("workspace_id") or "") != row["workspace"]:
        return "gone (pane moved)"
    if row["agent"]:
        live = pane.get("agent")
        if live == row["agent"]:
            return "live"
        if live:
            return f"gone (pane now runs {live})"
        return "gone (agent exited)"
    return "live"


def handle_line(row: sqlite3.Row) -> str:
    """One roster line plus an indented role snippet when a role is set."""
    provider = row["agent"] or "-"
    session = (row["agent_session"] or "-")[:8]
    line = (
        f"  {row['name']:<20} {handle_status(row):<26} {row['session_ref']:<14} "
        f"{provider:<8} sess: {session:<8}"
    )
    role = row["role"] or ""
    if role:
        snippet = role[:80] + ("…" if len(role) > 80 else "")
        line += f"\n    role: {snippet}"
    return line


def cmd_handles(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the roster: inside a pane only this workspace's handles, outside
    herdr every handle grouped by workspace. An explicit workspace id or label
    narrows it to that project."""
    def scoped(workspace: str) -> int:
        rows = conn.execute(
            "SELECT * FROM handles WHERE workspace = ? ORDER BY name", (workspace,)
        ).fetchall()
        if not rows:
            print(f"no handles in {workspace_display(workspace)}")
        else:
            print(f"handles in {workspace_display(workspace)}:")
            for row in rows:
                print(handle_line(row))
        return 0

    if args.workspace:
        return scoped(resolve_workspace_spec(args.workspace, conn))
    scope = current_workspace()
    if scope:
        return scoped(scope)
    rows = conn.execute("SELECT * FROM handles ORDER BY workspace, name").fetchall()
    if not rows:
        print("no handles joined")
        return 0
    labels = workspace_labels()
    last = None
    for row in rows:
        if row["workspace"] != last:
            last = row["workspace"]
            print(f"{workspace_display(last, labels)}:")
        print(handle_line(row))
    return 0


def cmd_log(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the most recent messages, oldest last. Inside a pane only this
    workspace's traffic; outside herdr the full ledger."""
    scope = current_workspace()
    if scope:
        rows = conn.execute(
            "SELECT * FROM messages WHERE from_ws = ? OR to_ws = ? ORDER BY id DESC LIMIT ?",
            (scope, scope, args.limit),
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM messages ORDER BY id DESC LIMIT ?", (args.limit,)
        ).fetchall()
    for row in reversed(rows):
        target = f"-> {row['to_handle'] or '-'}"
        flag = " [reply-required]" if row["reply_required"] else ""
        ref = f" (ref: {row['ref']})" if "ref" in row.keys() and row["ref"] else ""
        print(f"#{row['id']} {row['ts']} {row['from_handle']} {target}{flag}{ref}: {row['text']}")
    return 0


def cmd_inbox(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Metadata-only index of incoming messages — bodies stay out of context
    until the agent asks for one with `radio show <id>`. Listing consumes
    nothing; delivery state is recorded by the relay (push) or by show."""
    handle_ws, handle = resolve_identity(conn, args.handle, what="inbox handle")
    clause = "" if args.status == "all" else " AND d.status = ?"
    values: list[object] = [handle_ws, handle]
    if args.status != "all":
        values.append(args.status)
    values.append(args.limit)
    rows = conn.execute(
        f"""SELECT d.id AS delivery_id, d.status, m.*
            FROM deliveries d JOIN messages m ON m.id = d.message_id
            WHERE d.target_ws = ? AND d.target = ?{clause}
            ORDER BY m.id DESC LIMIT ?""",
        values,
    ).fetchall()
    if not rows:
        print(f"inbox empty for {handle}")
        print(
            "(new messages are pushed to your pane automatically — "
            "do not poll this command waiting for a reply)"
        )
        return 0
    print(f"inbox for {handle} (newest {len(rows)}):")
    for row in rows:
        text = row["text"] or ""
        snippet = text[:20] + ("…" if len(text) > 20 else "")
        try:
            stamp = datetime.fromisoformat(row["ts"]).astimezone().strftime("%m-%d %H:%M")
        except ValueError:
            stamp = row["ts"][:16]
        flag = " ⚠reply" if row["reply_required"] else ""
        ref = " ref" if "ref" in row.keys() and row["ref"] else ""
        print(
            f"  #{row['id']} {stamp} {row['from_handle']:<14} {row['status']:<10} "
            f"{len(text)}c{flag}{ref}  {snippet}"
        )
    print("read one: radio show <id>")
    return 0


def cmd_show(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print one message body (the exact envelope the pane received). Reading
    as the addressed recipient records the delivery — that is the pull path's
    acknowledgement."""
    row = conn.execute("SELECT * FROM messages WHERE id = ?", (args.message_id,)).fetchone()
    if row is None:
        raise SystemExit(f"no message #{args.message_id}")
    print(format_for_pane(row))
    try:
        viewer_ws, viewer = resolve_identity(conn, args.by, what="reader")
    except SystemExit:
        return 0  # reading without an identity is fine; nothing to record
    if (viewer_ws, viewer) == (row["to_ws"], row["to_handle"]):
        conn.execute(
            """UPDATE deliveries SET status='delivered', delivered_at=?
               WHERE message_id = ? AND target_ws = ? AND target = ?
                 AND status IN ('pending', 'pull', 'failed')""",
            (now(), args.message_id, viewer_ws, viewer),
        )
        conn.commit()
    return 0


def format_for_pane(message: sqlite3.Row) -> str:
    # Legacy Arkai radio envelope: the reply semantics live in the structured
    # header, not in inline command hints — agents learn the commands from the
    # opening briefing. Multi-line is fine: agent panes get an atomic verified
    # submission, and the shell path flattens newlines before typing.
    mid = message["id"]
    reply = "required" if message["reply_required"] else "not-required"
    reply_line = "\nReply required: answer this over radio." if message["reply_required"] else ""
    ref_line = ""
    if "ref" in message.keys() and message["ref"]:
        ref_line = f"\nRef: {message['ref']}"
    from_display = message["from_handle"]
    if message["from_ws"] and message["from_ws"] != message["to_ws"]:
        # Cross-scope mail (a script or manual sender): the qualified form is
        # the only address the recipient can reply to.
        from_display = identity(message["from_ws"], message["from_handle"])
    return (
        f"[RADIO_MESSAGE id={mid} kind=pm from={from_display} "
        f"to={message['to_handle']} reply={reply}]\n"
        f"Radio PM from {message['from_handle']}{reply_line}\n"
        f"{message['text']}{ref_line}\n"
        f"[END_RADIO_MESSAGE id={mid}]"
    )


AGENT_BOOT_GRACE_S = 30.0


def delivery_wait_reason(pane: dict, handle: sqlite3.Row) -> str | None:
    """Hold a delivery while the target agent cannot accept input yet: a modal
    dialog is up (blocked), a turn is running (working — codex silently drops
    prompts submitted mid-turn), or the agent process is still booting (herdr
    has not detected it within the join grace window). Typing into any of
    these strands text in the composer or a dialog."""
    status = pane.get("agent_status") or "unknown"
    if status in ("blocked", "working"):
        return f"agent {status}"
    if pane.get("agent"):
        return None  # detected agent: herdr agent prompt submits atomically
    if not handle["agent"]:
        return None  # plain shell/bot pane: type right away
    try:
        age = (
            datetime.now(timezone.utc) - datetime.fromisoformat(handle["last_seen"])
        ).total_seconds()
    except (TypeError, ValueError):
        return None
    if age < AGENT_BOOT_GRACE_S:
        return "agent still booting"
    return None


def relay_tick(conn: sqlite3.Connection) -> list[str]:
    """One relay pass: backfill agent session ids join could not see, then
    push pending deliveries. Returns human-readable event lines."""
    events: list[str] = []
    # Backfill agent session ids that join could not see while the agent was
    # still booting. Guarded by provider+label match so a reused pane never
    # donates its session to the wrong handle.
    for h in conn.execute(
        "SELECT workspace, name, session_ref, agent FROM handles "
        "WHERE agent_session IS NULL AND agent IS NOT NULL AND session_ref LIKE 'herdr:%'"
    ).fetchall():
        pane = fetch_pane(h["session_ref"].removeprefix("herdr:"))
        if (
            not pane
            or pane.get("agent") != h["agent"]
            or (pane.get("label") or "") != h["name"]
            or (h["workspace"] and (pane.get("workspace_id") or "") != h["workspace"])
        ):
            continue
        sess = (pane.get("agent_session") or {}).get("value")
        if sess:
            conn.execute(
                "UPDATE handles SET agent_session=? WHERE workspace=? AND name=?",
                (sess, h["workspace"], h["name"]),
            )
            events.append(
                f"{identity(h['workspace'], h['name'])}: backfilled {h['agent']} session {sess[:8]}"
            )
    conn.commit()
    # Re-promote deliveries stranded by downtime: 'pull' + 'no live pane'
    # means the pane was gone at push time — transient. Catch-up demotions
    # ('catch-up: read via radio inbox') and 'delivery unconfirmed' stays are
    # deliberate and must NEVER be auto-pushed; only 'no live pane' comes back.
    for d in conn.execute(
        "SELECT id, target_ws, target FROM deliveries "
        "WHERE status = 'pull' AND last_error = 'no live pane'"
    ).fetchall():
        handle = conn.execute(
            "SELECT session_ref, agent FROM handles WHERE workspace = ? AND name = ?",
            (d["target_ws"], d["target"]),
        ).fetchone()
        pane_id = pane_id_of(handle["session_ref"]) if handle else None
        pane = fetch_pane(pane_id) if pane_id else None
        if not pane:
            continue
        # Same identity guard as the push path: a reused pane gets nothing.
        if (pane.get("label") or "").casefold() != d["target"].casefold():
            continue
        if d["target_ws"] and (pane.get("workspace_id") or "") != d["target_ws"]:
            continue
        if handle["agent"] and pane.get("agent") != handle["agent"]:
            continue
        cur = conn.execute(
            "UPDATE deliveries SET status='pending', last_error=NULL "
            "WHERE id = ? AND status = 'pull'",
            (d["id"],),
        )
        if cur.rowcount:
            events.append(
                f"#{d['id']} -> {identity(d['target_ws'], d['target'])} ({pane_id}): "
                "pane back, re-queued for push"
            )
    conn.commit()
    # Backoff + fresh-first: an errored delivery is retried only after
    # RETRY_AFTER_S (each retry costs several herdr subprocess calls), and new
    # mail always goes ahead of retries. last_attempt_at IS NULL covers rows
    # errored before the column existed.
    cutoff = (datetime.now(timezone.utc) - timedelta(seconds=RETRY_AFTER_S)).isoformat(
        timespec="milliseconds"
    )
    rows = conn.execute(
        """SELECT d.id AS delivery_id, d.target_ws, d.target, d.attempts, m.*
           FROM deliveries d JOIN messages m ON m.id = d.message_id
           WHERE d.status = 'pending'
             AND (d.attempts = 0 OR d.last_attempt_at IS NULL OR d.last_attempt_at <= ?)
           ORDER BY CASE WHEN d.attempts = 0 THEN 0 ELSE 1 END, d.id LIMIT 50""",
        (cutoff,),
    ).fetchall()
    # Every delivery UPDATE below is compare-and-swap on the state it expects
    # (AND status = 'pending'): cmd_show may have acked the row (delivered)
    # between our SELECT and UPDATE, and an unconditional write would lose
    # that ack. rowcount 0 means the row moved under us — the push outcome is
    # no longer authoritative, so no event either.
    for row in rows:
        delivery_id = row["delivery_id"]
        target = identity(row["target_ws"], row["target"])
        handle = conn.execute(
            "SELECT session_ref, agent, last_seen FROM handles WHERE workspace = ? AND name = ?",
            (row["target_ws"], row["target"]),
        ).fetchone()
        pane_id = pane_id_of(handle["session_ref"]) if handle else None
        pane = fetch_pane(pane_id) if pane_id else None
        if not pane_id or pane is None:
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='no live pane' "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target}: no live pane, left for pull")
            continue
        # Identity guard: a live pane id proves nothing — panes get reused.
        # Never push one handle's mail into a pane that now belongs to
        # someone else; leave it for pull instead (mirrors handle_status).
        if (pane.get("label") or "").casefold() != row["target"].casefold():
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='pane reused' "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): pane reused, left for pull")
            continue
        if row["target_ws"] and (pane.get("workspace_id") or "") != row["target_ws"]:
            # A moved pane gets a fresh workspace-qualified id, so this only
            # fires when the row's workspace was recorded wrong.
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='workspace changed' "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): workspace changed, left for pull")
            continue
        if handle["agent"] and pane.get("agent") != handle["agent"]:
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='agent changed' "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): agent changed, left for pull")
            continue
        wait = delivery_wait_reason(pane, handle)
        if wait:
            events.append(f"#{delivery_id} -> {target} ({pane_id}) waiting: {wait}")
            continue
        ok, error = push_to_pane(pane_id, format_for_pane(row))
        if not ok and error == "agent_blocked":
            # A defer, not an attempt: no attempts increment, no last_attempt_at.
            events.append(f"#{delivery_id} -> {target} ({pane_id}) waiting: agent blocked")
            continue
        attempted_at = now()
        if not ok and error == "delivery_unconfirmed":
            # The submission may have landed despite the --wait timeout —
            # retrying risks a duplicate. Terminal for push: pull only.
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_attempt_at=?, "
                "last_error='delivery unconfirmed — left for pull, not retried' "
                "WHERE id = ? AND status = 'pending'",
                (attempted_at, delivery_id),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): unconfirmed, left for pull")
            continue
        if ok:
            cur = conn.execute(
                "UPDATE deliveries SET status='delivered', delivered_at=?, last_attempt_at=? "
                "WHERE id = ? AND status = 'pending'",
                (attempted_at, attempted_at, delivery_id),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}) delivered")
        else:
            attempts = int(row["attempts"]) + 1
            status = "failed" if attempts >= MAX_DELIVERY_ATTEMPTS else "pending"
            cur = conn.execute(
                "UPDATE deliveries SET status=?, attempts=?, last_error=?, last_attempt_at=? "
                "WHERE id = ? AND status = 'pending'",
                (status, attempts, error, attempted_at, delivery_id),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} attempt {attempts}: {error}")
    conn.commit()
    return events


def cmd_view(_args: argparse.Namespace) -> int:
    """Hand off to the Textual view (bin/radio-view) through the cross-platform
    launcher (bin/run-view.py picks the venv interpreter)."""
    launcher = Path(__file__).resolve().parent / "run-view.py"
    return exec_or_wait([sys.executable, str(launcher)], os.environ.copy())


def changed_events(events: list[str], seen: dict[str, str]) -> list[str]:
    """Filter a tick's events to the ones worth printing: a stuck delivery
    would otherwise log an identical 'waiting' line every 0.5s. Delivery
    events (starting with '#<id>') print only when their text differs from
    the last print for that delivery id; non-delivery events always print."""
    out = []
    for event in events:
        key = event.split(" ", 1)[0] if event.startswith("#") else None
        if key is not None:
            if seen.get(key) == event:
                continue
            seen[key] = event
        out.append(event)
    return out


def relay_lock(lock_fd) -> bool:
    """Take the relay's single-instance lock without blocking: POSIX flock on
    the open lock file, or a one-byte msvcrt.locking region on Windows (the
    file is kept non-empty so the region exists). False when another relay
    already holds it."""
    try:
        if fcntl is not None:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        elif msvcrt is not None:
            lock_fd.seek(0)
            if lock_fd.read(1) == "":
                lock_fd.write("1")
                lock_fd.flush()
            lock_fd.seek(0)  # lock byte 0 regardless of the read position
            msvcrt.locking(lock_fd.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            raise SystemExit("radio relay: no file locking on this platform")
        return True
    except OSError:
        return False


def cmd_relay(args: argparse.Namespace) -> int:
    """Run the delivery relay daemon: single instance via relay_lock, ticking
    relay_tick on the interval, re-execing itself when the script changes on
    disk so a deploy never leaves stale code running."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    # Leave the plugin directory: a daemon whose cwd sits inside the managed
    # plugin dir blocks Herdr's install/update on Windows (sharing violation),
    # so every update would need the relay killed first.
    try:
        os.chdir(STATE_DIR)
    except OSError:
        pass
    # 'a+', not 'w': Windows refuses to truncate a file whose bytes another
    # process holds locked, so the second relay must open without truncating.
    lock_fd = open(LOCK_PATH, "a+")
    if not relay_lock(lock_fd):
        print("radio relay already running (lock held)", file=sys.stderr)
        return 1
    print(f"radio relay · db: {DB_PATH} · interval {args.interval}s")
    script = str(Path(__file__).resolve())
    started_mtime = Path(script).stat().st_mtime
    seen: dict[str, str] = {}
    while True:
        with closing(connect()) as conn:
            try:
                events = relay_tick(conn)
            except Exception as exc:
                # One bad tick (DB locked past timeout, a herdr hiccup
                # escaping the wrappers, a bug) must not kill the daemon —
                # autostart only respawns on herdr restart. KeyboardInterrupt
                # and SystemExit still propagate.
                print(f"[{now()}] relay tick error: {exc}", flush=True)
                events = []
            for event in changed_events(events, seen):
                print(f"[{now()}] {event}", flush=True)
        time.sleep(args.interval)
        if Path(script).stat().st_mtime != started_mtime:
            # A deploy swapped the binary; re-exec so the daemon never runs
            # stale code. The flock fd closes on exec, the new image relocks.
            print("radio changed on disk; restarting relay", flush=True)
            os.execv(sys.executable, [sys.executable, script, "relay",
                                      "--interval", str(args.interval)])


def build_parser() -> argparse.ArgumentParser:
    """The CLI parser: one subcommand per ledger operation, plus relay/view."""
    parser = argparse.ArgumentParser(prog="radio", description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("join", help="register this pane/session as a handle")
    p.add_argument("handle", nargs="?", help="defaults to the current pane label")
    p.add_argument("--pane", help="join a pane from outside (e.g. w1:p5)")
    p.add_argument("--provider", choices=PROVIDERS, help="agent provider to launch")
    p.add_argument("--new", action="store_true", help="start a new session without asking")
    p.add_argument("--resume", action="store_true", help="resume the named session without asking")
    p.add_argument("--model", help="opencode: model to run (e.g. opencode/deepseek-v4-flash); "
                                   "written into the per-handle config file")
    p.add_argument("--role", help="role paragraph for this handle; carried in the briefing and "
                                  "editable later with `radio role` (\"\" clears it)")
    p.add_argument("--no-launch", action="store_true", help="register only, never launch an agent")

    p = sub.add_parser("part", help="remove a handle")
    p.add_argument("handle")

    p = sub.add_parser("pm", help="direct message a handle")
    p.add_argument("to")
    p.add_argument("text", nargs="+")
    p.add_argument("--from", dest="sender")
    p.add_argument("--ref", help="file reference carrying the payload — keep the "
                                 "message short, the recipient reads the file")
    p.add_argument("--reply-required", action="store_true",
                   help="mark the message as requiring a reply")

    p = sub.add_parser("handles", help="list joined handles")
    p.add_argument("workspace", nargs="?", help="workspace id or label to list; inside a pane "
                                                "the roster always shows this workspace only")

    p = sub.add_parser("role", help="show, set, or clear a handle's role paragraph")
    p.add_argument("handle")
    p.add_argument("text", nargs="*", help="the role paragraph; omitted, the current role prints")
    p.add_argument("--clear", action="store_true", help="remove the role")

    p = sub.add_parser("briefing", help=argparse.SUPPRESS)  # used by provider hooks
    p.add_argument("handle")

    p = sub.add_parser("log", help="recent messages")
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("inbox", help="metadata index of incoming messages "
                                     "(bodies via `radio show <id>`)")
    p.add_argument("handle", nargs="?", help="defaults to this pane's handle / $RADIO_HANDLE")
    p.add_argument("--status", choices=("all", "pending", "delivered", "pull", "failed"),
                   default="all", help="filter by delivery state; default: all")
    p.add_argument("--limit", type=int, default=10, help="number of entries (default: 10)")

    p = sub.add_parser("show", help="print one message body by id")
    p.add_argument("message_id", type=int)
    p.add_argument("--by", help="reader handle; reading as the recipient records delivery")

    p = sub.add_parser("relay", help="run the delivery relay daemon")
    p.add_argument("--interval", type=float, default=0.5)

    p = sub.add_parser("repair", help="diagnose the ledger, or --reset it (a backup is kept)")
    p.add_argument("--reset", action="store_true",
                   help="replace the ledger with a fresh empty one; the old files stay as backups")
    p.add_argument("--yes", action="store_true", help="skip the confirmation prompt")

    sub.add_parser("view", help="live roster + message stream TUI")
    return parser


def relay_running() -> bool:
    """True when the relay daemon holds its lock (probe only: a lock this
    probe takes is released immediately)."""
    if not LOCK_PATH.exists():
        return False
    fd = open(LOCK_PATH, "a+")
    try:
        return not relay_lock(fd)
    finally:
        fd.close()


def cmd_repair(args: argparse.Namespace) -> int:
    """Diagnose the ledger (default) or replace it with a fresh one (--reset).
    Repair is the supported way out of a broken state — a corrupt database, a
    ledger written by a newer radio, or a half-applied migration. --reset
    snapshots the old ledger beside it first, so nothing is destroyed."""
    if args.reset:
        return repair_reset(args)
    return repair_check()


def repair_check() -> int:
    """Print a short ledger health report; exit 1 when --reset is warranted."""
    problems: list[str] = []
    counts = {"handles": 0, "messages": 0, "deliveries": 0}
    integrity = "unreadable"
    version = -1
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as conn:
            version = int(conn.execute("PRAGMA user_version").fetchone()[0])
            integrity = str(conn.execute("PRAGMA integrity_check").fetchone()[0])
            for table in counts:
                try:
                    counts[table] = int(
                        conn.execute(f"SELECT COUNT(*) AS c FROM {table}").fetchone()[0]
                    )
                except sqlite3.Error:
                    problems.append(f"table unreadable: {table}")
    except sqlite3.Error as exc:
        problems.append(f"cannot open the ledger: {exc}")
    if version > SCHEMA_VERSION:
        problems.append(
            f"ledger schema {version} is newer than this radio ({SCHEMA_VERSION})"
        )
    if integrity != "ok":
        problems.append(f"integrity check: {integrity}")
    print(f"ledger:    {DB_PATH}")
    print(f"schema:    {version if version >= 0 else '?'} (this radio: {SCHEMA_VERSION})")
    print(f"integrity: {integrity}")
    print(
        f"handles: {counts['handles']} · messages: {counts['messages']} · "
        f"deliveries: {counts['deliveries']}"
    )
    print(f"relay:     {'running' if relay_running() else 'not running'}")
    if problems:
        for problem in problems:
            print(f"problem:   {problem}")
        print("recover:   radio repair --reset   (keeps a backup beside the ledger)")
        return 1
    print("verdict:   healthy")
    return 0


def repair_reset(args: argparse.Namespace) -> int:
    """Snapshot the ledger and rebuild an empty schema. The snapshot uses
    SQLite's online backup API, so a running relay cannot corrupt it; when the
    tables cannot be dropped (corrupt database), the files are moved aside
    instead. Data is never deleted without a backup beside it."""
    if not args.yes:
        if not sys.stdin.isatty():
            raise SystemExit("radio repair --reset needs --yes when not interactive")
        answer = input(
            f"Replace {DB_PATH} with an empty ledger? A backup is kept beside it. [y/N] "
        )
        if answer.strip().lower() not in ("y", "yes"):
            print("cancelled")
            return 0
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    backup = DB_PATH.with_name(f"{DB_PATH.name}.bak-{stamp}")
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as src, closing(
            sqlite3.connect(backup, timeout=10)
        ) as dst:
            src.backup(dst)
        print(f"backup:    {backup}")
    except sqlite3.Error as exc:
        print(f"backup:    failed ({exc}) — the old files are kept as-is")
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as conn:
            for table in ("deliveries", "messages", "handles"):
                conn.execute(f"DROP TABLE IF EXISTS {table}")
            # The version marker lives in the file header, not the tables: a
            # newer-schema ledger must lose it too, or connect() refuses again.
            conn.execute("PRAGMA user_version = 0")
            conn.commit()
    except sqlite3.Error:
        # Corrupt database: move the files aside and start over.
        for suffix in ("", "-wal", "-shm"):
            path = Path(str(DB_PATH) + suffix)
            if path.exists():
                path.rename(Path(f"{path}.bak-{stamp}"))
    with closing(connect()):
        pass  # rebuilds the schema and stamps the current version
    print(f"fresh:     {DB_PATH}")
    return 0


def cmd_briefing(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the opening briefing for a handle. Single source of truth: the
    launch flags (claude/codex) and provider hooks (kimi/gemini) all render
    this; workspace and role come from the ledger when the handle is joined,
    so a resumed agent re-learns both."""
    scope = current_workspace()
    row = resolve_handle(conn, args.handle, scope)
    if row:
        print(briefing_text(row["name"], row["workspace"], row["role"]))
    else:
        workspace, name = parse_handle(args.handle)
        print(briefing_text(name, workspace or scope, None))
    return 0


def main() -> int:
    """Dispatch argv: bare `radio` opens the view on a tty (prints help in
    scripts); relay/view never open the ledger, everything else does."""
    args = build_parser().parse_args()
    if args.command is None:
        # Bare `radio` in a terminal opens the view; in scripts, print help.
        if sys.stdout.isatty():
            return cmd_view(args)
        build_parser().print_help()
        return 0
    if args.command == "relay":
        return cmd_relay(args)
    if args.command == "view":
        return cmd_view(args)
    if args.command == "repair":
        return cmd_repair(args)
    with closing(connect()) as conn:
        handler = {
            "join": cmd_join,
            "part": cmd_part,
            "pm": cmd_pm,
            "handles": cmd_handles,
            "role": cmd_role,
            "briefing": cmd_briefing,
            "log": cmd_log,
            "inbox": cmd_inbox,
            "show": cmd_show,
        }[args.command]
        return handler(conn, args)


if __name__ == "__main__":
    raise SystemExit(main())
