#!/usr/bin/env python3
"""Radio — local message bus for agents running in Herdr panes.

A single-file, stdlib-only CLI. State lives in a SQLite ledger under the
plugin state dir (when running as a Herdr plugin command), $RADIO_HOME, or
~/.local/share/herdr-radio. Delivery to panes goes through the Herdr CLI.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import random
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from contextlib import closing
from datetime import datetime, timedelta, timezone
from pathlib import Path

try:  # POSIX only: the relay's flock and the raw-key menu.
    import fcntl
    import termios
    import tty
except ImportError:  # Windows: see relay_lock and choose_plain for the fallbacks.
    fcntl = termios = tty = None
try:  # Windows only: byte-range file lock, the relay's single-instance primitive.
    import msvcrt
except ImportError:
    msvcrt = None
try:  # POSIX only: the calm animation's terminal control.
    import curses
except ImportError:  # Windows: `radio tools calm` reports it is unavailable.
    curses = None

# Split timeouts: one wedged herdr must not stall the relay daemon — a
# read-only pane lookup gets 2s, a real delivery (agent prompt / send-text /
# send-keys) gets 7s. (Was a single 15s constant covering both.)
HERDR_READ_TIMEOUT = 2
HERDR_SEND_TIMEOUT = 7
MAX_DELIVERY_ATTEMPTS = 5
RETRY_AFTER_S = 30.0
FOCUS_HOLD_S = 30.0          # hold pushes to a focused pane; after this, ask the composer
COMPOSER_CHECK_INTERVAL_S = 3.0  # how often the visible composer may be re-read per pane
VERSION = "0.6.0"  # keep in sync with herdr-plugin.toml
SCHEMA_VERSION = 2  # Named frequencies separate logical scope from physical pane workspace.

# Provider usage: each provider's own quota endpoint is read here, in Python,
# from that provider's own credential files — the plugin depends on no other
# tool. One local cache bounds the cost to at most one read per account per TTL
# window, shared by every caller through a lock, so a ticker or several panes
# can never poll a provider or trip its rate limit.
USAGE_CACHE_TTL_S = 600.0
USAGE_HTTP_TIMEOUT_S = 12.0
USAGE_MAX_BODY_BYTES = 512 * 1024
CODEX_USAGE_ENDPOINT = "https://chatgpt.com/backend-api/codex/usage"
CLAUDE_USAGE_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
KIMI_OAUTH_CLIENT_ID = "17e5f671-d194-4dfb-9706-5516cb48c098"
KIMI_DEFAULT_OAUTH_KEY = "oauth/kimi-code"
KIMI_MAINLAND_OAUTH_HOST = "https://auth.kimi.com"
KIMI_MAINLAND_BASE_URL = "https://api.kimi.com/coding/v1"
KIMI_GLOBAL_OAUTH_HOST = "https://auth.kimi.ai"
KIMI_GLOBAL_BASE_URL = "https://api.kimi.ai/coding/v1"


def state_dir() -> Path:
    """The one well-known ledger dir per machine: $RADIO_HOME, else
    ~/.local/share/herdr-radio. HERDR_PLUGIN_STATE_DIR is deliberately NOT
    used: the CLI runs from arbitrary panes and shells that never carry
    plugin env, so the ledger must resolve to the same path everywhere."""
    override = os.environ.get("RADIO_HOME")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".local" / "share" / "herdr-radio"


STATE_DIR = state_dir()
DB_PATH = STATE_DIR / "radio.db"
LOCK_PATH = STATE_DIR / "relay.lock"

SCHEMA = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS handles(
  workspace TEXT NOT NULL DEFAULT '',     -- logical scope: workspace id or freq.<name>
  pane_workspace TEXT NOT NULL DEFAULT '', -- physical Herdr location, never a frequency
  name TEXT NOT NULL,
  session_ref TEXT NOT NULL DEFAULT 'manual',
  kind TEXT NOT NULL DEFAULT 'terminal',
  agent TEXT,
  agent_session TEXT,
  briefed_at TEXT,
  role TEXT,                              -- free-form role paragraph, carried in the briefing
  created_at TEXT NOT NULL,
  last_seen TEXT NOT NULL,
  PRIMARY KEY (workspace, name)
);
CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name);
CREATE TABLE IF NOT EXISTS accounts(
  name TEXT PRIMARY KEY,
  provider TEXT NOT NULL,
  home TEXT,                       -- config dir; NULL uses the provider's default home
  env TEXT NOT NULL DEFAULT '{}',  -- JSON: extra environment applied at launch
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS messages(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts TEXT NOT NULL,
  kind TEXT NOT NULL,            -- pm
  from_ws TEXT NOT NULL DEFAULT '',
  from_handle TEXT NOT NULL,
  to_ws TEXT NOT NULL DEFAULT '',
  to_handle TEXT,                -- pm target
  text TEXT NOT NULL,
  ref TEXT,                      -- file reference (payload stays out of the message)
  reply_required INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS deliveries(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  message_id INTEGER NOT NULL REFERENCES messages(id),
  target_ws TEXT NOT NULL DEFAULT '',
  target TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'pending',  -- pending|delivered|pull|failed
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  focus_hold_since TEXT,         -- when the relay began deferring for pane focus
  created_at TEXT NOT NULL,
  delivered_at TEXT
);
"""


def now() -> str:
    """Current UTC time in ISO-8601 millis — the ledger's only time format."""
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def connect() -> sqlite3.Connection:
    """Open the SQLite ledger (creating it and the schema as needed), apply
    any pending migrations, and return a Row-factory connection. A ledger
    written by a newer radio is refused with a clear message instead of a
    traceback; `radio repair --reset` is the way out."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    version = int(conn.execute("PRAGMA user_version").fetchone()[0])
    if version > SCHEMA_VERSION:
        conn.close()
        raise SystemExit(
            f"this ledger was written by a newer radio (schema {version}, this build "
            f"knows {SCHEMA_VERSION}); update the plugin, or run "
            "`radio repair --reset` to start from an empty ledger"
        )
    if version < 2 and conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='handles'"
    ).fetchone():
        backup = STATE_DIR / f"radio.pre-frequencies-{uuid.uuid4().hex[:12]}.db"
        with closing(sqlite3.connect(backup)) as snapshot:
            conn.backup(snapshot)
    conn.executescript(SCHEMA)
    cols = {r["name"] for r in conn.execute("PRAGMA table_info(handles)").fetchall()}
    # Pre-scope ledgers first: the rebuild below copies these columns, so they
    # must exist before it runs.
    for column in ("agent", "agent_session", "briefed_at"):
        if column not in cols:
            conn.execute(f"ALTER TABLE handles ADD COLUMN {column} TEXT")
    if "workspace" not in cols:
        # SQLite cannot alter a primary key: rebuild the table for the scoped
        # identity (workspace, name). Existing rows predate scoping and remain
        # reachable as the unscoped ('') namespace.
        conn.executescript(
            """
            CREATE TABLE handles_scoped(
              workspace TEXT NOT NULL DEFAULT '',
              name TEXT NOT NULL,
              session_ref TEXT NOT NULL DEFAULT 'manual',
              kind TEXT NOT NULL DEFAULT 'terminal',
              agent TEXT,
              agent_session TEXT,
              briefed_at TEXT,
              role TEXT,
              account TEXT,
              created_at TEXT NOT NULL,
              last_seen TEXT NOT NULL,
              PRIMARY KEY (workspace, name)
            );
            INSERT INTO handles_scoped(workspace, name, session_ref, kind, agent, agent_session, briefed_at, created_at, last_seen)
              SELECT '', name, session_ref, kind, agent, agent_session, briefed_at, created_at, last_seen FROM handles;
            DROP TABLE handles;
            ALTER TABLE handles_scoped RENAME TO handles;
            CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name);
            """
        )
    # Columns added after the scoped rebuild (and to scoped ledgers written by
    # earlier 0.3.x builds): add whatever is missing.
    cols = {r["name"] for r in conn.execute("PRAGMA table_info(handles)").fetchall()}
    for column in ("role", "account"):
        if column not in cols:
            conn.execute(f"ALTER TABLE handles ADD COLUMN {column} TEXT")
    if "pane_workspace" not in cols:
        conn.commit()
        conn.execute("BEGIN IMMEDIATE")
        # The relay and CLI may open an old ledger together on first use.
        # Another opener can finish this migration while we wait for the lock.
        cols = {r["name"] for r in conn.execute("PRAGMA table_info(handles)")}
        if "pane_workspace" not in cols:
            conn.execute("ALTER TABLE handles ADD COLUMN pane_workspace TEXT NOT NULL DEFAULT ''")
            conn.execute("UPDATE handles SET pane_workspace=workspace")
    msg_cols = {r["name"] for r in conn.execute("PRAGMA table_info(messages)").fetchall()}
    for column, ddl in (
        ("reply_required", "ALTER TABLE messages ADD COLUMN reply_required INTEGER NOT NULL DEFAULT 0"),
        ("from_ws", "ALTER TABLE messages ADD COLUMN from_ws TEXT NOT NULL DEFAULT ''"),
        ("to_ws", "ALTER TABLE messages ADD COLUMN to_ws TEXT NOT NULL DEFAULT ''"),
    ):
        if column not in msg_cols:
            conn.execute(ddl)
    del_cols = {r["name"] for r in conn.execute("PRAGMA table_info(deliveries)").fetchall()}
    for column, ddl in (
        ("last_attempt_at", "ALTER TABLE deliveries ADD COLUMN last_attempt_at TEXT"),
        ("target_ws", "ALTER TABLE deliveries ADD COLUMN target_ws TEXT NOT NULL DEFAULT ''"),
        ("focus_hold_since", "ALTER TABLE deliveries ADD COLUMN focus_hold_since TEXT"),
    ):
        if column not in del_cols:
            conn.execute(ddl)
    # Accounts: the first cut stored a single dir; the model is home + env
    # overrides now. Rename/add columns so both shapes converge.
    acct_cols = {r["name"] for r in conn.execute("PRAGMA table_info(accounts)").fetchall()}
    if "dir" in acct_cols and "home" not in acct_cols:
        conn.execute("ALTER TABLE accounts RENAME COLUMN dir TO home")
        acct_cols = {r["name"] for r in conn.execute("PRAGMA table_info(accounts)").fetchall()}
    for column, ddl in (
        ("home", "ALTER TABLE accounts ADD COLUMN home TEXT"),
        ("env", "ALTER TABLE accounts ADD COLUMN env TEXT NOT NULL DEFAULT '{}'"),
    ):
        if column not in acct_cols:
            conn.execute(ddl)
    # Indexes last: on a pre-scope ledger the columns they reference only
    # exist after the migrations above. idx_deliveries_scope is a new name so
    # an old (target, status) index under the same table is left untouched.
    conn.execute("CREATE INDEX IF NOT EXISTS idx_handles_name ON handles(name)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_deliveries_status ON deliveries(status)")
    conn.execute(
        "CREATE INDEX IF NOT EXISTS idx_deliveries_scope ON deliveries(target_ws, target, status)"
    )
    conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
    conn.commit()
    return conn


def herdr_bin() -> str:
    """Path to the herdr CLI: $HERDR_BIN_PATH, else PATH lookup, else the bare name."""
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"


def herdr(*args: str, timeout: float = HERDR_READ_TIMEOUT) -> subprocess.CompletedProcess[str]:
    """Run one herdr CLI invocation with captured output. Read-only lookups
    take the short read timeout (default); delivery paths pass the send
    timeout explicitly — one wedged herdr must not stall the relay. Output is
    decoded as UTF-8 (herdr's own encoding): the Windows locale codec cannot
    represent the box/prompt glyphs in pane reads."""
    return subprocess.run(
        [herdr_bin(), *args],
        text=True,
        capture_output=True,
        timeout=timeout,
        encoding="utf-8",
        errors="replace",
        # A detached Windows relay must not open a console for each lookup.
        creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0,
    )


def herdr_json(*args: str) -> dict | None:
    """Run herdr and parse stdout as JSON; None on any failure (missing
    binary, timeout, nonzero exit, or undecodable output)."""
    try:
        result = herdr(*args)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def fetch_pane(pane_id: str) -> dict | None:
    """Live pane record from herdr, or None when the pane is gone or herdr is unreachable."""
    data = herdr_json("pane", "get", pane_id)
    if not data:
        return None
    return data.get("result", {}).get("pane")


def current_session_ref() -> str:
    """This process's own binding: 'herdr:<pane-id>' inside a Herdr pane, else 'manual'."""
    if os.environ.get("HERDR_ENV") == "1" and os.environ.get("HERDR_PANE_ID"):
        return f"herdr:{os.environ['HERDR_PANE_ID']}"
    return "manual"


def pane_id_of(session_ref: str) -> str | None:
    """Pane id carried by a 'herdr:' session ref; None for manual refs."""
    if session_ref.startswith("herdr:"):
        return session_ref.removeprefix("herdr:")
    return None


def pane_exists(pane_id: str) -> bool:
    """True when herdr still knows this pane; False on any lookup failure."""
    try:
        return herdr("pane", "get", pane_id).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


SHELL_METACHARACTERS = "\\;|&<>()$`!\"'"


def shell_safe_text(text: str) -> str:
    """Escape what would let a plain shell execute or redirect typed text.

    The escape character differs by platform — backslash on POSIX shells,
    backtick in PowerShell — so the same message stays inert on both. cmd.exe
    quoting cannot be satisfied by one shared escape: Windows panes default to
    PowerShell and cmd panes are preview."""
    escape = "`" if os.name == "nt" else "\\"
    return "".join(
        f"{escape}{char}" if char in SHELL_METACHARACTERS else char for char in text
    )


def push_to_pane(pane_id: str, text: str) -> tuple[bool, str | None]:
    """Deliver one line into a pane. Agent panes get a verified submission
    (--wait: herdr confirms the agent actually started working, so a 'success'
    can no longer mean text stranded in the composer); plain shells get literal
    text + Enter. Error contract for callers: 'agent_blocked' means nothing was
    submitted (safe to retry next tick); 'delivery_unconfirmed' means the
    submission state is UNKNOWN — never resubmit, a retry may duplicate."""
    try:
        prompted = herdr(
            "agent", "prompt", pane_id, text,
            "--wait", "--until", "working", "--until", "blocked",
            "--timeout", "6000",
            timeout=HERDR_SEND_TIMEOUT,
        )
        if prompted.returncode == 0:
            return True, None
        prompt_err = (prompted.stderr or prompted.stdout or "").strip()
        if "blocked" in prompt_err:
            # A modal dialog is up — never fall back to raw typing, the text
            # would land in the dialog. Caller defers and retries next tick.
            return False, "agent_blocked"
        if "stalled" in prompt_err or "timeout" in prompt_err:
            # --wait watches agent lifecycle state AFTER submission, so a
            # timeout can mean the prompt was already delivered. The state is
            # unknowable from here — the caller must not resubmit (duplicate
            # risk) and must not blind-type (composer stranding).
            return False, "delivery_unconfirmed"
        # Not an agent pane: type into the shell. Flatten newlines — an
        # embedded newline submits the line early and drops the rest — and
        # escape shell metacharacters, so a message can never execute or
        # redirect anything in the pane it lands in.
        flat = " ".join(text.splitlines())
        typed = herdr("pane", "send-text", pane_id, shell_safe_text(flat), timeout=HERDR_SEND_TIMEOUT)
        if typed.returncode != 0:
            err = (prompt_err or typed.stderr or typed.stdout).strip()
            return False, err or "pane rejected delivery"
        time.sleep(0.4)  # let the paste land before Enter
        entered = herdr("pane", "send-keys", pane_id, "enter", timeout=HERDR_SEND_TIMEOUT)
        if entered.returncode != 0:
            return False, (entered.stderr or "enter key rejected").strip()
        return True, None
    except subprocess.TimeoutExpired:
        # The submission state is unknowable: herdr may have delivered the
        # prompt before the timeout. Never let the caller resubmit.
        return False, "delivery_unconfirmed"
    except OSError as exc:
        return False, str(exc)


def current_workspace() -> str:
    """This command's project scope: the herdr workspace id inside a pane,
    else '' (outside herdr — the unscoped namespace)."""
    if os.environ.get("HERDR_ENV") == "1":
        return os.environ.get("HERDR_WORKSPACE_ID", "")
    return ""


FREQUENCY_PREFIX = "freq."


def frequency_scope(name: str) -> str:
    """A reserved logical namespace; never a Herdr workspace identifier."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", name):
        raise SystemExit("invalid frequency: use 1-64 letters, digits, hyphens or underscores")
    return FREQUENCY_PREFIX + name.lower()


def is_frequency(scope: str) -> bool:
    """Whether a logical scope is an opt-in named frequency."""
    return scope.startswith(FREQUENCY_PREFIX)


def scope_workspace(handle) -> str:
    """Actual pane location; old/default rows may omit the new column."""
    physical = handle["pane_workspace"] if "pane_workspace" in handle.keys() else ""
    return physical or ("" if is_frequency(handle["workspace"]) else handle["workspace"])


def pane_label(name: str, scope: str) -> str:
    """Disambiguate named-frequency members without changing default labels."""
    return f"{name}@{scope.removeprefix(FREQUENCY_PREFIX)}" if is_frequency(scope) else name


def binding_for_pane(conn: sqlite3.Connection, ref: str, workspace: str):
    """Resolve membership; recover legacy default aliases only from a live label."""
    if ref == "manual":
        return None
    rows = conn.execute("SELECT * FROM handles WHERE session_ref = ?", (ref,)).fetchall()
    if len(rows) > 1:
        # Older default-workspace joins could leave aliases pointing at one
        # pane. Its live label identifies the current one; the next join
        # detaches the old aliases. Never guess among named-frequency bindings.
        if not any(is_frequency(row["workspace"]) for row in rows):
            pane = fetch_pane(pane_id_of(ref))
            if pane and pane.get("workspace_id") == workspace:
                rows = [row for row in rows
                        if (row["name"].casefold() == (pane.get("label") or "").casefold()
                            and (not scope_workspace(row) or scope_workspace(row) == workspace))]
        if len(rows) != 1:
            raise SystemExit("pane has multiple Radio bindings; reconcile them before continuing")
    if not rows:
        return None
    row = rows[0]
    if scope_workspace(row) and scope_workspace(row) != workspace:
        raise SystemExit("pane workspace changed; rejoin from its current workspace")
    return row


def pane_binding(conn: sqlite3.Connection):
    """Find the caller's ledger membership using its physical Herdr pane."""
    return binding_for_pane(conn, current_session_ref(), current_workspace())


def current_scope(conn: sqlite3.Connection) -> str:
    """Membership is authoritative; environment variables cannot retune a pane."""
    bound = pane_binding(conn)
    scope = bound["workspace"] if bound else current_workspace()
    expected = os.environ.get("RADIO_JOINED_SCOPE")
    if expected is not None and expected != scope and (is_frequency(expected) or is_frequency(scope)):
        raise SystemExit("this agent's Radio membership changed; exit and join a fresh session")
    return scope


def check_scope_access(caller: str, target: str) -> None:
    """Keep named traffic inside its frequency while preserving default PMs."""
    if caller != target and (is_frequency(caller) or is_frequency(target)):
        raise SystemExit("target is outside this frequency; join that frequency in a separate agent session")


def cmd_frequency(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Display the caller's default workspace number or explicit frequency."""
    scope = current_scope(conn)
    if is_frequency(scope):
        print(f"frequency: {scope.removeprefix(FREQUENCY_PREFIX)} (advanced)")
    elif scope:
        match = re.fullmatch(r"w([0-9]+)", scope)
        number = str(int(match.group(1))).zfill(3) if match else scope
        print(f"frequency: {number} · workspace {workspace_display(scope)} (default)")
    else:
        print("frequency: none (open a Herdr workspace)")
    return 0


def identity(workspace: str, name: str) -> str:
    """The internal qualified form used in relay events and cross-scope
    envelopes: 'w1:alice' for scoped handles, the bare name for unscoped."""
    return f"{workspace}:{name}" if workspace else name


def workspace_labels() -> dict[str, str]:
    """Live workspace id → label map from herdr; empty when herdr is
    unreachable (callers fall back to bare ids)."""
    data = herdr_json("workspace", "list")
    if not data:
        return {}
    labels: dict[str, str] = {}
    for ws in data.get("result", {}).get("workspaces", []):
        if ws.get("workspace_id"):
            labels[str(ws["workspace_id"])] = str(ws.get("label") or "")
    return labels


def workspace_display(workspace: str, labels: dict[str, str] | None = None) -> str:
    """'w2 · Servers' for humans; the bare id when the label is unknown, and
    'no workspace' for the unscoped namespace."""
    if is_frequency(workspace):
        return f"frequency {workspace.removeprefix(FREQUENCY_PREFIX)}"
    if not workspace:
        return "no workspace"
    labels = workspace_labels() if labels is None else labels
    label = labels.get(workspace)
    return f"{workspace} · {label}" if label else workspace


def workspace_label(workspace: str) -> str:
    """The live label for a workspace id, or the id itself when herdr cannot
    answer — briefing and error paths must never depend on herdr."""
    return workspace_display(workspace) if is_frequency(workspace) else workspace_labels().get(workspace) or workspace


def resolve_workspace_spec(spec: str, conn: sqlite3.Connection | None = None) -> str:
    """Resolve a workspace id or label typed by a human into a workspace id:
    exact id first, then a unique case-insensitive label, then ids known in
    the ledger when herdr cannot answer. Unknown is a SystemExit naming the
    known workspaces."""
    if not spec:
        return ""
    labels = workspace_labels()
    if spec in labels:
        return spec
    matches = [ws for ws, label in labels.items() if label.casefold() == spec.casefold()]
    if len(matches) == 1:
        return matches[0]
    known = set(labels)
    if conn is not None:
        known |= {
            r["workspace"]
            for r in conn.execute("SELECT DISTINCT workspace FROM handles").fetchall()
            if r["workspace"]
        }
    if spec in known:
        return spec
    shown = ", ".join(sorted(workspace_display(ws, labels) for ws in known)) or "none"
    raise SystemExit(f"unknown workspace: {spec} (known: {shown})")


def resolve_identity(conn: sqlite3.Connection, explicit: str | None,
                     what: str = "handle") -> tuple[str, str]:
    """(workspace, name) for who is asking: the explicit argument (bare, or the
    internal 'w1:alice' form), else $RADIO_HANDLE, else the handle bound to
    this pane. An unregistered explicit name passes through with the caller's
    scope so reads simply match nothing."""
    scope = current_scope(conn)
    bound = pane_binding(conn)
    if bound and is_frequency(scope):
        requested = explicit or os.environ.get("RADIO_HANDLE")
        if requested:
            requested_scope, requested_name = parse_handle(requested)
            check_scope_access(scope, requested_scope or scope)
            if requested_name.casefold() != bound["name"].casefold():
                raise SystemExit("sender/reader must match this pane's frequency membership")
        return scope, bound["name"]
    if explicit:
        row = resolve_handle(conn, explicit, scope)
        if row:
            return row["workspace"], row["name"]
        workspace, name = parse_handle(explicit)
        return workspace or scope, name
    env = os.environ.get("RADIO_HANDLE")
    if env:
        row = resolve_handle(conn, env, scope)
        if row:
            return row["workspace"], row["name"]
        return scope, normalize_handle(env)
    if bound:
        return bound["workspace"], bound["name"]
    raise SystemExit(
        f"{what} unknown: pass it explicitly, set RADIO_HANDLE, or join from this pane"
    )


HANDLE_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def normalize_handle(name: str) -> str:
    """Strip one leading '@' (agents naturally write `radio pm @foo`) and
    validate the charset. Anything outside [A-Za-z0-9_.-] is rejected:
    spaces or ']' would corrupt the [RADIO_MESSAGE from=...] header and the
    pane rename."""
    name = name.removeprefix("@")
    if not HANDLE_RE.match(name):
        raise SystemExit(f"invalid handle: {name!r} (allowed: letters, digits, _ . -)")
    return name


def parse_handle(spec: str) -> tuple[str, str]:
    """Split a handle reference into (workspace, name). 'w1:alice' names a
    workspace explicitly — the internal form scripts use from outside herdr;
    a bare name returns workspace '', i.e. 'resolve in my own scope'."""
    workspace, sep, name = spec.partition(":")
    if not sep:
        return "", normalize_handle(spec)
    return normalize_handle(workspace), normalize_handle(name)


def _match_in_workspace(conn: sqlite3.Connection, workspace: str,
                        name: str) -> sqlite3.Row | None:
    """One row by (workspace, name): exact spelling first, then a unique
    case-insensitive variant. Several spellings differing only by case are a
    SystemExit naming them (the pre-scope behavior); none returns None."""
    row = conn.execute(
        "SELECT * FROM handles WHERE workspace = ? AND name = ?", (workspace, name)
    ).fetchone()
    if row:
        return row
    rows = conn.execute(
        "SELECT * FROM handles WHERE workspace = ? AND LOWER(name) = LOWER(?)",
        (workspace, name),
    ).fetchall()
    if not rows:
        return None
    if len(rows) > 1:
        names = ", ".join(sorted(r["name"] for r in rows))
        raise SystemExit(f"ambiguous handle: {name!r} matches {names} — part one first")
    return rows[0]


def resolve_handle(conn: sqlite3.Connection, spec: str,
                   scope: str = "") -> sqlite3.Row | None:
    """Resolve a handle reference to its ledger row, honoring project scope.

    - `w1:alice` (internal form): exactly that workspace's handle.
    - bare name with a scope: this workspace first, then the unscoped
      namespace (handles outside herdr, or rows that predate scoping). A
      handle registered in another workspace is deliberately NOT reachable.
    - bare name without a scope (outside herdr): the unscoped handle, else a
      single scoped match anywhere, else a SystemExit listing the candidates.
    """
    workspace, name = parse_handle(spec)
    if workspace:
        check_scope_access(scope, workspace)
        return _match_in_workspace(conn, workspace, name)
    if scope:
        if is_frequency(scope):
            return _match_in_workspace(conn, scope, name)
        return _match_in_workspace(conn, scope, name) or _match_in_workspace(conn, "", name)
    row = _match_in_workspace(conn, "", name)
    if row:
        return row
    rows = conn.execute(
        "SELECT * FROM handles WHERE LOWER(name) = LOWER(?) AND workspace NOT LIKE 'freq.%'", (name,)
    ).fetchall()
    if len(rows) > 1:
        names = ", ".join(sorted(identity(r["workspace"], r["name"]) for r in rows))
        raise SystemExit(f"ambiguous handle: {name!r} matches {names} — pass a workspace")
    return rows[0] if rows else None


def no_handle_message(conn: sqlite3.Connection, spec: str, scope: str) -> str:
    """The error text for an unresolved target. Inside a workspace the miss is
    explicit about the scope and, when the name exists elsewhere, says so
    without teaching cross-workspace addressing."""
    workspace, name = parse_handle(spec)
    if is_frequency(scope):
        return f'no handle "{name}" in this frequency ({scope.removeprefix(FREQUENCY_PREFIX)})'
    if workspace:
        return f'no handle "{name}" in workspace {workspace_display(workspace)}'
    if scope:
        message = f'no handle "{name}" in this workspace ({workspace_display(scope)})'
        rows = conn.execute(
            "SELECT DISTINCT workspace FROM handles "
            "WHERE LOWER(name) = LOWER(?) AND workspace != ? AND workspace != '' "
            "AND workspace NOT LIKE 'freq.%'",
            (name, scope),
        ).fetchall()
        if rows:
            labels = workspace_labels()
            others = ", ".join(sorted(workspace_display(r["workspace"], labels) for r in rows))
            message += f" — it exists in {others}, outside this workspace"
        return message
    return f"unknown handle: {name} (join first)"


def enqueue_delivery(conn: sqlite3.Connection, message_id: int, target: str,
                     target_ws: str = "") -> None:
    """Queue delivery of a message to a handle: 'pending' (relay pushes) when
    the target is bound to a pane, else 'pull' (recipient reads via inbox/show)."""
    row = conn.execute(
        "SELECT session_ref FROM handles WHERE workspace = ? AND name = ?",
        (target_ws, target),
    ).fetchone()
    has_pane = bool(row and pane_id_of(row["session_ref"]))
    conn.execute(
        "INSERT INTO deliveries(message_id, target_ws, target, status, created_at) "
        "VALUES (?,?,?,?,?)",
        (message_id, target_ws, target, "pending" if has_pane else "pull", now()),
    )


# ------------------------------------------------------------ providers
# Provider-specific knowledge lives here only: how to probe auth, how to find
# a session named after a handle, and how to launch/resume. Radio itself only
# records the user's choice on the handle row.

PROVIDERS = ("claude", "codex", "kimi", "pi", "gemini", "qwen", "opencode")

# Named accounts: several logins of one provider on the same machine. Each
# account is a config home; launching with the account exports the provider's
# home variable so the agent runs that login (the harness convention this
# mirrors: codex2 -> ~/.codex-account-2 with CODEX_HOME).
ACCOUNT_ENV: dict[str, tuple[str, ...]] = {
    "codex": ("CODEX_HOME",),
    "claude": ("CLAUDE_CONFIG_DIR",),
    "kimi": ("KIMI_CODE_HOME", "KIMI_HOME"),
    "gemini": ("GEMINI_CLI_HOME",),
    "qwen": ("QWEN_HOME",),
    "pi": ("PI_CODING_AGENT_DIR",),
    "opencode": ("XDG_DATA_HOME",),
}
DEFAULT_HOMES: dict[str, str] = {
    "codex": "~/.codex",
    "claude": "~/.claude",
    "kimi": "~/.kimi-code",
    "gemini": "~/.gemini",
    "qwen": "~/.qwen",
    "pi": "~/.pi/agent",
    "opencode": "~/.local/share",
}


def default_account_home(provider: str, name: str) -> Path:
    """The conventional home for an account: the provider's default dir when
    the name is the provider itself, else ~/.<provider>-account-<suffix>.
    Only a default — `--home` and `--env` express anything else."""
    if name == provider:
        return Path(DEFAULT_HOMES[provider]).expanduser()
    suffix = name[len(provider):].lstrip("-_") if name.startswith(provider) else name
    return Path(f"~/.{provider}-account-{suffix}").expanduser()


def resolve_account(conn: sqlite3.Connection, name: str) -> sqlite3.Row | None:
    """The registered account row by name (exact, then case-insensitive)."""
    row = conn.execute("SELECT * FROM accounts WHERE name = ?", (name,)).fetchone()
    if row:
        return row
    rows = conn.execute(
        "SELECT * FROM accounts WHERE LOWER(name) = LOWER(?)", (name,)
    ).fetchall()
    if len(rows) == 1:
        return rows[0]
    return None


def account_home(account: sqlite3.Row) -> Path | None:
    """The account's config home, or None when it uses the provider default."""
    return Path(account["home"]).expanduser() if account["home"] else None


def account_env(account: sqlite3.Row) -> dict[str, str]:
    """Environment applied when launching this account: the provider's home
    variables pointed at the account home (when one is set), plus the account's
    own overrides — any variable, so unusual setups need no code change."""
    env: dict[str, str] = {}
    home = account_home(account)
    if home:
        for var in ACCOUNT_ENV.get(account["provider"], ()):
            env[var] = str(home)
    try:
        overrides = json.loads(account["env"] or "{}")
    except (TypeError, ValueError):
        overrides = {}
    if isinstance(overrides, dict):
        env.update({str(key): str(value) for key, value in overrides.items()})
    return env


def provider_home(provider: str, account: sqlite3.Row | None = None) -> Path:
    """The config home for a provider launch/session search: the account's home
    when one is set, else the provider's default home."""
    if account:
        home = account_home(account)
        if home:
            return home
    return Path(DEFAULT_HOMES.get(provider, "~")).expanduser()


def auth_status(provider: str, home: Path | None = None) -> str:
    """Human-readable auth state for a provider, probed from its on-disk
    credentials/config; `home` overrides the provider's default config dir
    (used by `radio account list`); 'auth unknown' without a known probe."""
    if provider == "claude":
        base = home or Path(os.environ.get("CLAUDE_CONFIG_DIR", DEFAULT_HOMES["claude"])).expanduser()
        if (base / ".credentials.json").exists():
            return "logged in"
        return f"not logged in — {base}/.credentials.json missing"
    if provider == "codex":
        base = home or Path(os.environ.get("CODEX_HOME", DEFAULT_HOMES["codex"])).expanduser()
        if (base / "auth.json").exists():
            return "logged in"
        return f"not logged in — {base}/auth.json missing"
    if provider == "kimi":
        base = home or Path(
            os.environ.get("KIMI_CODE_HOME")
            or os.environ.get("KIMI_HOME", DEFAULT_HOMES["kimi"])
        ).expanduser()
        if (base / "config.toml").exists():
            return "configured"
        return f"not configured — {base}/config.toml missing"
    if provider == "gemini":
        base = home or Path(os.environ.get("GEMINI_CLI_HOME", DEFAULT_HOMES["gemini"])).expanduser()
        if (base / "oauth_creds.json").exists():
            return "logged in"
        return f"not logged in — {base}/oauth_creds.json missing"
    if provider == "qwen":
        base = home or Path(os.environ.get("QWEN_HOME", DEFAULT_HOMES["qwen"])).expanduser()
        if (base / "oauth_creds.json").exists():
            return "logged in"
        return f"not logged in — {base}/oauth_creds.json missing"
    if provider == "opencode":
        base = home or Path(os.environ.get("XDG_DATA_HOME", DEFAULT_HOMES["opencode"])).expanduser()
        if (base / "opencode" / "auth.json").exists():
            return "logged in"
        return "not logged in — run `opencode auth login`"
    return "auth unknown"


def choose(question: str, options: list[str], default: int = 0) -> int | None:
    """Pick one option interactively. POSIX terminals get the arrow-key menu;
    platforms without termios (Windows) get the numbered line picker, so every
    interactive flow (provider pick, resume prompts) works there too. Returns
    the chosen index, or None if cancelled."""
    if termios is None:
        return choose_plain(question, options, default)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    idx = default
    drawn = 0

    def render() -> None:
        """Redraw the question and options in place: the cursor moves back over
        the previous block and clears below it, so the menu never scrolls."""
        nonlocal drawn
        if drawn:
            sys.stdout.write(f"\x1b[{drawn}A\x1b[J")  # up over the old block, clear it
        lines = [f"\x1b[1m{question}\x1b[0m"]
        for i, opt in enumerate(options):
            if i == idx:
                lines.append(f"  \x1b[36;1m❯ {opt}\x1b[0m")
            else:
                lines.append(f"    \x1b[2m{opt}\x1b[0m")
        lines.append("  \x1b[2m↑/↓ move · Enter select · q cancel\x1b[0m")
        sys.stdout.write("\n".join(lines) + "\n")
        sys.stdout.flush()
        drawn = len(lines)

    # TCSANOW, not the 3.13+ TCSAFLUSH default: typed-ahead input must survive.
    tty.setcbreak(fd, termios.TCSANOW)
    try:
        sys.stdout.write("\x1b[?25l")  # hide cursor while picking
        render()
        while True:
            ch = sys.stdin.read(1)
            if ch == "":  # stdin closed mid-pick
                return None
            if ch in ("\r", "\n"):
                return idx
            if ch in ("q", "Q", "\x03"):
                return None
            if ch == "\x1b":
                seq = sys.stdin.read(2)
                if seq == "[A" and idx > 0:
                    idx -= 1
                    render()
                elif seq == "[B" and idx < len(options) - 1:
                    idx += 1
                    render()
    except KeyboardInterrupt:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()


def choose_plain(question: str, options: list[str], default: int = 0) -> int | None:
    """Numbered, line-based menu for terminals without raw-key support
    (Windows). Enter takes the default, 'q' cancels, anything else re-prompts."""
    while True:
        sys.stdout.write(f"{question}\n")
        for i, opt in enumerate(options, start=1):
            mark = "*" if i - 1 == default else " "
            sys.stdout.write(f"  {mark} {i}) {opt}\n")
        sys.stdout.write(f"select 1-{len(options)} (Enter = {default + 1}, q = cancel): ")
        sys.stdout.flush()
        line = sys.stdin.readline()
        if line == "":  # stdin closed mid-pick
            return None
        answer = line.strip()
        if not answer:
            return default
        if answer in ("q", "Q"):
            return None
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer) - 1
        sys.stdout.write("invalid choice\n")


def _named(rows: list[dict]) -> dict | None:
    """The most recently updated row among named-session candidates (or None)."""
    best = None
    for row in rows:
        if best is None or (row.get("updated") or 0) >= (best.get("updated") or 0):
            best = row
    return best


def find_named_session(provider: str, handle: str, home: Path | None = None) -> dict | None:
    """Latest saved provider session whose name matches the handle, searched in
    the account's home when one is selected."""
    wanted = handle.casefold()
    if provider == "claude":
        # The sessions/ registry only lists live processes; the durable name is
        # the agent-name record inside the project transcript.
        base = home or Path(os.environ.get("CLAUDE_CONFIG_DIR", DEFAULT_HOMES["claude"])).expanduser()
        rows = []
        for path in (base / "projects").glob("*/*.jsonl"):
            name, sid, cwd = "", "", ""
            try:
                with path.open(encoding="utf-8") as fh:
                    for line in fh:
                        if "agent-name" not in line and '"cwd"' not in line:
                            continue
                        try:
                            row = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if not cwd and row.get("cwd"):
                            cwd = str(row["cwd"])
                        if row.get("type") == "agent-name" and row.get("agentName"):
                            name = str(row["agentName"])
                            sid = str(row.get("sessionId") or path.stem)
            except OSError:
                continue
            if sid and name.casefold() == wanted:
                rows.append({"id": sid, "cwd": cwd, "updated": path.stat().st_mtime})
        return _named(rows)
    if provider == "codex":
        base = home or Path(os.environ.get("CODEX_HOME", DEFAULT_HOMES["codex"])).expanduser()
        index = base / "session_index.jsonl"
        if not index.exists():
            return None
        rows = []
        try:
            lines = index.read_text(encoding="utf-8").splitlines()
        except OSError:
            return None
        for line in lines:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if str(row.get("thread_name") or "").casefold() != wanted:
                continue
            sid = str(row.get("id") or "")
            if sid:
                rows.append({"id": sid, "cwd": "", "updated": row.get("updated_at") or 0})
        return _named(rows)
    if provider == "kimi":
        base = (
            home
            or Path(
                os.environ.get("KIMI_CODE_HOME")
                or os.environ.get("KIMI_HOME", DEFAULT_HOMES["kimi"])
            ).expanduser()
        ) / "sessions"
        rows = []
        for path in base.glob("wd_*/session_*/state.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if row.get("archived") is True:
                continue
            if str(row.get("title") or "").casefold() != wanted:
                continue
            if row.get("isCustomTitle") is not True and row.get("titleKind") != "custom":
                continue
            sid = str(row.get("id") or path.parent.name)
            if sid:
                rows.append({"id": sid, "cwd": row.get("cwd") or "", "updated": row.get("updatedAt") or 0})
        return _named(rows)
    if provider == "pi":
        base = home or Path(
            os.environ.get("PI_CODING_AGENT_SESSION_DIR")
            or Path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi/agent")) / "sessions"
        ).expanduser()
        rows = []
        for path in base.glob("**/*.jsonl"):
            sid, name, updated = "", "", ""
            try:
                with path.open(encoding="utf-8") as fh:
                    for line in fh:
                        try:
                            row = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if row.get("type") == "session" and row.get("id"):
                            sid = str(row["id"])
                        if row.get("type") == "session_info" and row.get("name"):
                            name = str(row["name"])
                        if row.get("timestamp"):
                            updated = str(row["timestamp"])
            except OSError:
                continue
            if sid and name.casefold() == wanted:
                rows.append({"id": sid, "cwd": "", "updated": updated})
        return _named(rows)
    return None


def launch_argv(
    provider: str,
    handle: str,
    session_id: str | None,
    fresh: bool = False,
    workspace: str = "",
    role: str | None = None,
) -> list[str]:
    """Build the provider launch/resume argv for a handle."""
    # The radio briefing rides the launch as provider-native system context:
    # invisible, spends no turn, and the relay never messages the agent itself.
    # Resume gets it too — system context is per-process, a restored transcript
    # does not carry it.
    briefing = briefing_text(handle, workspace, role)
    if provider == "claude":
        argv = ["claude", "--append-system-prompt", briefing]
        return argv + (["--resume", session_id] if session_id else []) + ["--name", handle]
    if provider == "codex":
        # Codex rewrites the terminal title (OSC) with the current task text,
        # hiding the pane label that IS the radio handle. Turn its title writer
        # off for radio-launched sessions; the user's config.toml is untouched.
        # developer_instructions appends to the built-in instructions (unlike
        # model_instructions_file, which replaces them); json.dumps emits a
        # valid TOML basic string for -c parsing.
        argv = [
            "codex",
            "-c", "tui.terminal_title=[]",
            "-c", f"developer_instructions={json.dumps(briefing)}",
        ]
        return argv + (["resume", session_id] if session_id else [])
    if provider == "kimi":
        # No append-system-prompt flag and SessionStart hook stdout does not
        # reach context (verified). The briefing arrives with the first prompt
        # via bin/radio-kimi-hook.sh (UserPromptSubmit), keyed on RADIO_HANDLE.
        return ["kimi"] + (["--session", session_id] if session_id else [])
    if provider == "pi":
        return ["pi"] + (["--session", session_id] if session_id else []) + ["--name", handle]
    if provider == "qwen":
        # Radio-launched agents must answer messages unattended: auto-approve
        # tool calls (qwen has no safe-classifier mode that covers shell).
        argv = ["qwen", "--approval-mode", "yolo", "--append-system-prompt", briefing]
        if session_id:
            # join assigns the id itself (--session-id), so resume is exact.
            return argv + ["--session-id" if fresh else "--resume", session_id]
        return argv
    if provider == "gemini":
        # No append-system-prompt flag; the briefing is injected by the
        # SessionStart hook (bin/radio-gemini-hook.sh, additionalContext JSON).
        # --approval-mode yolo: radio agents must run `radio` without dialogs.
        argv = ["gemini", "--approval-mode", "yolo"]
        if session_id:
            # join assigns the id itself (--session-id), so resume is exact.
            return argv + ["--session-id" if fresh else "--resume", session_id]
        return argv
    if provider == "opencode":
        # Briefing rides a per-handle OPENCODE_CONFIG file (instructions) —
        # see cmd_join. Session ids are server-generated; resume only.
        return ["opencode"] + (["--session", session_id] if session_id else [])
    raise SystemExit(f"unknown provider: {provider}")


def agent_launch_argv(argv: list[str]) -> list[str]:
    """Resolve the provider binary and adapt the argv for the OS: Windows
    npm-style shims (.cmd/.bat) cannot be CreateProcess'd directly, so they run
    through cmd /c; POSIX execs the resolved path."""
    target = shutil.which(argv[0]) or argv[0]
    if os.name == "nt" and Path(target).suffix.lower() in (".cmd", ".bat"):
        return ["cmd.exe", "/c", target, *argv[1:]]
    return [target, *argv[1:]]


def windows_command_line(argv: list[str]) -> str:
    """The command-line string for a Windows launch. A .cmd/.bat target runs
    via cmd /c (CreateProcess cannot start batch files); cmd /c strips a lone
    outer quote pair, so a space-bearing target path gets the documented extra
    pair — otherwise cmd would split the path at its first space."""
    if len(argv) >= 3 and Path(argv[0]).name.lower() == "cmd.exe" and argv[1].lower() == "/c":
        target, rest = argv[2], subprocess.list2cmdline(argv[3:])
        body = f'"{target}"' + (f" {rest}" if rest else "")
        if " " in target:
            body = f'"{body}"'
        return f"cmd.exe /c {body}"
    return subprocess.list2cmdline(argv)


def exec_or_wait(argv: list[str], env: dict[str, str]) -> int:
    """Hand the terminal to another program. POSIX execs in place — the pane's
    foreground process becomes the target. Windows has no true exec (the CRT
    spawns a process and exits, which would return the shell prompt while the
    target still runs), so the target runs as a waited-for child instead."""
    if os.name == "nt":
        try:
            return subprocess.run(windows_command_line(argv), env=env).returncode
        except OSError as exc:
            raise SystemExit(f"launch failed: {exc}")
    try:
        os.execvpe(argv[0], argv, env)
    except OSError as exc:
        raise SystemExit(f"launch failed: {exc}")
    return 0  # unreachable


def launch_agent(argv: list[str], env: dict[str, str]) -> int:
    """Resolve the provider CLI for this OS (see agent_launch_argv) and hand
    the terminal to it; returns only on the Windows wait path."""
    return exec_or_wait(agent_launch_argv(argv), env)


def ask_provider(handle: str) -> str:
    """Interactive provider picker; returns the provider name, or '' when the
    user picks 'none' (register only). Raises SystemExit on cancel."""
    options = []
    for name in PROVIDERS:
        binary = "" if shutil.which(name) else "  (not on PATH)"
        options.append(f"{name} — {auth_status(name)}{binary}")
    options.append("none — just register the handle, don't launch an agent")
    idx = choose(f'Which agent should "{handle}" join as?', options)
    if idx is None:
        raise SystemExit("cancelled")
    return "" if idx == len(PROVIDERS) else PROVIDERS[idx]


def cmd_join(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Register a handle bound to the current (or given) pane inside its
    workspace, adopt or pick its provider session, and — when interactive —
    exec the agent with the radio briefing attached. Pane label and handle are
    kept identical; the workspace comes from the pane or the caller's env."""
    interactive = not args.no_launch and sys.stdin.isatty() and sys.stdout.isatty()

    pane_id = args.pane
    if not pane_id and os.environ.get("HERDR_ENV") == "1":
        pane_id = os.environ.get("HERDR_PANE_ID")
    pane = fetch_pane(pane_id) if pane_id else None
    if pane_id and pane is None:
        raise SystemExit(f"pane not found: {pane_id}")
    physical_workspace = (pane or {}).get("workspace_id") or current_workspace()
    membership = binding_for_pane(
        conn, f"herdr:{pane_id}" if pane else "manual", physical_workspace
    )
    requested_frequency = getattr(args, "frequency", None)
    workspace = physical_workspace
    if requested_frequency:
        workspace = frequency_scope(requested_frequency)
    elif not getattr(args, "workspace_frequency", False) and membership and is_frequency(membership["workspace"]):
        workspace = membership["workspace"]
    changing_frequency = bool(membership and membership["workspace"] != workspace and
                              (is_frequency(membership["workspace"]) or is_frequency(workspace)))
    if is_frequency(workspace) and not pane:
        raise SystemExit("joining a named frequency requires a live Herdr pane")
    handle = args.handle
    label = (pane or {}).get("label") or ""
    default_handle = membership["name"] if membership else label.split("@", 1)[0]
    if not handle and interactive and not label:
        handle = input("Handle for this pane (the name others will use to message it): ").strip()
    if not handle:
        if not default_handle:
            raise SystemExit("pass a handle, or give the pane a label first")
        handle = default_handle
    handle = normalize_handle(handle)
    # Case-insensitive rejoin resolves inside this workspace first, then the
    # unscoped namespace (rows that predate scoping) — never another
    # workspace's spelling: a case-variant row would split the identity, and
    # the label check would then report one spelling as "gone (pane reused)".
    registered = (_match_in_workspace(conn, workspace, handle) if is_frequency(workspace) or changing_frequency
                  else resolve_handle(conn, handle, workspace))
    handle = registered["name"] if registered else handle
    changing_identity = bool(
        membership and (membership["workspace"], membership["name"]) != (workspace, handle)
    )
    if pane and pane.get("agent") and (
        changing_frequency or (is_frequency(workspace) and (not membership or changing_identity))
    ):
        raise SystemExit("exit the current agent before changing its Radio identity or frequency; use a fresh session")
    if is_frequency(workspace) and registered and registered["session_ref"] != f"herdr:{pane_id}":
        registered_pane = pane_id_of(registered["session_ref"])
        if registered_pane and pane_exists(registered_pane):
            raise SystemExit(f'handle "{handle}" is already bound to another live pane in this frequency')

    provider = args.provider or ""
    session_id = None
    existing = registered
    account_name = args.account or (existing["account"] if existing else None)
    account = resolve_account(conn, account_name) if account_name else None
    if account_name and not account:
        raise SystemExit(
            f"unknown account: {account_name} — add it: "
            f"radio account add {account_name} --provider <provider>"
        )
    if account and provider and provider != account["provider"]:
        raise SystemExit(
            f"account {account['name']} belongs to {account['provider']}, not {provider}"
        )
    if account:
        provider = account["provider"]
    # A recorded session belongs to one provider+account pair; changing either
    # makes it stale for this launch (move it with `radio account move`).
    provider_changed = bool(
        existing and existing["agent"] and provider and existing["agent"] != provider
    )
    account_changed = bool(existing) and (
        (existing["account"] or "") != (account["name"] if account else "")
    )
    session_stale = provider_changed or account_changed
    recorded_session = None if session_stale else (existing["agent_session"] if existing else None)
    if session_stale and existing and existing["agent_session"]:
        previous = existing["agent"] + (
            f', account {existing["account"]}' if existing["account"] else ""
        )
        if account_changed and account:
            print(
                f'note: the recorded session belongs to {previous}; it is not resumed here — '
                f'move it with: radio account move {handle} --to {account["name"]}'
            )
        else:
            print(
                f'note: the recorded session belongs to {previous}; it is not resumed under '
                f"{provider} — start it again if you want it here"
            )
    if existing is not None and existing["workspace"] == "" and workspace:
        # A pre-scope row bound to this workspace: adopt it into the scope so
        # a rejoin never forks a duplicate row for the same pane.
        if _match_in_workspace(conn, workspace, handle) is None:
            conn.execute(
                "UPDATE handles SET workspace=? WHERE workspace='' AND name=?",
                (workspace, handle),
            )
            conn.commit()
            existing = conn.execute(
                "SELECT * FROM handles WHERE workspace=? AND name=?", (workspace, handle)
            ).fetchone()
            if membership and membership["workspace"] == "" and membership["name"] == handle:
                # This join just adopted its own pre-scope row. Compare the
                # final locked binding against that intentional new identity.
                membership = dict(membership, workspace=workspace)
    if (
        existing
        and existing["agent"]
        and not existing["agent_session"]
        and existing["session_ref"].startswith("herdr:")
    ):
        # Join could not see the session id while the agent was still booting.
        # Adopt it now from the bound pane (guarded: same provider, same label,
        # so a reused pane never donates its session to the wrong handle).
        bound = fetch_pane(existing["session_ref"].removeprefix("herdr:"))
        if (
            bound
            and bound.get("agent") == existing["agent"]
            and (bound.get("label") or "") == pane_label(handle, workspace)
            and (
                not scope_workspace(existing)
                or (bound.get("workspace_id") or "") == scope_workspace(existing)
            )
        ):
            live = (bound.get("agent_session") or {}).get("value")
            if live:
                conn.execute(
                    "UPDATE handles SET agent_session=? WHERE workspace=? AND name=?",
                    (live, workspace, handle),
                )
                conn.commit()
                existing = conn.execute(
                    "SELECT * FROM handles WHERE workspace=? AND name=?", (workspace, handle)
                ).fetchone()
                if not session_stale:
                    recorded_session = existing["agent_session"]
    if (
        interactive
        and not provider
        and not args.new
        and existing
        and existing["agent"]
        and recorded_session
    ):
        # This handle already ran here: offer its recorded session before
        # asking for provider/session from scratch.
        idx = choose(
            f'"{handle}" already joined as {existing["agent"]} '
            f"(session {recorded_session[:8]}) — bring it back?",
            ["Bring it back — resume the recorded session",
             "Start over — pick provider and session again"],
        )
        if idx is None:
            raise SystemExit("cancelled")
        if idx == 0:
            provider = existing["agent"]
            session_id = recorded_session

    if interactive and not provider:
        provider = ask_provider(handle)
    if provider and args.resume and not session_id:
        # Explicit --resume: the ledger's recorded session (backfilled from the
        # live pane) is authoritative; the provider disk search is the fallback.
        # Never silently start fresh — a missed resume is an error, not a new chat.
        if existing and existing["agent"] == provider and recorded_session:
            session_id = recorded_session
        else:
            if is_frequency(workspace) or changing_frequency:
                raise SystemExit(f'no recorded {provider} session for "{handle}" in this frequency; use --new')
            found = find_named_session(provider, handle, home=provider_home(provider, account))
            if found:
                session_id = found["id"]
            else:
                raise SystemExit(f"no saved {provider} session named {handle}")
    elif provider and interactive and not session_id:
        found = (
            None
            if args.new or is_frequency(workspace) or changing_frequency
            else find_named_session(provider, handle, home=provider_home(provider, account))
        )
        if found:
            cwd = found["cwd"] or "cwd unknown"
            idx = choose(
                f'"{handle}" has a saved {provider} session '
                f"({found['id'][:8]}, {cwd}) — resume it?",
                ["Resume it — continue the previous conversation",
                 "Start a new session instead"],
            )
            if idx is None:
                raise SystemExit("cancelled")
            if idx == 0:
                session_id = found["id"]
        else:
            print(f"no saved {provider} session named {handle}; starting new")

    launching = interactive and bool(provider)
    # Providers that accept a caller-assigned session id get one now: the
    # ledger knows the real id before launch, no boot-window backfill needed.
    assign_id = provider in ("gemini", "qwen")
    fresh = bool(launching and assign_id and not session_id)
    if fresh:
        session_id = str(uuid.uuid4())
    pane_session = ((pane or {}).get("agent_session") or {}).get("value")
    if changing_frequency or (is_frequency(workspace) and (not existing or changing_identity)):
        pane_session = None
    if session_id:
        agent_session = session_id
    elif launching:
        # A new agent is about to boot in this pane; the pane's current
        # session id belongs to the process being replaced. Leave NULL, the
        # relay backfills the real id once the agent is up.
        agent_session = None
    else:
        agent_session = pane_session or recorded_session
    ref = f"herdr:{pane_id}" if pane else "manual"
    if ref == "manual" and existing and existing["session_ref"].startswith("herdr:"):
        old_pane = existing["session_ref"].removeprefix("herdr:")
        if pane_exists(old_pane):
            # A pane-less rejoin must not clobber a live pane binding.
            ref = existing["session_ref"]
    if args.role is not None:
        role = args.role.strip() or None  # --role "" clears the paragraph
    else:
        role = existing["role"] if existing else None
    ts = now()
    account_value = account["name"] if account else (existing["account"] if existing else None)
    # Serialize all pane rebindings with the relay's final check and push.
    # Provider/session prompts happen before acquiring this write lock.
    if pane:
        conn.execute("BEGIN IMMEDIATE")
        try:
            # Recheck after the lock: another join may have claimed this name
            # or retuned the target pane while the user answered launch prompts.
            latest = binding_for_pane(conn, ref, physical_workspace)
            before = (membership["workspace"], membership["name"]) if membership else None
            after = (latest["workspace"], latest["name"]) if latest else None
            if before != after:
                raise SystemExit("pane binding changed while joining; retry from its current session")
            destination = _match_in_workspace(conn, workspace, handle)
            if destination and destination["name"] != handle:
                raise SystemExit("handle was registered while joining; retry with its registered spelling")
            if ((is_frequency(workspace) or changing_frequency)
                    and destination and destination["session_ref"] != ref):
                occupied = pane_id_of(destination["session_ref"])
                if occupied and pane_exists(occupied):
                    raise SystemExit(f'handle "{handle}" is already bound to another live pane in this frequency')
            live_pane = fetch_pane(pane_id)
            if not live_pane or (live_pane.get("workspace_id") or "") != physical_workspace:
                raise SystemExit("pane moved or closed while joining; retry from its current workspace")
            if ((is_frequency(workspace) or changing_frequency)
                    and live_pane.get("agent") and (changing_identity or not membership)):
                raise SystemExit("exit the current agent before changing its Radio identity or frequency")
            label = live_pane.get("label") or ""
        except BaseException:
            conn.rollback()
            raise
        for previous in conn.execute(
            "SELECT workspace, name FROM handles WHERE session_ref=?", (ref,)
        ).fetchall():
            if (previous["workspace"], previous["name"]) != (workspace, handle):
                conn.execute(
                    "UPDATE handles SET session_ref='manual' WHERE workspace=? AND name=?",
                    (previous["workspace"], previous["name"]),
                )
                conn.execute(
                    "UPDATE deliveries SET status='pull', last_error=?, focus_hold_since=NULL "
                    "WHERE target_ws=? AND target=? AND status='pending'",
                    ("frequency changed" if changing_frequency else "identity changed",
                     previous["workspace"], previous["name"]),
                )
    expected_label = pane_label(handle, workspace)
    if pane and label != expected_label:
        renamed = herdr("pane", "rename", pane_id, expected_label)
        if renamed.returncode != 0:
            conn.rollback()
            raise SystemExit(f"pane rename failed: {(renamed.stderr or '').strip()}")
    conn.execute(
        """INSERT INTO handles(workspace, pane_workspace, name, session_ref, agent, agent_session, role, account, created_at, last_seen)
           VALUES (?,?,?,?,?,?,?,?,?,?)
           ON CONFLICT(workspace, name) DO UPDATE SET session_ref=excluded.session_ref,
                                                      pane_workspace=excluded.pane_workspace,
                                                      agent=excluded.agent,
                                                      agent_session=excluded.agent_session,
                                                      role=excluded.role,
                                                      account=excluded.account,
                                                      last_seen=excluded.last_seen""",
        # A flagless rejoin (or a bot's --no-launch) must not erase the
        # recorded provider: only an explicit provider or account replaces it.
        (workspace, physical_workspace, handle, ref,
         provider or (existing["agent"] if existing else None),
         agent_session, role, account_value, ts, ts),
    )
    conn.commit()
    session_note = f", {provider} session {agent_session[:8]}" if provider and agent_session else ""
    account_note = f", account {account['name']}" if account else ""
    where_note = (f" on {workspace_display(workspace)}" if is_frequency(workspace)
                  else f" in workspace {workspace}" if workspace else "")
    print(f"{handle} joined{where_note} ({ref}{session_note}{account_note})")

    if ref != "manual":
        # Catch-up compaction: a handle rejoining on a live pane must not get
        # its entire backlog pushed into the fresh agent. Only the newest
        # reply-required PM per sender stays push-worthy; every other pending
        # delivery — and old 'failed' rows, which were terminal forever —
        # degrades to pull: fetchable via inbox/show, never auto-pushed.
        keep_ids = [
            r["mid"]
            for r in conn.execute(
                """SELECT MAX(m.id) AS mid
                   FROM deliveries d JOIN messages m ON m.id = d.message_id
                   WHERE d.target_ws = ? AND d.target = ? AND d.status = 'pending'
                     AND m.reply_required = 1
                   GROUP BY m.from_ws, m.from_handle""",
                (workspace, handle),
            ).fetchall()
        ]
        clause = ""
        values: list[object] = [workspace, handle]
        if keep_ids:
            clause = f" AND message_id NOT IN ({','.join('?' * len(keep_ids))})"
            values += keep_ids
        demoted = conn.execute(
            "UPDATE deliveries SET status='pull', last_error='catch-up: read via radio inbox' "
            f"WHERE target_ws = ? AND target = ? AND status = 'pending'{clause}",
            values,
        ).rowcount
        revived = conn.execute(
            "UPDATE deliveries SET status='pull', last_error='catch-up: read via radio inbox' "
            "WHERE target_ws = ? AND target = ? AND status = 'failed'",
            (workspace, handle),
        ).rowcount
        conn.commit()
        if keep_ids or demoted or revived:
            print(f"catch-up: {len(keep_ids)} push (reply-required), "
                  f"{demoted + revived} left for pull")

    if not interactive or not provider:
        return 0
    argv = launch_argv(provider, handle, session_id, fresh=fresh, workspace=workspace, role=role)
    env = os.environ.copy()
    env["RADIO_HANDLE"] = handle
    env["RADIO_JOINED_SCOPE"] = workspace
    if account:
        env.update(account_env(account))
    if provider == "opencode":
        # No append flag/hook channel; briefing ships as an `instructions`
        # file via a per-handle OPENCODE_CONFIG file. (OPENCODE_CONFIG_CONTENT
        # inline config resolves in `debug config` but its instructions never
        # reach the model — verified on 1.18.31.) Merges with user config;
        # its `instructions` shadows the user's global list for this session.
        brief_dir = STATE_DIR / "opencode"
        if is_frequency(workspace):
            brief_dir = brief_dir / workspace
        brief_dir.mkdir(parents=True, exist_ok=True)
        brief_file = brief_dir / f"{handle}.md"
        brief_file.write_text(briefing_text(handle, workspace, role), encoding="utf-8")
        cfg: dict = {"instructions": [str(brief_file)]}
        # Ref-based sharing means agents read files outside their cwd (the
        # sender's /tmp, another project). opencode asks on external_directory
        # by default; radio-launched handles must not stall on that dialog.
        cfg["permission"] = {"external_directory": "allow"}
        if args.model:
            cfg["model"] = args.model
        cfg_file = brief_dir / f"{handle}.json"
        cfg_file.write_text(json.dumps(cfg), encoding="utf-8")
        env["OPENCODE_CONFIG"] = str(cfg_file)
    elif args.model:
        print(f"note: --model is only wired for opencode; ignoring for {provider}")
    print(f"launching: {' '.join(argv)}")
    return launch_agent(argv, env)


def briefing_text(handle: str, workspace: str = "", role: str | None = None) -> str:
    """The opening briefing every radio-launched agent gets: its handle, its
    project scope, its role paragraph when one is set, the commands, ref-based
    sharing for long content, and the push-based delivery contract (never poll
    inbox, never set timers waiting for a reply)."""
    where = (f' on frequency "{workspace.removeprefix(FREQUENCY_PREFIX)}"' if is_frequency(workspace)
             else f' in workspace "{workspace_label(workspace)}"' if workspace else "")
    scope_brief = (
        "Radio is scoped to this named frequency across workspaces. Only members of "
        "this frequency are reachable; do not retune an active conversation. "
        if is_frequency(workspace) else
        "Radio is scoped to this workspace: `radio handles` lists this "
        "project's agents and `radio pm <handle>` reaches this project. "
    )
    role_line = f"Your role: {role} " if role else ""
    return (
        f'You are on Radio as "{handle}"{where}. '
        + role_line
        + scope_brief
        + "Commands: "
        "radio handles (who is on) · "
        'radio pm <handle> "<message>" (direct message) · '
        'radio pm <handle> "<message>" --reply-required (when you need an answer — '
        "asking for a reply inside the message text does NOT set the flag) · "
        f"radio inbox {handle} · radio show <id> (FALLBACK ONLY — see below). "
        "Keep messages short: for long content (reports, logs, diffs) write "
        "it to a file and attach it as --ref <path> — the recipient reads "
        "the file itself, on demand. "
        "Delivery is push-based: incoming messages arrive in this pane by "
        "themselves, wrapped in [RADIO_MESSAGE ...] envelopes; the header's "
        "reply=required means you must answer over radio. After sending a "
        "message, NEVER poll `radio inbox` and NEVER set timers to check for "
        "a reply — the reply arrives pushed to this pane on its own; continue "
        "other work or simply stop. `radio inbox` exists only for messages "
        "that could not be pushed (e.g. while your pane had no agent), not "
        "for waiting on replies."
    )


def cmd_part(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Remove a handle from the caller's workspace and fail its still-
    undelivered deliveries."""
    scope = current_scope(conn)
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    conn.execute(
        "DELETE FROM handles WHERE workspace = ? AND name = ?",
        (row["workspace"], row["name"]),
    )
    conn.execute(
        "UPDATE deliveries SET status='failed', last_error='handle parted' "
        "WHERE target_ws = ? AND target = ? AND status IN ('pending', 'pull')",
        (row["workspace"], row["name"]),
    )
    conn.commit()
    print(f"{row['name']} parted")
    return 0


def session_files(provider: str, home: Path, session_id: str) -> list[Path]:
    """The files (or directories) that carry one provider session inside a
    config home; empty when the provider's storage is unknown — callers then
    refuse rather than silently losing the session."""
    if provider == "codex":
        return sorted(home.glob(f"sessions/**/*{session_id}*.jsonl"))
    if provider == "claude":
        return sorted(home.glob(f"projects/*/{session_id}.jsonl"))
    if provider == "kimi":
        return sorted(home.glob(f"sessions/wd_*/session_{session_id}"))
    if provider == "pi":
        found = []
        for path in home.glob("**/*.jsonl"):
            try:
                with path.open(encoding="utf-8") as fh:
                    for line in fh:
                        try:
                            row = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if row.get("type") == "session" and str(row.get("id")) == session_id:
                            found.append(path)
                            break
            except OSError:
                continue
        return sorted(found)
    return []


def _json_id(line: str) -> str:
    """The 'id' field of a JSONL line, or '' when the line is not an object."""
    try:
        row = json.loads(line)
    except json.JSONDecodeError:
        return ""
    return str(row.get("id") or "") if isinstance(row, dict) else ""


def _copy_codex_index_entry(source: Path, target: Path, session_id: str) -> None:
    """Carry the codex session_index.jsonl entry over, so resume-by-name works
    under the new account (the session file alone is not enough)."""
    index = source / "session_index.jsonl"
    try:
        lines = index.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    entries = [line for line in lines if _json_id(line) == session_id]
    if not entries:
        return
    target_index = target / "session_index.jsonl"
    try:
        known = {_json_id(line) for line in target_index.read_text(encoding="utf-8").splitlines()}
    except OSError:
        known = set()
    with target_index.open("a", encoding="utf-8") as fh:
        for line in entries:
            if session_id not in known:
                fh.write(line + "\n")
                known.add(session_id)


KNOWN_SESSION_PROVIDERS = ("codex", "claude", "kimi", "pi")


def session_present(provider: str, home: Path, session_id: str) -> bool | None:
    """Whether the recorded session's files are still in this home: True/False
    for providers with a known layout, None when the layout is unknown — the
    caller then trusts the ledger."""
    if provider not in KNOWN_SESSION_PROVIDERS:
        return None
    return bool(session_files(provider, home, session_id))


def account_move(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Copy a handle's session into another account's home and switch the
    handle over. Copies, never moves: the old account keeps its data, and the
    next join/restore resumes the same conversation under the new login."""
    scope = current_scope(conn)
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    if not row["agent"]:
        raise SystemExit(f'{row["name"]} has no recorded provider — nothing to move')
    target = resolve_account(conn, args.to)
    if not target:
        raise SystemExit(f"unknown account: {args.to} (radio account add {args.to} --provider <name>)")
    if target["provider"] != row["agent"]:
        raise SystemExit(
            f'account {target["name"]} belongs to {target["provider"]}, not {row["agent"]}'
        )
    if (row["account"] or "") == target["name"]:
        print(f'{row["name"]} already uses account {target["name"]}')
        return 0
    source_account = resolve_account(conn, row["account"]) if row["account"] else None
    source_home = provider_home(row["agent"], source_account)
    target_home = provider_home(row["agent"], target)
    if source_home == target_home:
        raise SystemExit(f'source and target homes are the same: {source_home}')
    copied = 0
    if row["agent_session"]:
        files = session_files(row["agent"], source_home, row["agent_session"])
        if not files:
            raise SystemExit(
                f'session {row["agent_session"][:8]} not found under {source_home} — '
                f'moving sessions is not supported for {row["agent"]} yet; '
                f'to switch anyway (starting fresh) run: radio join {row["name"]} --account {target["name"]}'
            )
        for path in files:
            destination = target_home / path.relative_to(source_home)
            try:
                if path.is_dir():
                    shutil.copytree(path, destination, dirs_exist_ok=True)
                else:
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, destination)
            except OSError as exc:
                raise SystemExit(f"copy failed for {path}: {exc}")
            copied += 1
        if row["agent"] == "codex":
            _copy_codex_index_entry(source_home, target_home, row["agent_session"])
    conn.execute(
        "UPDATE handles SET account=? WHERE workspace=? AND name=?",
        (target["name"], row["workspace"], row["name"]),
    )
    conn.commit()
    print(
        f'{row["name"]}: account {row["account"] or "(provider default)"} -> {target["name"]} '
        f'({source_home} -> {target_home})'
    )
    if row["agent_session"]:
        print(f'  session {row["agent_session"][:8]}: {copied} file(s) copied')
        print(f'  the next join/restore resumes it under {target["name"]}')
    else:
        print("  no recorded session — account changed only")
    pane_id = pane_id_of(row["session_ref"])
    pane = fetch_pane(pane_id) if pane_id else None
    if pane and pane.get("agent"):
        print(
            f'  note: an agent is live in {pane_id}; it keeps the old login until the '
            "next join or restore"
        )
    return 0


def cmd_account(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Manage named provider accounts: several logins of one provider on the
    same machine. An account is a config home; joining with --account exports
    the provider's home variable so the agent runs that login, and restore
    brings the same login back because the handle records it."""
    command = getattr(args, "account_command", None)
    if command == "move":
        return account_move(conn, args)
    if command == "add":
        name = args.name.removeprefix("@")
        if not HANDLE_RE.match(name):
            raise SystemExit(f"invalid account name: {name!r} (allowed: letters, digits, _ . -)")
        if resolve_account(conn, name):
            raise SystemExit(f"account already exists: {name}")
        home = (
            Path(args.home).expanduser() if args.home else default_account_home(args.provider, name)
        )
        overrides: dict[str, str] = {}
        for pair in args.env or []:
            key, sep, value = pair.partition("=")
            if not sep or not key.strip():
                raise SystemExit(f"invalid --env {pair!r} (expected NAME=VALUE)")
            overrides[key.strip()] = value
        try:
            home.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(f"  note: could not create the home: {exc}")
        conn.execute(
            "INSERT INTO accounts(name, provider, home, env, created_at) VALUES (?,?,?,?,?)",
            (name, args.provider, str(home), json.dumps(overrides), now()),
        )
        conn.commit()
        print(f"account {name} -> {args.provider} · {home}")
        print(f"  {auth_status(args.provider, home)}")
        if overrides:
            print("  env: " + ", ".join(f"{key}={value}" for key, value in overrides.items()))
        home_var = ACCOUNT_ENV.get(args.provider, ("<ENV>",))[0]
        print(f"  log in inside this home before relying on it "
              f"(e.g. {home_var}={home} {args.provider} login)")
        return 0
    if command == "list":
        rows = conn.execute("SELECT * FROM accounts ORDER BY provider, name").fetchall()
        if not rows:
            print("no accounts — add one: radio account add work --provider codex --home ~/.codex-work")
            return 0
        for row in rows:
            users = [
                r["name"]
                for r in conn.execute(
                    "SELECT name FROM handles WHERE account = ? ORDER BY name", (row["name"],)
                ).fetchall()
            ]
            home = account_home(row)
            print(f"{row['name']:<12} {row['provider']:<8} {home or '(provider default home)'}")
            print(f"  {auth_status(row['provider'], home)}")
            try:
                overrides = json.loads(row["env"] or "{}")
            except (TypeError, ValueError):
                overrides = {}
            if isinstance(overrides, dict) and overrides:
                print("  env: " + ", ".join(f"{key}={value}" for key, value in overrides.items()))
            if users:
                print(f"  used by: {', '.join(users)}")
        return 0
    if command == "remove":
        row = resolve_account(conn, args.name)
        if not row:
            raise SystemExit(f"unknown account: {args.name}")
        users = [
            r["name"]
            for r in conn.execute(
                "SELECT name FROM handles WHERE account = ? ORDER BY name", (row["name"],)
            ).fetchall()
        ]
        if users:
            raise SystemExit(
                f"account {row['name']} is in use by: {', '.join(users)} — part or rejoin them first"
            )
        conn.execute("DELETE FROM accounts WHERE name = ?", (row["name"],))
        conn.commit()
        print(f"account {row['name']} removed")
        return 0
    print("usage: radio account add <name> --provider <provider> [--dir <path>]")
    print("       radio account list")
    print("       radio account remove <name>")
    return 0


def cmd_role(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Show, set, or clear one handle's role paragraph in the caller's
    workspace. The role is ledger state, not a message — a change reaches the
    agent on its next join/resume briefing and is never pushed."""
    scope = current_scope(conn)
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    if args.clear:
        conn.execute(
            "UPDATE handles SET role = NULL WHERE workspace = ? AND name = ?",
            (row["workspace"], row["name"]),
        )
        conn.commit()
        print(f"role cleared for {row['name']}")
        return 0
    text = " ".join(args.text).strip()
    if not text:
        print(row["role"] or f"no role set for {row['name']}")
        return 0
    conn.execute(
        "UPDATE handles SET role = ? WHERE workspace = ? AND name = ?",
        (text, row["workspace"], row["name"]),
    )
    conn.commit()
    print(f"role set for {row['name']} — it reaches the agent on its next join/resume")
    return 0


def record_message(
    conn: sqlite3.Connection,
    kind: str,
    sender: str,
    text: str,
    to_handle: str | None = None,
    ref: str | None = None,
    reply_required: bool = False,
    from_ws: str = "",
    to_ws: str = "",
) -> int:
    """Insert one message row and return its id. Queuing the delivery is a
    separate step (enqueue_delivery) so callers compose the two. Backticks
    are normalized to quotes at this single insertion point: model-generated
    text habitually contains them, and typed into a shell pane (the send-text
    fallback) a backtick is shell command substitution."""
    text = text.replace("`", "'")
    cur = conn.execute(
        "INSERT INTO messages(ts, kind, from_ws, from_handle, to_ws, to_handle, text, ref, reply_required) "
        "VALUES (?,?,?,?,?,?,?,?,?)",
        (now(), kind, from_ws, sender, to_ws, to_handle, text, ref, int(reply_required)),
    )
    return int(cur.lastrowid)


LONG_MESSAGE_CHARS = 1200


def cmd_pm(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Record a direct message to a joined handle in the sender's workspace
    and queue its delivery; nudges toward --ref for long texts and restates
    the no-poll rule for reply-required sends."""
    from_ws, sender = resolve_identity(conn, args.sender, what="sender")
    if _match_in_workspace(conn, from_ws, sender) is None:
        # Sending as an unregistered name works, but the recipient cannot
        # resolve it to reply — say so at the moment it matters.
        print(
            f'note: sender "{sender}" is not a joined handle — replies to it will not '
            f'resolve until it joins (radio join {sender})'
        )
    row = resolve_handle(conn, args.to, from_ws)
    if not row:
        raise SystemExit(no_handle_message(conn, args.to, from_ws))
    to_ws, args.to = row["workspace"], row["name"]
    text = " ".join(args.text)
    mid = record_message(conn, "pm", sender, text, to_handle=args.to,
                         ref=args.ref, reply_required=args.reply_required,
                         from_ws=from_ws, to_ws=to_ws)
    enqueue_delivery(conn, mid, args.to, to_ws)
    conn.commit()
    print(f"pm #{mid} -> {args.to}")
    if len(text) > LONG_MESSAGE_CHARS:
        # Token-sensitive bus: a long paste costs the recipient a big prompt.
        # Nudge at the exact moment it happens.
        print(
            f"note: {len(text)} chars is a heavy message — next time write the "
            "content to a file and send --ref <path>; the recipient reads it "
            "itself, on demand."
        )
    if args.reply_required:
        # Senders expecting an answer tend to poll `radio inbox` in a loop.
        # State the push contract at the exact moment the impulse starts.
        print(
            "The reply is pushed to your pane as a [RADIO_MESSAGE] envelope — "
            "do NOT poll `radio inbox` or set timers to check for it; "
            "continue other work or stop."
        )
    return 0


def handle_status(row: sqlite3.Row) -> str:
    """Fresh liveness from the bound pane — the ledger row alone says nothing
    about whether the agent is still there (panes close, get reused, agents
    exit; nothing parts automatically). A moved pane gets a new
    workspace-qualified id, so a workspace mismatch here means the row was
    recorded against the wrong project."""
    ref = row["session_ref"]
    if not ref.startswith("herdr:"):
        return "manual"
    pane = fetch_pane(ref.removeprefix("herdr:"))
    if not pane:
        return "gone (no live pane)"
    if (pane.get("label") or "") != pane_label(row["name"], row["workspace"]):
        return "gone (pane reused)"
    if scope_workspace(row) and (pane.get("workspace_id") or "") != scope_workspace(row):
        return "gone (pane moved)"
    if row["agent"]:
        live = pane.get("agent")
        if live == row["agent"]:
            return "live"
        if live:
            return f"gone (pane now runs {live})"
        return "gone (agent exited)"
    return "live"


def handle_line(row: sqlite3.Row) -> str:
    """One roster line plus an indented role snippet when a role is set."""
    provider = row["agent"] or "-"
    session = (row["agent_session"] or "-")[:8]
    line = (
        f"  {row['name']:<20} {handle_status(row):<26} {row['session_ref']:<14} "
        f"{provider:<8} sess: {session:<8}"
    )
    if row["account"]:
        # The account is a property, not part of the identity: the handle name
        # (the user's name) stays the one valid reference.
        line += f" account: {row['account']}"
    role = row["role"] or ""
    if role:
        snippet = role[:80] + ("…" if len(role) > 80 else "")
        line += f"\n    role: {snippet}"
    return line


def cmd_handles(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the roster: inside a pane only this workspace's handles, outside
    herdr every handle grouped by workspace. An explicit workspace id or label
    narrows it to that project."""
    def scoped(workspace: str) -> int:
        """Print one workspace's roster, or its empty-state line; the caller
        picks which workspace that is."""
        rows = conn.execute(
            "SELECT * FROM handles WHERE workspace = ? ORDER BY name", (workspace,)
        ).fetchall()
        if not rows:
            print(f"no handles in {workspace_display(workspace)}")
        else:
            print(f"handles in {workspace_display(workspace)}:")
            for row in rows:
                print(handle_line(row))
        return 0

    scope = current_scope(conn)
    if args.workspace:
        requested = resolve_workspace_spec(args.workspace, conn)
        check_scope_access(scope, requested)
        return scoped(requested)
    if scope:
        return scoped(scope)
    rows = conn.execute(
        "SELECT * FROM handles WHERE workspace NOT LIKE 'freq.%' ORDER BY workspace, name"
    ).fetchall()
    if not rows:
        print("no handles joined")
        return 0
    labels = workspace_labels()
    last = None
    for row in rows:
        if row["workspace"] != last:
            last = row["workspace"]
            print(f"{workspace_display(last, labels)}:")
        print(handle_line(row))
    return 0


def cmd_log(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the most recent messages, oldest last. Inside a pane only this
    workspace's traffic; outside herdr the full ledger."""
    scope = current_scope(conn)
    if scope:
        rows = conn.execute(
            "SELECT * FROM messages WHERE from_ws = ? OR to_ws = ? ORDER BY id DESC LIMIT ?",
            (scope, scope, args.limit),
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM messages WHERE from_ws NOT LIKE 'freq.%' AND to_ws NOT LIKE 'freq.%' "
            "ORDER BY id DESC LIMIT ?", (args.limit,)
        ).fetchall()
    for row in reversed(rows):
        target = f"-> {row['to_handle'] or '-'}"
        flag = " [reply-required]" if row["reply_required"] else ""
        ref = f" (ref: {row['ref']})" if "ref" in row.keys() and row["ref"] else ""
        print(f"#{row['id']} {row['ts']} {row['from_handle']} {target}{flag}{ref}: {row['text']}")
    return 0


def cmd_inbox(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Metadata-only index of incoming messages — bodies stay out of context
    until the agent asks for one with `radio show <id>`. Listing consumes
    nothing; delivery state is recorded by the relay (push) or by show."""
    handle_ws, handle = resolve_identity(conn, args.handle, what="inbox handle")
    clause = "" if args.status == "all" else " AND d.status = ?"
    values: list[object] = [handle_ws, handle]
    if args.status != "all":
        values.append(args.status)
    values.append(args.limit)
    rows = conn.execute(
        f"""SELECT d.id AS delivery_id, d.status, m.*
            FROM deliveries d JOIN messages m ON m.id = d.message_id
            WHERE d.target_ws = ? AND d.target = ?{clause}
            ORDER BY m.id DESC LIMIT ?""",
        values,
    ).fetchall()
    if not rows:
        print(f"inbox empty for {handle}")
        print(
            "(new messages are pushed to your pane automatically — "
            "do not poll this command waiting for a reply)"
        )
        return 0
    print(f"inbox for {handle} (newest {len(rows)}):")
    for row in rows:
        text = row["text"] or ""
        snippet = text[:20] + ("…" if len(text) > 20 else "")
        try:
            stamp = datetime.fromisoformat(row["ts"]).astimezone().strftime("%m-%d %H:%M")
        except ValueError:
            stamp = row["ts"][:16]
        flag = " ⚠reply" if row["reply_required"] else ""
        ref = " ref" if "ref" in row.keys() and row["ref"] else ""
        print(
            f"  #{row['id']} {stamp} {row['from_handle']:<14} {row['status']:<10} "
            f"{len(text)}c{flag}{ref}  {snippet}"
        )
    print("read one: radio show <id>")
    return 0


def cmd_show(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print one message body (the exact envelope the pane received). Reading
    as the addressed recipient records the delivery — that is the pull path's
    acknowledgement."""
    row = conn.execute("SELECT * FROM messages WHERE id = ?", (args.message_id,)).fetchone()
    if row is None:
        raise SystemExit(f"no message #{args.message_id}")
    scope = current_scope(conn)
    if is_frequency(scope) or is_frequency(row["from_ws"]) or is_frequency(row["to_ws"]):
        if row["from_ws"] != scope or row["to_ws"] != scope:
            raise SystemExit(f"no message #{args.message_id} in this frequency")
        # Validate --by before printing; a rejected reader must not see the body.
        resolve_identity(conn, args.by, what="reader")
    elif scope and scope not in (row["from_ws"], row["to_ws"]) and (row["from_ws"] or row["to_ws"]):
        # Workspace-scoped like log/inbox: another project's message is not
        # ours to read or acknowledge. Legacy unscoped rows stay reachable.
        raise SystemExit(f"no message #{args.message_id} in this workspace")
    print(format_for_pane(row))
    try:
        viewer_ws, viewer = resolve_identity(conn, args.by, what="reader")
    except SystemExit:
        return 0  # reading without an identity is fine; nothing to record
    if (viewer_ws, viewer) == (row["to_ws"], row["to_handle"]):
        conn.execute(
            """UPDATE deliveries SET status='delivered', delivered_at=?
               WHERE message_id = ? AND target_ws = ? AND target = ?
                 AND status IN ('pending', 'pull', 'failed')""",
            (now(), args.message_id, viewer_ws, viewer),
        )
        conn.commit()
    return 0


def format_for_pane(message: sqlite3.Row) -> str:
    """Render one message as the [RADIO_MESSAGE] envelope typed into a pane.

    The structured header carries the reply semantics, not inline command
    hints — agents learn the commands from the opening briefing. Multi-line is
    fine: agent panes get an atomic verified submission, and the shell path
    flattens newlines before typing. A cross-workspace sender is qualified
    (w1:name) because that is the only address the recipient can reply to."""
    mid = message["id"]
    reply = "required" if message["reply_required"] else "not-required"
    reply_line = "\nReply required: answer this over radio." if message["reply_required"] else ""
    ref_line = ""
    if "ref" in message.keys() and message["ref"]:
        ref_line = f"\nRef: {message['ref']}"
    from_display = message["from_handle"]
    if message["from_ws"] and message["from_ws"] != message["to_ws"]:
        # Cross-scope mail (a script or manual sender): the qualified form is
        # the only address the recipient can reply to.
        from_display = identity(message["from_ws"], message["from_handle"])
    frequency_note = (f"frequency={message['to_ws'].removeprefix(FREQUENCY_PREFIX)} "
                      if is_frequency(message["to_ws"]) else "")
    return (
        f"[RADIO_MESSAGE id={mid} kind=pm {frequency_note}from={from_display} "
        f"to={message['to_handle']} reply={reply}]\n"
        f"Radio PM from {message['from_handle']}{reply_line}\n"
        f"{message['text']}{ref_line}\n"
        f"[END_RADIO_MESSAGE id={mid}]"
    )


AGENT_BOOT_GRACE_S = 30.0

COMPOSER_PROMPTS = {
    # codex renders its prompt glyph differently per terminal/font (» on
    # macOS, Γ in the Windows VM's capture); accept the observed set.
    "codex": ("»", "›", "Γ"),
    "claude": ("❯",),
}
COMPOSER_PLACEHOLDERS = {"codex": ("Ask Codex to do anything",)}
_COMPOSER_DECORATION = " \t⠀⠁⠂⠄⠆⠈⠐⠒⠔⠠⠢⠤⠦⡀⡄⡠⢀⣀"
_composer_cache: dict[str, tuple[float, bool | None]] = {}


def composer_has_draft(provider: str, pane_id: str) -> bool | None:
    """Whether the pane's visible composer holds unsent text: True/False for
    providers whose prompt line we know, None when we cannot tell (the caller
    then pushes). Results are cached per pane for COMPOSER_CHECK_INTERVAL_S so
    a held delivery does not spawn a read on every relay tick."""
    markers = COMPOSER_PROMPTS.get(provider)
    if not markers or not pane_id:
        return None
    cached = _composer_cache.get(pane_id)
    if cached and time.monotonic() - cached[0] < COMPOSER_CHECK_INTERVAL_S:
        return cached[1]
    verdict: bool | None = None
    try:
        result = herdr("pane", "read", pane_id, "--source", "visible", "--format", "text")
        if result.returncode == 0:
            found = [
                (line, marker)
                for line in result.stdout.splitlines()
                for marker in markers
                if marker in line
            ]
            if found:
                line, marker = found[-1]
                after = line.split(marker, 1)[1]
                if any(
                    placeholder in after
                    for placeholder in COMPOSER_PLACEHOLDERS.get(provider, ())
                ):
                    verdict = False
                else:
                    verdict = bool(after.strip(_COMPOSER_DECORATION))
    except (OSError, subprocess.TimeoutExpired):
        verdict = None
    _composer_cache[pane_id] = (time.monotonic(), verdict)
    return verdict


def held_seconds(since: str) -> float:
    """Seconds since a focus hold began; a malformed timestamp reads as 0."""
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(since)).total_seconds()
    except (TypeError, ValueError):
        return 0.0


def delivery_wait_reason(pane: dict, handle: sqlite3.Row, pane_id: str = "",
                         held_since: str | None = None) -> str | None:
    """Hold a delivery while the target agent cannot accept input yet: a modal
    dialog is up (blocked), a turn is running (working — codex silently drops
    prompts submitted mid-turn), or the agent process is still booting (herdr
    has not detected it within the join grace window). Typing into any of
    these strands text in the composer or a dialog.

    A focused pane is held too: the user is at that pane and a push would land
    in whatever they are typing. After FOCUS_HOLD_S the visible composer
    decides — unsent text keeps the hold, an empty composer lets the push
    through (a pane left focused must not starve)."""
    status = pane.get("agent_status") or "unknown"
    if status in ("blocked", "working"):
        return f"agent {status}"
    if pane.get("focused"):
        if held_since is None or held_seconds(held_since) < FOCUS_HOLD_S:
            return "pane focused — user is there"
        if composer_has_draft(pane.get("agent") or "", pane_id):
            return "pane focused — user is typing"
    if pane.get("agent"):
        return None  # detected agent: herdr agent prompt submits atomically
    if not handle["agent"]:
        return None  # plain shell/bot pane: type right away
    try:
        age = (
            datetime.now(timezone.utc) - datetime.fromisoformat(handle["last_seen"])
        ).total_seconds()
    except (TypeError, ValueError):
        return None
    if age < AGENT_BOOT_GRACE_S:
        return "agent still booting"
    return None


def relay_tick(conn: sqlite3.Connection) -> list[str]:
    """One relay pass: backfill agent session ids join could not see, then
    push pending deliveries. Returns human-readable event lines."""
    events: list[str] = []
    # Backfill agent session ids that join could not see while the agent was
    # still booting. Guarded by provider+label match so a reused pane never
    # donates its session to the wrong handle.
    for h in conn.execute(
        "SELECT * FROM handles "
        "WHERE agent_session IS NULL AND agent IS NOT NULL AND session_ref LIKE 'herdr:%'"
    ).fetchall():
        pane = fetch_pane(h["session_ref"].removeprefix("herdr:"))
        if (
            not pane
            or pane.get("agent") != h["agent"]
            or (pane.get("label") or "") != pane_label(h["name"], h["workspace"])
            or (scope_workspace(h) and (pane.get("workspace_id") or "") != scope_workspace(h))
        ):
            continue
        sess = (pane.get("agent_session") or {}).get("value")
        if sess:
            conn.execute(
                "UPDATE handles SET agent_session=? WHERE workspace=? AND name=?",
                (sess, h["workspace"], h["name"]),
            )
            events.append(
                f"{identity(h['workspace'], h['name'])}: backfilled {h['agent']} session {sess[:8]}"
            )
    conn.commit()
    # Re-promote deliveries stranded by downtime: 'pull' + 'no live pane'
    # means the pane was gone at push time — transient. Catch-up demotions
    # ('catch-up: read via radio inbox') and 'delivery unconfirmed' stays are
    # deliberate and must NEVER be auto-pushed; only 'no live pane' comes back.
    for d in conn.execute(
        "SELECT id, target_ws, target FROM deliveries "
        "WHERE status = 'pull' AND last_error = 'no live pane'"
    ).fetchall():
        handle = conn.execute(
            "SELECT * FROM handles WHERE workspace = ? AND name = ?",
            (d["target_ws"], d["target"]),
        ).fetchone()
        pane_id = pane_id_of(handle["session_ref"]) if handle else None
        pane = fetch_pane(pane_id) if pane_id else None
        if not pane:
            continue
        # Same identity guard as the push path: a reused pane gets nothing.
        if (pane.get("label") or "").casefold() != pane_label(d["target"], d["target_ws"]).casefold():
            continue
        if scope_workspace(handle) and (pane.get("workspace_id") or "") != scope_workspace(handle):
            continue
        # An undetected agent is booting, not changed: the push path's boot
        # grace decides when to type instead.
        if handle["agent"] and pane.get("agent") and pane.get("agent") != handle["agent"]:
            continue
        cur = conn.execute(
            "UPDATE deliveries SET status='pending', last_error=NULL, focus_hold_since=NULL "
            "WHERE id = ? AND status = 'pull'",
            (d["id"],),
        )
        if cur.rowcount:
            events.append(
                f"#{d['id']} -> {identity(d['target_ws'], d['target'])} ({pane_id}): "
                "pane back, re-queued for push"
            )
    conn.commit()
    # Backoff + fresh-first: an errored delivery is retried only after
    # RETRY_AFTER_S (each retry costs several herdr subprocess calls), and new
    # mail always goes ahead of retries. last_attempt_at IS NULL covers rows
    # errored before the column existed.
    cutoff = (datetime.now(timezone.utc) - timedelta(seconds=RETRY_AFTER_S)).isoformat(
        timespec="milliseconds"
    )
    rows = conn.execute(
        """SELECT d.id AS delivery_id, d.target_ws, d.target, d.attempts, d.focus_hold_since, m.*
           FROM deliveries d JOIN messages m ON m.id = d.message_id
           WHERE d.status = 'pending'
             AND (d.attempts = 0 OR d.last_attempt_at IS NULL OR d.last_attempt_at <= ?)
           ORDER BY CASE WHEN d.attempts = 0 THEN 0 ELSE 1 END, d.id LIMIT 50""",
        (cutoff,),
    ).fetchall()
    # Every delivery UPDATE below is compare-and-swap on the state it expects
    # (AND status = 'pending'): cmd_show may have acked the row (delivered)
    # between our SELECT and UPDATE, and an unconditional write would lose
    # that ack. rowcount 0 means the row moved under us — the push outcome is
    # no longer authoritative, so no event either.
    for row in rows:
        delivery_id = row["delivery_id"]
        target = identity(row["target_ws"], row["target"])
        handle = conn.execute(
            "SELECT * FROM handles WHERE workspace = ? AND name = ?",
            (row["target_ws"], row["target"]),
        ).fetchone()
        pane_id = pane_id_of(handle["session_ref"]) if handle else None
        pane = fetch_pane(pane_id) if pane_id else None
        if not pane_id or pane is None:
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='no live pane', "
                "focus_hold_since=NULL "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target}: no live pane, left for pull")
            continue
        # Identity guard: a live pane id proves nothing — panes get reused.
        # Never push one handle's mail into a pane that now belongs to
        # someone else; leave it for pull instead (mirrors handle_status).
        if (pane.get("label") or "").casefold() != pane_label(row["target"], row["target_ws"]).casefold():
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='pane reused', "
                "focus_hold_since=NULL "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): pane reused, left for pull")
            continue
        if scope_workspace(handle) and (pane.get("workspace_id") or "") != scope_workspace(handle):
            # A moved pane gets a fresh workspace-qualified id, so this only
            # fires when the row's workspace was recorded wrong.
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='workspace changed', "
                "focus_hold_since=NULL "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): workspace changed, left for pull")
            continue
        if handle["agent"] and pane.get("agent") and pane.get("agent") != handle["agent"]:
            # A pane that reports no agent yet may be booting, or may run a
            # provider herdr cannot detect: leave the decision to
            # delivery_wait_reason, which defers through the boot window and
            # then falls through to typing.
            cur = conn.execute(
                "UPDATE deliveries SET status='pull', last_error='agent changed', "
                "focus_hold_since=NULL "
                "WHERE id = ? AND status = 'pending'",
                (delivery_id,),
            )
            if cur.rowcount:
                events.append(f"#{delivery_id} -> {target} ({pane_id}): agent changed, left for pull")
            continue
        # A join/retune takes the same write lock before renaming the pane.
        # Recheck after acquiring it: the batch above may contain an old binding.
        conn.commit()
        with conn:
            conn.execute("BEGIN IMMEDIATE")
            live_delivery = conn.execute(
                "SELECT status, focus_hold_since FROM deliveries WHERE id=?", (delivery_id,)
            ).fetchone()
            if not live_delivery or live_delivery["status"] != "pending":
                continue
            current = conn.execute(
                "SELECT * FROM handles WHERE workspace=? AND name=?",
                (row["target_ws"], row["target"]),
            ).fetchone()
            live_pane = fetch_pane(pane_id)
            unchanged = bool(
                current and current["session_ref"] == handle["session_ref"]
                and current["agent_session"] == handle["agent_session"]
                and current["agent"] == handle["agent"]
                and live_pane
                and (live_pane.get("label") or "").casefold()
                    == pane_label(row["target"], row["target_ws"]).casefold()
                and (not scope_workspace(current)
                     or live_pane.get("workspace_id") == scope_workspace(current))
                and (not current["agent"] or not live_pane.get("agent")
                     or live_pane.get("agent") == current["agent"])
            )
            if unchanged and any(is_frequency(row[key]) for key in ("target_ws", "from_ws", "to_ws")):
                count = conn.execute(
                    "SELECT count(*) FROM handles WHERE session_ref=?", (current["session_ref"],)
                ).fetchone()[0]
                unchanged = count == 1 and row["from_ws"] == row["to_ws"] == row["target_ws"]
            if not unchanged:
                conn.execute(
                    "UPDATE deliveries SET status='pull', last_error='frequency or binding changed', "
                    "focus_hold_since=NULL "
                    "WHERE id=? AND status='pending'", (delivery_id,),
                )
                events.append(f"#{delivery_id} -> {target}: binding changed, left for pull")
                continue
            pane = live_pane
            wait = delivery_wait_reason(pane, current, pane_id, live_delivery["focus_hold_since"])
            if wait:
                if wait.startswith("pane focused") and not live_delivery["focus_hold_since"]:
                    # Start the hold clock; once it elapses the composer decides.
                    conn.execute(
                        "UPDATE deliveries SET focus_hold_since=? WHERE id=? AND status='pending'",
                        (now(), delivery_id),
                    )
                events.append(f"#{delivery_id} -> {target} ({pane_id}) waiting: {wait}")
                continue
            ok, error = push_to_pane(pane_id, format_for_pane(row))
            if not ok and error == "agent_blocked":
                # A defer, not an attempt: no attempts increment, no last_attempt_at.
                events.append(f"#{delivery_id} -> {target} ({pane_id}) waiting: agent blocked")
                continue
            attempted_at = now()
            if not ok and error == "delivery_unconfirmed":
                # The submission may have landed despite the --wait timeout —
                # retrying risks a duplicate. Terminal for push: pull only.
                cur = conn.execute(
                    "UPDATE deliveries SET status='pull', last_attempt_at=?, "
                    "last_error='delivery unconfirmed — left for pull, not retried', "
                    "focus_hold_since=NULL "
                    "WHERE id = ? AND status = 'pending'",
                    (attempted_at, delivery_id),
                )
                if cur.rowcount:
                    events.append(f"#{delivery_id} -> {target} ({pane_id}): unconfirmed, left for pull")
                continue
            if ok:
                cur = conn.execute(
                    "UPDATE deliveries SET status='delivered', delivered_at=?, last_attempt_at=?, "
                    "focus_hold_since=NULL "
                    "WHERE id = ? AND status = 'pending'",
                    (attempted_at, attempted_at, delivery_id),
                )
                if cur.rowcount:
                    events.append(f"#{delivery_id} -> {target} ({pane_id}) delivered")
            else:
                attempts = int(row["attempts"]) + 1
                status = "failed" if attempts >= MAX_DELIVERY_ATTEMPTS else "pending"
                cur = conn.execute(
                    "UPDATE deliveries SET status=?, attempts=?, last_error=?, last_attempt_at=?, "
                    "focus_hold_since=NULL "
                    "WHERE id = ? AND status = 'pending'",
                    (status, attempts, error, attempted_at, delivery_id),
                )
                if cur.rowcount:
                    events.append(f"#{delivery_id} -> {target} attempt {attempts}: {error}")
    conn.commit()
    return events


def cmd_view(args: argparse.Namespace) -> int:
    """Hand off to the Textual view (bin/radio-view) through the cross-platform
    launcher (bin/run-view.py picks the venv interpreter)."""
    launcher = Path(__file__).resolve().parent / "run-view.py"
    env = os.environ.copy()
    env.pop("RADIO_VIEW_FREQUENCY", None)
    requested = getattr(args, "frequency", None)
    if requested:
        env["RADIO_VIEW_FREQUENCY"] = frequency_scope(requested).removeprefix(FREQUENCY_PREFIX)
    elif DB_PATH.exists():
        with closing(sqlite3.connect(DB_PATH.resolve().as_uri() + "?mode=ro", uri=True)) as conn:
            conn.row_factory = sqlite3.Row
            scope = current_scope(conn)
            if is_frequency(scope):
                env["RADIO_VIEW_FREQUENCY"] = scope.removeprefix(FREQUENCY_PREFIX)
    return exec_or_wait([sys.executable, str(launcher)], env)


def changed_events(events: list[str], seen: dict[str, str]) -> list[str]:
    """Filter a tick's events to the ones worth printing: a stuck delivery
    would otherwise log an identical 'waiting' line every 0.5s. Delivery
    events (starting with '#<id>') print only when their text differs from
    the last print for that delivery id; non-delivery events always print."""
    out = []
    for event in events:
        key = event.split(" ", 1)[0] if event.startswith("#") else None
        if key is not None:
            if seen.get(key) == event:
                continue
            seen[key] = event
        out.append(event)
    return out


def relay_lock(lock_fd) -> bool:
    """Take the relay's single-instance lock without blocking: POSIX flock on
    the open lock file, or a one-byte msvcrt.locking region on Windows (the
    file is kept non-empty so the region exists). False when another relay
    already holds it."""
    try:
        if fcntl is not None:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        elif msvcrt is not None:
            lock_fd.seek(0)
            if lock_fd.read(1) == "":
                lock_fd.write("1")
                lock_fd.flush()
            lock_fd.seek(0)  # lock byte 0 regardless of the read position
            msvcrt.locking(lock_fd.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            raise SystemExit("radio relay: no file locking on this platform")
        return True
    except OSError:
        return False


def script_changed(script: str, started_mtime: float) -> bool:
    """True when the script on disk differs from the running image; False when
    it cannot be read — mid-update the file is briefly replaced, and that must
    not kill the daemon."""
    try:
        return Path(script).stat().st_mtime != started_mtime
    except OSError:
        return False


def restart_relay(interval: float, script: str, lock_fd) -> None:
    """Hand the daemon over to a fresh process running the script as it is now
    on disk: release the lock, spawn a detached successor, and let the caller
    exit. Windows has no true exec — the CRT emulation races the lock and can
    lose stdio — so both platforms use the same explicit handover."""
    lock_fd.close()
    log = open(STATE_DIR / "relay.log", "a", encoding="utf-8")
    try:
        subprocess.Popen(
            [sys.executable, script, "relay", "--interval", str(interval)],
            cwd=str(STATE_DIR),  # never hold the plugin dir: it blocks updates
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=os.name != "nt",
            creationflags=(
                subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
                if os.name == "nt"
                else 0
            ),
            close_fds=True,
        )
    finally:
        log.close()


def script_compiles(script: str) -> bool:
    """True when the script parses. The handover must not hand the daemon to a
    half-written file (a manual copy or an interrupted update): that process
    would die on import and delivery would wait for the next server start."""
    try:
        source = Path(script).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return False
    try:
        compile(source, script, "exec")
    except (SyntaxError, ValueError):
        return False
    return True


def cmd_relay(args: argparse.Namespace) -> int:
    """Run the delivery relay daemon: single instance via relay_lock, ticking
    relay_tick on the interval, re-execing itself when the script changes on
    disk so a deploy never leaves stale code running."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    # Leave the plugin directory: a daemon whose cwd sits inside the managed
    # plugin dir blocks Herdr's install/update on Windows (sharing violation),
    # so every update would need the relay killed first.
    try:
        os.chdir(STATE_DIR)
    except OSError:
        pass
    # 'a+', not 'w': Windows refuses to truncate a file whose bytes another
    # process holds locked, so the second relay must open without truncating.
    lock_fd = open(LOCK_PATH, "a+")
    if not relay_lock(lock_fd):
        print("radio relay already running (lock held)", file=sys.stderr)
        return 1
    print(f"radio relay · db: {DB_PATH} · interval {args.interval}s")
    script = str(Path(__file__).resolve())
    started_mtime = Path(script).stat().st_mtime
    seen: dict[str, str] = {}
    while True:
        with closing(connect()) as conn:
            try:
                events = relay_tick(conn)
            except Exception as exc:
                # One bad tick (DB locked past timeout, a herdr hiccup
                # escaping the wrappers, a bug) must not kill the daemon —
                # autostart only respawns on herdr restart. KeyboardInterrupt
                # and SystemExit still propagate.
                print(f"[{now()}] relay tick error: {exc}", flush=True)
                events = []
            for event in changed_events(events, seen):
                print(f"[{now()}] {event}", flush=True)
        time.sleep(args.interval)
        if script_changed(script, started_mtime):
            if not script_compiles(script):
                # Mid-write (manual copy, interrupted update): keep serving the
                # old code and look again on the next tick.
                continue
            # A deploy swapped the binary: hand over to a fresh daemon so the
            # relay never runs stale code.
            print("radio changed on disk; restarting relay", flush=True)
            restart_relay(args.interval, script, lock_fd)
            return 0


# ---------------------------------------------------------------------------
# Provider usage
#
# Every credential path and endpoint below is read here, in Python, from the
# provider's own files: the plugin depends on no other tool. One local cache
# bounds the cost — at most one read per account per TTL window, shared by
# every caller through a lock — so a ticker or several panes can never poll a
# provider or trip its rate limit. A failed read keeps the last value and is
# retried on the next window, never in a loop.
# ---------------------------------------------------------------------------

USAGE_USER_AGENT = f"radio/{VERSION}"


def usage_cache_path() -> Path:
    """The usage cache file, resolved per call so RADIO_HOME and tests apply."""
    return STATE_DIR / "usage-cache.json"


def usage_lock_path() -> Path:
    """The usage refresh lock: one refresher at a time across panes."""
    return STATE_DIR / "usage.lock"


def usage_read_json(path: Path) -> dict | None:
    """Read one JSON file; missing, unreadable or non-object content reads as None."""
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return payload if isinstance(payload, dict) else None


def usage_http_request(request: urllib.request.Request) -> tuple[int, dict | None]:
    """Perform one HTTP request and decode a bounded JSON body.

    Returns (status, payload); status 0 means the request never completed and
    payload is None whenever the response was empty, oversized or not JSON."""
    try:
        with urllib.request.urlopen(request, timeout=USAGE_HTTP_TIMEOUT_S) as response:
            data = response.read(USAGE_MAX_BODY_BYTES + 1)
            status = int(response.status)
    except urllib.error.HTTPError as error:
        return int(error.code), None
    except OSError:
        return 0, None
    if len(data) > USAGE_MAX_BODY_BYTES:
        return status, None
    try:
        payload = json.loads(data.decode("utf-8", "replace"))
    except ValueError:
        return status, None
    return status, payload if isinstance(payload, dict) else None


def usage_http_get_json(url: str, headers: dict[str, str]) -> tuple[int, dict | None]:
    """GET one endpoint with the shared Accept header."""
    request = urllib.request.Request(url, headers={"Accept": "application/json", **headers})
    return usage_http_request(request)


def usage_http_post_form(url: str, form: dict[str, str]) -> tuple[int, dict | None]:
    """POST one form-encoded body (the Kimi token refresh) and decode JSON."""
    request = urllib.request.Request(
        url,
        data=urllib.parse.urlencode(form).encode("utf-8"),
        headers={
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded",
            "User-Agent": USAGE_USER_AGENT,
        },
        method="POST",
    )
    return usage_http_request(request)


def usage_remaining_percent(used_percent) -> float | None:
    """Remaining percent clamped to 0..100; None when the provider sent no number."""
    if not isinstance(used_percent, (int, float)):
        return None
    return round(max(0.0, min(100.0, 100.0 - float(used_percent))), 1)


def usage_window_label(seconds) -> str:
    """Label a provider window compactly: Week for seven days, Quota when absent."""
    if not isinstance(seconds, (int, float)) or seconds <= 0:
        return "Quota"
    if int(seconds) == 604800:
        return "Week"
    if int(seconds) % 86400 == 0:
        return f"{int(seconds // 86400)}d"
    if int(seconds) % 3600 == 0:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 60)}m"


def usage_reset_iso(value) -> str | None:
    """Normalize a provider reset stamp (unix seconds or ISO text) to ISO UTC."""
    if isinstance(value, (int, float)) and value > 0:
        return datetime.fromtimestamp(float(value), timezone.utc).isoformat()
    if isinstance(value, str) and value.strip():
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc).isoformat()
        except ValueError:
            return None
    return None


def usage_countdown(resets_at: str | None) -> str:
    """Compact countdown to a reset: 5d17h, 3h, due, or '' when unknown."""
    if not resets_at:
        return ""
    try:
        when = datetime.fromisoformat(resets_at)
    except ValueError:
        return ""
    remaining = (when - datetime.now(timezone.utc)).total_seconds()
    if remaining <= 0:
        return "due"
    days, hours = divmod(int(remaining // 3600), 24)
    return f"{days}d{hours}h" if days else f"{hours}h"


def usage_reset_text(resets_at: str | None) -> str:
    """Render a reset stamp as a countdown plus the local time, for the table."""
    countdown = usage_countdown(resets_at)
    if not countdown or not resets_at:
        return ""
    when = datetime.fromisoformat(resets_at)
    return f"resets {countdown} ({when.astimezone().strftime('%b %d %H:%M')})"


def usage_age_text(seconds: float) -> str:
    """Compact cache age: seconds under a minute, minutes, then hours."""
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    return f"{seconds / 3600:.1f}h"


def read_codex_usage(home: Path) -> dict | None:
    """Read one Codex account's quota: its OAuth token in auth.json, then the
    account usage endpoint. None means credentials or the read are unavailable."""
    credentials = usage_read_json(home / "auth.json") or {}
    tokens = credentials.get("tokens") if isinstance(credentials.get("tokens"), dict) else {}
    token = str(tokens.get("access_token") or "").strip()
    account = str(tokens.get("account_id") or "").strip()
    if not token or not account:
        return None
    status, payload = usage_http_get_json(
        CODEX_USAGE_ENDPOINT,
        {
            "Authorization": f"Bearer {token}",
            "ChatGPT-Account-Id": account,
            "User-Agent": USAGE_USER_AGENT,
        },
    )
    if status != 200 or not payload:
        return None
    windows: list[dict] = []
    rate_limit = payload.get("rate_limit") if isinstance(payload.get("rate_limit"), dict) else {}
    for window_id, key in (("primary", "primary_window"), ("secondary", "secondary_window")):
        window = rate_limit.get(key)
        if isinstance(window, dict):
            windows.append(
                {
                    "id": window_id,
                    "label": usage_window_label(window.get("limit_window_seconds")),
                    "remainingPercent": usage_remaining_percent(window.get("used_percent")),
                    "resetsAt": usage_reset_iso(window.get("reset_at")),
                }
            )
    additional = payload.get("additional_rate_limits")
    if isinstance(additional, list):
        for index, limit in enumerate(additional):
            if not isinstance(limit, dict):
                continue
            rate = limit.get("rate_limit") if isinstance(limit.get("rate_limit"), dict) else {}
            name = str(limit.get("limit_name") or f"Additional {index + 1}").strip()
            for window_id, key in (("primary", "primary_window"), ("secondary", "secondary_window")):
                window = rate.get(key)
                if isinstance(window, dict):
                    windows.append(
                        {
                            "id": f"additional_{index + 1}.{window_id}",
                            "label": f"{name} · {usage_window_label(window.get('limit_window_seconds'))}",
                            "remainingPercent": usage_remaining_percent(window.get("used_percent")),
                            "resetsAt": usage_reset_iso(window.get("reset_at")),
                        }
                    )
    return {"plan": payload.get("plan_type"), "windows": windows}


def claude_credentials() -> dict | None:
    """Claude Code's OAuth credentials: the macOS Keychain entry where Claude
    Code stores them, else the credentials file used on other platforms."""
    if sys.platform == "darwin":
        try:
            result = subprocess.run(
                ["/usr/bin/security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace",
                timeout=USAGE_HTTP_TIMEOUT_S,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        if result.returncode == 0 and result.stdout.strip():
            try:
                payload = json.loads(result.stdout)
            except ValueError:
                return None
            return payload if isinstance(payload, dict) else None
    return usage_read_json(Path.home() / ".claude" / ".credentials.json")


def claude_user_agent() -> str:
    """The usage endpoint expects a Claude Code user agent; use the installed
    CLI's version when it can be read."""
    try:
        result = subprocess.run(
            ["claude", "--version"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=USAGE_HTTP_TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired):
        return USAGE_USER_AGENT
    output = (result.stdout or "").strip()
    version = output.split()[0] if output else ""
    return f"claude-code/{version}" if version else USAGE_USER_AGENT


def read_claude_usage() -> dict | None:
    """Read the Claude Code account quota from its usage endpoint. Claude Code
    keeps one shared login per user, so this is one account, not one per home."""
    credentials = claude_credentials() or {}
    oauth = credentials.get("claudeAiOauth") if isinstance(credentials.get("claudeAiOauth"), dict) else {}
    token = str(oauth.get("accessToken") or "").strip()
    if not token:
        return None
    status, payload = usage_http_get_json(
        CLAUDE_USAGE_ENDPOINT,
        {
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": claude_user_agent(),
        },
    )
    if status != 200 or not payload:
        return None
    windows: list[dict] = []
    for key, label in (
        ("five_hour", "5h"),
        ("seven_day", "Week"),
        ("seven_day_opus", "Opus · Week"),
        ("seven_day_sonnet", "Sonnet · Week"),
        ("seven_day_oauth_apps", "OAuth apps · Week"),
    ):
        window = payload.get(key)
        if isinstance(window, dict):
            windows.append(
                {
                    "id": key,
                    "label": label,
                    "remainingPercent": usage_remaining_percent(window.get("utilization")),
                    "resetsAt": usage_reset_iso(window.get("resets_at")),
                }
            )
    return {"plan": oauth.get("subscriptionType"), "windows": windows}


def kimi_runtime(home: Path) -> tuple[str, str, Path] | None:
    """Resolve a Kimi Code account's OAuth host, API base URL and credential
    file. The install's config.toml lists several service base URLs, so only
    the account's coding endpoint counts; the environment may pin a region and
    the mainland hosts apply otherwise. None when the resolved region is not
    one of the two known Kimi hosts — the refresh token is posted to the OAuth
    host, so an unknown value is refused rather than trusted."""
    text = ""
    config = home / "config.toml"
    if config.exists():
        try:
            text = config.read_text(encoding="utf-8")
        except OSError:
            text = ""
    configured = [value.rstrip("/") for value in re.findall(r'(?m)^\s*base_url\s*=\s*"([^"]+)"', text)]
    account_base = next(
        (value for value in configured if value in (KIMI_MAINLAND_BASE_URL, KIMI_GLOBAL_BASE_URL)), ""
    )
    base_url = (os.environ.get("KIMI_CODE_BASE_URL") or account_base).strip().rstrip("/")
    oauth_setting = re.search(r'(?m)^\s*oauthHost\s*=\s*"([^"]+)"', text)
    oauth_host = (
        os.environ.get("KIMI_CODE_OAUTH_HOST")
        or os.environ.get("KIMI_OAUTH_HOST")
        or (oauth_setting.group(1) if oauth_setting else "")
    ).strip().rstrip("/")
    if not base_url:
        base_url = KIMI_GLOBAL_BASE_URL if oauth_host == KIMI_GLOBAL_OAUTH_HOST else KIMI_MAINLAND_BASE_URL
    if not oauth_host:
        oauth_host = KIMI_GLOBAL_OAUTH_HOST if base_url == KIMI_GLOBAL_BASE_URL else KIMI_MAINLAND_OAUTH_HOST
    if (oauth_host, base_url) not in (
        (KIMI_MAINLAND_OAUTH_HOST, KIMI_MAINLAND_BASE_URL),
        (KIMI_GLOBAL_OAUTH_HOST, KIMI_GLOBAL_BASE_URL),
    ):
        return None
    if oauth_host == KIMI_MAINLAND_OAUTH_HOST and base_url == KIMI_MAINLAND_BASE_URL:
        key = KIMI_DEFAULT_OAUTH_KEY
    else:
        payload = json.dumps({"oauthHost": oauth_host, "baseUrl": base_url}, separators=(",", ":"))
        key = "oauth/kimi-code-env-" + hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]
    return oauth_host, base_url, home / "credentials" / f"{key.removeprefix('oauth/')}.json"


def kimi_refresh(oauth_host: str, credentials_path: Path, credentials: dict) -> str:
    """Refresh and persist one Kimi Code file token; '' when it cannot refresh."""
    refresh_token = str(credentials.get("refresh_token") or "").strip()
    if not refresh_token:
        return ""
    status, payload = usage_http_post_form(
        f"{oauth_host}/api/oauth/token",
        {
            "client_id": KIMI_OAUTH_CLIENT_ID,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        },
    )
    if status != 200 or not payload:
        return ""
    token = str(payload.get("access_token") or "").strip()
    if not token:
        return ""
    replacement = {
        "access_token": token,
        "refresh_token": str(payload.get("refresh_token") or refresh_token),
        "expires_at": int(time.time()) + int(payload.get("expires_in") or 0),
        "scope": str(payload.get("scope") or credentials.get("scope") or ""),
        "token_type": str(payload.get("token_type") or credentials.get("token_type") or ""),
        "expires_in": int(payload.get("expires_in") or 0),
    }
    try:
        credentials_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = credentials_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(replacement), encoding="utf-8")
        # Access and refresh tokens are private: the Kimi CLI writes 0600 and
        # a refresh must not loosen that.
        os.chmod(tmp, 0o600)
        os.replace(tmp, credentials_path)
    except OSError as exc:
        # The in-memory token still serves this read, but the file stays
        # stale — the next refresh fails, so say so now.
        print(f"warning: could not persist refreshed Kimi credentials: {exc}", file=sys.stderr)
    return token


def kimi_window_seconds(value, unit) -> float:
    """Convert Kimi's window unit to seconds; unknown units read as zero."""
    try:
        amount = float(value)
    except (TypeError, ValueError):
        return 0.0
    return {
        "TIME_UNIT_MINUTE": amount * 60,
        "TIME_UNIT_HOUR": amount * 3600,
        "TIME_UNIT_DAY": amount * 86400,
    }.get(str(unit), 0.0)


def kimi_quota_window(window_id: str, label: str, quota: dict) -> dict | None:
    """One Kimi window from its limit/used/resetTime; None when unusable."""
    try:
        limit = float(quota.get("limit"))
        used = float(quota.get("used"))
    except (TypeError, ValueError):
        return None
    if limit <= 0:
        return None
    return {
        "id": window_id,
        "label": label,
        "remainingPercent": usage_remaining_percent(used / limit * 100.0),
        "resetsAt": usage_reset_iso(quota.get("resetTime")),
    }


def read_kimi_usage(home: Path) -> dict | None:
    """Read one Kimi Code account's quota. Kimi rotates short-lived file
    tokens, so an expired or rejected token is refreshed once (and persisted)
    before the usage read is retried."""
    runtime = kimi_runtime(home)
    if runtime is None:
        return None
    oauth_host, base_url, credentials_path = runtime
    credentials = usage_read_json(credentials_path) or {}
    token = str(credentials.get("access_token") or "").strip()
    expires_at = credentials.get("expires_at")
    if token and isinstance(expires_at, (int, float)) and expires_at and expires_at - 60 <= time.time():
        token = ""
    if not token:
        token = kimi_refresh(oauth_host, credentials_path, credentials)
    if not token:
        return None

    def fetch(access_token: str) -> tuple[int, dict | None]:
        return usage_http_get_json(
            f"{base_url}/usages",
            {"Authorization": f"Bearer {access_token}", "User-Agent": USAGE_USER_AGENT},
        )

    status, payload = fetch(token)
    if status == 401:
        token = kimi_refresh(oauth_host, credentials_path, credentials)
        if not token:
            return None
        status, payload = fetch(token)
    if status != 200 or not payload:
        return None
    windows: list[dict] = []
    usage = payload.get("usage")
    if isinstance(usage, dict):
        window = kimi_quota_window("plan", "Quota", usage)
        if window:
            windows.append(window)
    limits = payload.get("limits")
    if isinstance(limits, list):
        for index, limit in enumerate(limits):
            if not isinstance(limit, dict):
                continue
            detail = limit.get("detail")
            window_spec = limit.get("window") if isinstance(limit.get("window"), dict) else {}
            if isinstance(detail, dict):
                seconds = kimi_window_seconds(window_spec.get("duration"), window_spec.get("timeUnit"))
                window = kimi_quota_window(f"rolling_{index + 1}", usage_window_label(seconds), detail)
                if window:
                    windows.append(window)
    user = payload.get("user") if isinstance(payload.get("user"), dict) else {}
    membership = user.get("membership") if isinstance(user.get("membership"), dict) else {}
    return {"plan": membership.get("level"), "windows": windows}


def read_provider_usage(target: dict) -> dict | None:
    """Read one account's quota through its provider reader; None on failure."""
    provider, home = target["provider"], target["home"]
    if provider == "codex" and home is not None:
        return read_codex_usage(home)
    if provider == "claude":
        return read_claude_usage()
    if provider == "kimi" and home is not None:
        return read_kimi_usage(home)
    return None


def usage_targets(conn: sqlite3.Connection) -> list[dict]:
    """Every provider account the ledger knows, plus each provider's default
    login. Claude Code keeps one shared login per user, so its named accounts
    are not separately readable and the shared entry covers them."""
    targets = [
        {
            "label": "Codex",
            "provider": "codex",
            "home": Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex"),
        },
        {"label": "Claude", "provider": "claude", "home": None},
        {
            "label": "Kimi",
            "provider": "kimi",
            "home": Path(
                os.environ.get("KIMI_CODE_HOME")
                or os.environ.get("KIMI_HOME")
                or Path.home() / ".kimi-code"
            ),
        },
    ]
    display = {"codex": "Codex", "kimi": "Kimi"}
    for row in conn.execute("SELECT name, provider, home FROM accounts ORDER BY name").fetchall():
        provider = row["provider"]
        if provider not in display or not row["home"]:
            continue
        targets.append(
            {
                "label": f"{display[provider]} · {row['name']}",
                "provider": provider,
                "home": Path(row["home"]).expanduser(),
            }
        )
    return targets


def usage_timestamp(value) -> float:
    """A cache timestamp as a float; a malformed value reads as 0 (never
    observed) so one bad entry can never break the display."""
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0


def load_usage_cache() -> dict:
    """The usage cache entries, or an empty mapping when none is readable. An
    entry that is not an object is dropped: the cache is written by this same
    tool, and a truncated or hand-edited file must not break the display."""
    payload = usage_read_json(usage_cache_path()) or {}
    entries = payload.get("entries")
    if not isinstance(entries, dict):
        return {}
    return {label: entry for label, entry in entries.items() if isinstance(entry, dict)}


def save_usage_cache(entries: dict) -> None:
    """Persist the usage cache atomically; the cache is a convenience, so a
    failed write is ignored rather than failing the command."""
    path = usage_cache_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps({"version": 1, "entries": entries}, ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, path)
    except OSError:
        pass


def refresh_usage_cache(conn: sqlite3.Connection) -> dict:
    """Refresh stale provider entries, at most once per TTL window.

    The lock makes several panes share one refresh. A failed read keeps the
    previous entry, or records one unavailable entry for the window, so the
    display degrades to stale instead of polling the provider. The attempt is
    stamped too: a provider that is down or logged out must not be read again
    on every call — that is a poll and can trip its rate limit."""
    entries = load_usage_cache()
    targets = usage_targets(conn)
    now_ts = time.time()

    def fresh(entry) -> bool:
        """True when the entry was read or attempted inside the TTL window."""
        return isinstance(entry, dict) and now_ts - max(
            usage_timestamp(entry.get("observedAt")),
            usage_timestamp(entry.get("attemptedAt")),
        ) <= USAGE_CACHE_TTL_S

    stale = [target for target in targets if not fresh(entries.get(target["label"]))]
    if not stale:
        return entries
    lock_path = usage_lock_path()
    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        return entries
    with open(lock_path, "a+", encoding="utf-8") as lock_fd:
        if not relay_lock(lock_fd):
            return load_usage_cache()
        entries = load_usage_cache()
        for target in stale:
            previous = entries.get(target["label"])
            if fresh(previous):
                continue
            value = read_provider_usage(target)
            if value is not None:
                entries[target["label"]] = {**value, "provider": target["provider"], "observedAt": now_ts}
            elif isinstance(previous, dict) and previous.get("windows"):
                # Keep the last data on display — it will read as stale — but
                # stamp the attempt so the provider is asked again in the next
                # window, not on every call.
                entries[target["label"]] = {**previous, "attemptedAt": now_ts}
            else:
                entries[target["label"]] = {
                    "provider": target["provider"],
                    "observedAt": now_ts,
                    "attemptedAt": now_ts,
                    "detail": "credentials or endpoint unavailable",
                    "windows": [],
                }
        save_usage_cache(entries)
    return entries


def usage_primary_window(entry: dict) -> dict | None:
    """The window the ticker line shows: the weekly or plan allowance."""
    windows = [window for window in entry.get("windows", []) if isinstance(window, dict)]
    for wanted in ("Week", "Quota"):
        for window in windows:
            if window.get("label") == wanted:
                return window
    return windows[0] if windows else None


def render_usage_line(entries: dict) -> str:
    """The compact ticker line: one segment per account, usage-style."""
    segments = []
    for label, entry in entries.items():
        window = usage_primary_window(entry)
        if window is None:
            segments.append(f"{label}: unavailable")
            continue
        remaining = window.get("remainingPercent")
        percent = f"{int(remaining)}%" if isinstance(remaining, (int, float)) else "-"
        segment = f"{label}: {window.get('label') or 'Quota'} {percent}"
        countdown = usage_countdown(window.get("resetsAt"))
        if countdown:
            segment += f" ({countdown})"
        segments.append(segment)
    return " - ".join(segments) if segments else "no usage accounts"


def render_usage_table(entries: dict) -> str:
    """The aligned per-account table with every window and the cache age."""
    newest = max((usage_timestamp(entry.get("observedAt")) for entry in entries.values()), default=0.0)
    header = f"provider usage · {datetime.now().strftime('%H:%M')}"
    if newest:
        age = max(time.time() - newest, 0.0)
        header += f" · cache{' stale' if age > USAGE_CACHE_TTL_S else ''} {usage_age_text(age)}"
    else:
        header += " · no data yet"
    lines = [header]
    label_width = max((len(label) for label in entries), default=0)
    for label, entry in entries.items():
        windows = [window for window in entry.get("windows", []) if isinstance(window, dict)]
        if not windows:
            lines.append(f"  {label:<{label_width}}  {entry.get('detail') or 'unavailable'}")
            continue
        window_width = max(len(str(window.get("label") or "")) for window in windows)
        for index, window in enumerate(windows):
            remaining = window.get("remainingPercent")
            percent = f"{int(remaining)}% left" if isinstance(remaining, (int, float)) else "-"
            name = label if index == 0 else ""
            line = f"  {name:<{label_width}}  {str(window.get('label') or '-'):<{window_width}}  {percent:>8}"
            lines.append(f"{line}  {usage_reset_text(window.get('resetsAt'))}".rstrip())
    return "\n".join(lines)


def usage_payload(entries: dict) -> dict:
    """The machine-readable snapshot: every account, window and observation time."""
    newest = max((usage_timestamp(entry.get("observedAt")) for entry in entries.values()), default=0.0)
    age = max(time.time() - newest, 0.0) if newest else None
    return {
        "observedAt": datetime.fromtimestamp(newest, timezone.utc).isoformat() if newest else None,
        "ageSeconds": None if age is None else round(age, 1),
        "stale": bool(age is not None and age > USAGE_CACHE_TTL_S),
        "accounts": [
            {
                "label": label,
                "provider": entry.get("provider"),
                "plan": entry.get("plan"),
                "detail": entry.get("detail"),
                "windows": [
                    {
                        "id": window.get("id"),
                        "label": window.get("label"),
                        "remainingPercent": window.get("remainingPercent"),
                        "resetsAt": window.get("resetsAt"),
                    }
                    for window in entry.get("windows", [])
                    if isinstance(window, dict)
                ],
            }
            for label, entry in entries.items()
        ],
    }


def cmd_tools_usage(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Show provider quota for every account, read from the providers' own
    endpoints into one local cache.

    Bounded with respect to the providers: at most one read per account per TTL
    window, shared by all callers through a lock, so nothing here can poll a
    provider or trip its rate limit. The default mode is the ticker; --table
    prints the aligned table once, --once prints one ticker line, --json
    prints the machine-readable snapshot. Ctrl-C ends the ticker cleanly."""

    def snapshot() -> tuple[str, str, dict]:
        entries = refresh_usage_cache(conn)
        return render_usage_line(entries), render_usage_table(entries), usage_payload(entries)

    if args.json:
        _, _, payload = snapshot()
        sys.stdout.write(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        return 0
    if args.table:
        _, table, _ = snapshot()
        print(table)
        return 0
    if args.once:
        line, _, _ = snapshot()
        print(line)
        return 0
    try:
        while True:
            line, _, _ = snapshot()
            sys.stdout.write("\x1b[2J\x1b[H" + line + "\n")
            sys.stdout.flush()
            time.sleep(max(args.interval, 1.0))
    except KeyboardInterrupt:
        # The ticker is a foreground display: Ctrl-C is the way out, not a
        # traceback.
        return 0


# ---------------------------------------------------------------------------
# Calm
#
# A quiet terminal animation: slow colour currents, twinkling stars and a few
# drifting motes. It is self-contained on purpose — curses is stdlib — and
# independent of any user script: `radio tools calm` always runs this code.
# ---------------------------------------------------------------------------

CALM_FPS = 6.0
CALM_STAR_DENSITY = 0.0028
CALM_FLOW_COLORS = (24, 25, 31, 60, 61, 67, 68, 74, 97, 98, 104, 105)
CALM_STAR_COLORS = (238, 242, 247, 252)
CALM_ACCENT_COLORS = (37, 80, 111, 141, 176, 209, 221, 150)
CALM_MOTE_GLYPHS = ("○", "◇", "✧", "•")


class CalmStar:
    """One twinkling star: a fixed position whose phase and speed drive its glow.

    A plain class on purpose: the tests load this file as a module that never
    enters sys.modules, and @dataclass requires that registration."""

    def __init__(self, x: float, y: float, phase: float, speed: float) -> None:
        self.x = x
        self.y = y
        self.phase = phase
        self.speed = speed


class CalmMote:
    """One drifting mote: it crosses the scene slowly and pulses on the way.

    A plain class for the same reason as CalmStar."""

    def __init__(self, x: float, y: float, phase: float, speed: float, color: int, glyph: str) -> None:
        self.x = x
        self.y = y
        self.phase = phase
        self.speed = speed
        self.color = color
        self.glyph = glyph


def calm_stars(width: int, height: int) -> list[CalmStar]:
    """Seed the star field from the screen size; never fewer than twelve."""
    count = max(12, int(width * height * CALM_STAR_DENSITY))
    return [
        CalmStar(
            x=random.random(),
            y=random.random(),
            phase=random.random() * math.tau,
            speed=random.uniform(0.20, 0.48),
        )
        for _ in range(count)
    ]


def calm_motes(width: int, height: int) -> list[CalmMote]:
    """Seed the few accent motes that drift across the scene."""
    count = max(6, min(14, width * height // 280))
    return [
        CalmMote(
            x=random.random(),
            y=random.uniform(0.12, 0.88),
            phase=random.random() * math.tau,
            speed=random.uniform(0.0025, 0.007),
            color=random.randrange(len(CALM_ACCENT_COLORS)),
            glyph=random.choice(CALM_MOTE_GLYPHS),
        )
        for _ in range(count)
    ]


def calm_add(screen, y: int, x: int, char: str, style: int) -> None:
    """Write one cell, ignoring the edges curses refuses to paint."""
    try:
        screen.addstr(y, x, char, style)
    except curses.error:
        pass


def calm_render(screen) -> None:
    """Draw the calm scene until q, Escape or Ctrl-C; the caller owns the screen."""
    curses.curs_set(0)
    screen.nodelay(True)
    screen.keypad(True)
    curses.use_default_colors()
    palette = (*CALM_FLOW_COLORS, *CALM_STAR_COLORS, *CALM_ACCENT_COLORS)
    for pair, color in enumerate(palette[: curses.COLOR_PAIRS - 1], start=1):
        curses.init_pair(pair, color, -1)

    old_size = (0, 0)
    stars: list[CalmStar] = []
    motes: list[CalmMote] = []
    started = time.monotonic()
    while True:
        key = screen.getch()
        if key in (ord("q"), ord("Q"), 27, 3):
            return
        height, width = screen.getmaxyx()
        if (width, height) != old_size:
            stars = calm_stars(width, height)
            motes = calm_motes(width, height)
            old_size = (width, height)
        now = time.monotonic() - started
        screen.erase()

        if width >= 12 and height >= 5:
            usable_height = height - 1

            # Three dim currents cross the screen at slightly different speeds.
            for band in range(3):
                center = usable_height * (0.30 + band * 0.20)
                amplitude = max(1.0, usable_height * (0.045 + band * 0.008))
                for x in range(0, width, 2):
                    wave = math.sin(x * 0.055 + now * (0.11 + band * 0.025) + band * 2.1)
                    drift = math.sin(x * 0.016 - now * 0.055 + band) * amplitude * 0.55
                    y = int(center + wave * amplitude + drift)
                    pair = 1 + int(x * 0.035 + now * 0.20 + band * 3.0) % len(CALM_FLOW_COLORS)
                    calm_add(
                        screen,
                        y,
                        x,
                        "·" if (x + band) % 6 else "~",
                        curses.color_pair(pair) | curses.A_DIM,
                    )

            star_offset = len(CALM_FLOW_COLORS)
            for star in stars:
                x = min(width - 1, int(star.x * width))
                y = min(usable_height - 1, int(star.y * usable_height))
                glow = (math.sin(star.phase + now * star.speed) + 1.0) / 2.0
                level = min(3, int(glow * 4))
                style = curses.color_pair(1 + star_offset + level)
                if level == 3:
                    style |= curses.A_BOLD
                calm_add(screen, y, x, ("·", "·", "*", "✦")[level], style)

            # Sparse coloured motes drift across the scene over several minutes.
            accent_offset = len(CALM_FLOW_COLORS) + len(CALM_STAR_COLORS)
            for mote in motes:
                x = int(((mote.x + now * mote.speed) % 1.0) * width)
                bob = math.sin(mote.phase + now * 0.16) * 1.4
                y = min(usable_height - 1, max(0, int(mote.y * usable_height + bob)))
                pulse = (math.sin(mote.phase + now * 0.24) + 1.0) / 2.0
                style = curses.color_pair(1 + accent_offset + mote.color)
                if pulse < 0.38:
                    style |= curses.A_DIM
                elif pulse > 0.82:
                    style |= curses.A_BOLD
                calm_add(screen, y, x, mote.glyph, style)

            hint = " q: quit "
            calm_add(
                screen,
                height - 1,
                max(0, width - len(hint) - 1),
                hint,
                curses.color_pair(1 + len(CALM_FLOW_COLORS)) | curses.A_DIM,
            )

        screen.refresh()
        time.sleep(1 / CALM_FPS)


def cmd_tools_calm(args: argparse.Namespace) -> int:
    """Run the calm animation in the current terminal.

    Self-contained and read-only: it touches neither the ledger nor any user
    script, and needs nothing but a terminal."""
    if curses is None:
        raise SystemExit("calm needs a POSIX terminal (curses is unavailable here)")
    if not sys.stdout.isatty():
        raise SystemExit("calm needs a terminal; run it in a pane")
    try:
        curses.wrapper(calm_render)
    except KeyboardInterrupt:
        pass
    return 0


def build_parser() -> argparse.ArgumentParser:
    """The CLI parser: one subcommand per ledger operation, plus relay/view."""
    parser = argparse.ArgumentParser(prog="radio", description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("join", help="register this pane/session as a handle")
    p.add_argument("handle", nargs="?", help="defaults to the current pane label")
    p.add_argument("--pane", help="join a pane from outside (e.g. w1:p5)")
    p.add_argument("--provider", choices=PROVIDERS, help="agent provider to launch")
    p.add_argument("--account", help="named account to launch with (implies its provider); "
                                     "manage accounts with `radio account`")
    p.add_argument("--new", action="store_true", help="start a new session without asking")
    p.add_argument("--resume", action="store_true", help="resume the named session without asking")
    p.add_argument("--model", help="opencode: model to run (e.g. opencode/deepseek-v4-flash); "
                                   "written into the per-handle config file")
    p.add_argument("--role", help="role paragraph for this handle; carried in the briefing and "
                                  "editable later with `radio role` (\"\" clears it)")
    p.add_argument("--no-launch", action="store_true", help="register only, never launch an agent")
    frequency = p.add_mutually_exclusive_group()
    frequency.add_argument("--frequency", metavar="NAME", help="advanced: join a named frequency across workspaces")
    frequency.add_argument("--workspace-frequency", action="store_true", help="return to this workspace's default frequency")

    sub.add_parser("frequency", help="show this pane's frequency (workspace default unless explicitly changed)")

    p = sub.add_parser("part", help="remove a handle")
    p.add_argument("handle")

    p = sub.add_parser("pm", help="direct message a handle")
    p.add_argument("to")
    p.add_argument("text", nargs="+")
    p.add_argument("--from", dest="sender")
    p.add_argument("--ref", help="file reference carrying the payload — keep the "
                                 "message short, the recipient reads the file")
    p.add_argument("--reply-required", action="store_true",
                   help="mark the message as requiring a reply")

    p = sub.add_parser("handles", help="list joined handles")
    p.add_argument("workspace", nargs="?", help="workspace id or label to list; inside a pane "
                                                "the roster always shows this workspace only")

    p = sub.add_parser("account", help="named provider accounts (several logins of one provider)")
    acct = p.add_subparsers(dest="account_command")
    ap = acct.add_parser("add", help="register an account home")
    ap.add_argument("name")
    ap.add_argument("--provider", required=True, choices=PROVIDERS)
    ap.add_argument("--home", help="config dir; default: the provider's convention "
                                   "(codex2 -> ~/.codex-account-2)")
    ap.add_argument("--env", action="append", metavar="NAME=VALUE",
                    help="extra environment for the launch; repeatable")
    acct.add_parser("list", help="list accounts with auth state")
    ap = acct.add_parser("remove", help="remove an unused account")
    ap.add_argument("name")
    ap = acct.add_parser("move", help="copy a handle's session to another account and switch it")
    ap.add_argument("handle")
    ap.add_argument("--to", required=True, help="target account name")

    p = sub.add_parser("role", help="show, set, or clear a handle's role paragraph")
    p.add_argument("handle")
    p.add_argument("text", nargs="*", help="the role paragraph; omitted, the current role prints")
    p.add_argument("--clear", action="store_true", help="remove the role")

    p = sub.add_parser("restore", help="bring a handle's agent back into its pane")
    p.add_argument("handle")

    p = sub.add_parser("briefing", help=argparse.SUPPRESS)  # used by provider hooks
    p.add_argument("handle")

    p = sub.add_parser("log", help="recent messages")
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("inbox", help="metadata index of incoming messages "
                                     "(bodies via `radio show <id>`)")
    p.add_argument("handle", nargs="?", help="defaults to this pane's handle / $RADIO_HANDLE")
    p.add_argument("--status", choices=("all", "pending", "delivered", "pull", "failed"),
                   default="all", help="filter by delivery state; default: all")
    p.add_argument("--limit", type=int, default=10, help="number of entries (default: 10)")

    p = sub.add_parser("show", help="print one message body by id")
    p.add_argument("message_id", type=int)
    p.add_argument("--by", help="reader handle; reading as the recipient records delivery")

    p = sub.add_parser("relay", help="run the delivery relay daemon")
    p.add_argument("--interval", type=float, default=0.5)

    p = sub.add_parser("repair", help="diagnose the ledger, or --reset it (a backup is kept)")
    p.add_argument("--reset", action="store_true",
                   help="replace the ledger with a fresh empty one; the old files stay as backups")
    p.add_argument("--yes", action="store_true", help="skip the confirmation prompt")

    p = sub.add_parser("view", help="live roster + message stream TUI")
    p.add_argument("--frequency", metavar="NAME", help="advanced: view only this named frequency")

    p = sub.add_parser("tools", help="local views over provider data")
    tools = p.add_subparsers(dest="tools_command")
    tp = tools.add_parser("usage", help="provider quota per account, from a local cache")
    tp.add_argument("--table", action="store_true", help="print the aligned table once instead of the ticker")
    tp.add_argument("--once", action="store_true", help="print one ticker line and exit")
    tp.add_argument("--json", action="store_true", help="print one machine-readable snapshot and exit")
    tp.add_argument("--interval", type=float, default=30.0, help="seconds between ticker redraws (default 30)")
    p.set_defaults(func=cmd_tools_usage)
    cp = tools.add_parser("calm", help="a quiet terminal animation (q quits)")
    cp.set_defaults(func=cmd_tools_calm)

    return parser


def relay_running() -> bool:
    """True when the relay daemon holds its lock (probe only: a lock this
    probe takes is released immediately)."""
    if not LOCK_PATH.exists():
        return False
    fd = open(LOCK_PATH, "a+")
    try:
        return not relay_lock(fd)
    finally:
        fd.close()


def cmd_repair(args: argparse.Namespace) -> int:
    """Diagnose the ledger (default) or replace it with a fresh one (--reset).
    Repair is the supported way out of a broken state — a corrupt database, a
    ledger written by a newer radio, or a half-applied migration. --reset
    snapshots the old ledger beside it first, so nothing is destroyed."""
    if args.reset:
        return repair_reset(args)
    return repair_check()


def repair_check() -> int:
    """Print a short ledger health report; exit 1 when --reset is warranted."""
    problems: list[str] = []
    counts = {"handles": 0, "messages": 0, "deliveries": 0}
    integrity = "unreadable"
    version = -1
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as conn:
            version = int(conn.execute("PRAGMA user_version").fetchone()[0])
            integrity = str(conn.execute("PRAGMA integrity_check").fetchone()[0])
            for table in counts:
                try:
                    counts[table] = int(
                        conn.execute(f"SELECT COUNT(*) AS c FROM {table}").fetchone()[0]
                    )
                except sqlite3.Error:
                    problems.append(f"table unreadable: {table}")
    except sqlite3.Error as exc:
        problems.append(f"cannot open the ledger: {exc}")
    if version > SCHEMA_VERSION:
        problems.append(
            f"ledger schema {version} is newer than this radio ({SCHEMA_VERSION})"
        )
    if integrity != "ok":
        problems.append(f"integrity check: {integrity}")
    print(f"ledger:    {DB_PATH}")
    print(f"schema:    {version if version >= 0 else '?'} (this radio: {SCHEMA_VERSION})")
    print(f"integrity: {integrity}")
    print(
        f"handles: {counts['handles']} · messages: {counts['messages']} · "
        f"deliveries: {counts['deliveries']}"
    )
    print(f"relay:     {'running' if relay_running() else 'not running'}")
    if problems:
        for problem in problems:
            print(f"problem:   {problem}")
        print("recover:   radio repair --reset   (keeps a backup beside the ledger)")
        return 1
    print("verdict:   healthy")
    return 0


def repair_reset(args: argparse.Namespace) -> int:
    """Snapshot the ledger and rebuild an empty schema. The snapshot uses
    SQLite's online backup API, so a running relay cannot corrupt it; when the
    tables cannot be dropped (corrupt database), the files are moved aside
    instead. Data is never deleted without a backup beside it."""
    if not args.yes:
        if not sys.stdin.isatty():
            raise SystemExit("radio repair --reset needs --yes when not interactive")
        answer = input(
            f"Replace {DB_PATH} with an empty ledger? A backup is kept beside it. [y/N] "
        )
        if answer.strip().lower() not in ("y", "yes"):
            print("cancelled")
            return 0
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    backup = DB_PATH.with_name(f"{DB_PATH.name}.bak-{stamp}")
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as src, closing(
            sqlite3.connect(backup, timeout=10)
        ) as dst:
            src.backup(dst)
        print(f"backup:    {backup}")
    except sqlite3.Error as exc:
        print(f"backup:    failed ({exc}) — the old files are kept as-is")
    try:
        with closing(sqlite3.connect(DB_PATH, timeout=10)) as conn:
            for table in ("deliveries", "messages", "handles"):
                conn.execute(f"DROP TABLE IF EXISTS {table}")
            # The version marker lives in the file header, not the tables: a
            # newer-schema ledger must lose it too, or connect() refuses again.
            conn.execute("PRAGMA user_version = 0")
            conn.commit()
    except sqlite3.Error:
        # Corrupt database: move the files aside and start over.
        for suffix in ("", "-wal", "-shm"):
            path = Path(str(DB_PATH) + suffix)
            if path.exists():
                path.rename(Path(f"{path}.bak-{stamp}"))
    with closing(connect()):
        pass  # rebuilds the schema and stamps the current version
    print(f"fresh:     {DB_PATH}")
    return 0


def cmd_restore(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Bring a handle's agent back into its own pane: verify the pane still
    belongs to the handle, then type the join/resume command into it so the
    normal launch path (briefing, provider env, recorded session) does the
    work. Never creates layout — a missing pane is reported with what to do."""
    scope = current_scope(conn)
    row = resolve_handle(conn, args.handle, scope)
    if not row:
        raise SystemExit(no_handle_message(conn, args.handle, scope))
    selection = (f' --frequency {row["workspace"].removeprefix(FREQUENCY_PREFIX)}'
                 if is_frequency(row["workspace"]) else "")
    if not row["agent"]:
        raise SystemExit(
            f'{row["name"]} has no recorded provider — join it once with a provider: '
            f'radio join {row["name"]} --provider <name>{selection}'
        )
    account = resolve_account(conn, row["account"]) if row["account"] else None
    if row["account"] and not account:
        raise SystemExit(
            f'account {row["account"]} for {row["name"]} is no longer defined — add it back '
            f'(radio account add {row["account"]} --provider {row["agent"]}) or part the handle'
        )
    pane_id = pane_id_of(row["session_ref"])
    if not pane_id:
        raise SystemExit(
            f'{row["name"]} is not bound to a pane — open a pane in '
            f'{workspace_display(row["workspace"])} and run: '
            f'radio join {row["name"]} --provider {row["agent"]}{selection}'
        )
    pane = fetch_pane(pane_id)
    if not pane:
        raise SystemExit(
            f'pane {pane_id} is gone — open a pane in {workspace_display(row["workspace"])} '
            f'and run: radio join {row["name"]} --provider {row["agent"]}{selection}'
        )
    if (pane.get("label") or "") != pane_label(row["name"], row["workspace"]):
        raise SystemExit(
            f'pane {pane_id} no longer belongs to {row["name"]} '
            f'(label: {pane.get("label") or "none"})'
        )
    if scope_workspace(row) and (pane.get("workspace_id") or "") != scope_workspace(row):
        raise SystemExit(f'pane {pane_id} is in another workspace now')
    live_agent = pane.get("agent")
    if live_agent:
        if live_agent == row["agent"]:
            print(f'{row["name"]} is already running ({row["agent"]} in {pane_id})')
            return 0
        raise SystemExit(f'pane {pane_id} runs {live_agent}; part or clear it first')
    status = pane.get("agent_status") or "unknown"
    if status in ("blocked", "working"):
        # Typing now would land in a dialog or mid-turn; the relay defers the
        # same way.
        raise SystemExit(f'pane {pane_id} is busy ({status}); try again when it is idle')
    session = row["agent_session"]
    resumable = True
    if session:
        home = provider_home(row["agent"], account)
        if session_present(row["agent"], home, session) is False:
            print(
                f'note: recorded session {session[:8]} is not in {home} — starting fresh'
            )
            resumable = False
    if session and resumable:
        command = f'radio join {row["name"]} --provider {row["agent"]} --resume'
    else:
        command = f'radio join {row["name"]} --provider {row["agent"]}'
        if not session:
            print(f'note: no recorded session for {row["name"]} — starting fresh')
    if is_frequency(row["workspace"]):
        command += f' --frequency {row["workspace"].removeprefix(FREQUENCY_PREFIX)}'
        if not session or not resumable:
            command += " --new"
    typed = herdr("pane", "send-text", pane_id, command)
    if typed.returncode != 0:
        raise SystemExit(f'could not type into {pane_id}: {(typed.stderr or typed.stdout or "").strip()}')
    time.sleep(0.4)  # let the paste land before Enter
    entered = herdr("pane", "send-keys", pane_id, "enter")
    if entered.returncode != 0:
        raise SystemExit(f'could not submit the command in {pane_id}: {(entered.stderr or "").strip()}')
    print(f'restoring {row["name"]} in {pane_id}: {command}')
    if account:
        print(f'  account: {account["name"]} ({account_home(account) or "provider default home"})')
    print('the agent boots in that pane; radio handles shows it live once detected')
    return 0


def cmd_briefing(conn: sqlite3.Connection, args: argparse.Namespace) -> int:
    """Print the opening briefing for a handle. Single source of truth: the
    launch flags (claude/codex) and provider hooks (kimi/gemini) all render
    this; workspace and role come from the ledger when the handle is joined,
    so a resumed agent re-learns both."""
    scope = current_scope(conn)
    row = resolve_handle(conn, args.handle, scope)
    if row:
        print(briefing_text(row["name"], row["workspace"], row["role"]))
    else:
        workspace, name = parse_handle(args.handle)
        print(briefing_text(name, workspace or scope, None))
    return 0


def utf8_streams() -> None:
    """Force UTF-8 on stdout/stderr. Windows pipes default to the locale codec
    (cp1252), which cannot encode the envelopes' typography (·, ⚠, —) and
    crashes the command that prints it; UTF-8 with replacement is what every
    consumer of radio's output expects. No-op on POSIX and for replaced
    streams (tests)."""
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, OSError, ValueError):
            pass


def main() -> int:
    """Dispatch argv: bare `radio` opens the view on a tty (prints help in
    scripts); relay/view never open the ledger, everything else does."""
    utf8_streams()
    args = build_parser().parse_args()
    if args.command is None:
        # Bare `radio` in a terminal opens the view; in scripts, print help.
        if sys.stdout.isatty():
            return cmd_view(args)
        build_parser().print_help()
        return 0
    if args.command == "relay":
        return cmd_relay(args)
    if args.command == "view":
        return cmd_view(args)
    if args.command == "repair":
        return cmd_repair(args)
    if args.command == "tools" and getattr(args, "tools_command", None) == "calm":
        return cmd_tools_calm(args)
    with closing(connect()) as conn:
        handler = {
            "join": cmd_join,
            "part": cmd_part,
            "pm": cmd_pm,
            "handles": cmd_handles,
            "account": cmd_account,
            "role": cmd_role,
            "restore": cmd_restore,
            "briefing": cmd_briefing,
            "frequency": cmd_frequency,
            "log": cmd_log,
            "inbox": cmd_inbox,
            "show": cmd_show,
            "tools": cmd_tools_usage,
        }[args.command]
        return handler(conn, args)


if __name__ == "__main__":
    raise SystemExit(main())
